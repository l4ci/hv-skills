# ── hv backlog ──
# Track .hv/ content (knowledge, decisions, backlog, milestones, designs,
# plans, spikes, per-item detail). Only ignore the parts that are
# machine-specific, regenerated, or per-developer local overrides.

# Stale mirror from hv-skills 4.x; `hv init` deletes it. Kept for one release (removable)
.hv/bin/
# Active-work tracking (per-developer, branch-aware)
.hv/status.json
# Umbrella sub-repo registry (absolute paths, machine-specific)
.hv/repos.json
# Per-developer config overrides — deep-merged on top of config.json by load_config()
.hv/config.local.json
# Advisory lockfiles guarding sidecar read-modify-write (written by hv)
.hv/**/*.lock

# Python bytecode (test tooling: validator, fakes)
__pycache__/
*.pyc

# Claude Code harness state (scheduled tasks, etc.)
.claude/

# ── hv-skills ──
.hv/bin/
.hv/status.json
.hv/repos.json
.hv/workers.json
.hv/config.local.json
.hv/handoff/
.hv/qa-runs/
.hv/migrate-backup/

# Worker worktrees (hv worker pool, parallel rounds): nested checkouts
.worktrees/

# hv release builds (goreleaser)
dist/

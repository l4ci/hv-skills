#!/usr/bin/env python3
# TEMPORARY: removed in A9 (#53), with test/hv-shim.
#
# Per-verb dispatcher for phase acceptance (#46). Smoke calls "$HV_BIN <group>
# <verb> ...". With HV_BIN=test/hv-hybrid and HV_GO_BIN=<built hv>, a call goes
# to the Go binary when that binary implements the verb, and to test/hv-shim
# (the old bin/ helpers) otherwise. That lets a phase's sections run through Go
# while the rest of the suite, and fixture setup such as `hv init`, still works
# before every phase has been ported.
#
# "Implements" is read from the binary, not guessed from exit codes: `hv
# __verbs` prints one verb path per line (internal/cli.VerbPaths). The verb of
# a call is the longest prefix of its non-flag words that is in that list, with
# the values of -C/--cwd/--repo skipped.
#
# Every call is logged to $HV_HYBRID_LOG (one "go <verb>" or "shim <verb>" line;
# nothing when unset), so a run can prove which backend served which verb
# ("stub <verb>" is a Go call that exited 71, not implemented):
#   sort $HV_HYBRID_LOG | uniq -c
import hashlib
import os
import subprocess
import sys

HERE = os.path.dirname(os.path.realpath(__file__))
SHIM = os.path.join(HERE, "hv-shim")
VALUE_FLAGS = {"-C", "--cwd", "--repo", "-cwd", "-repo"}


# Verbs the binary lists but only partly implements: a call that carries one of
# these flags goes to the shim. Each entry is a known gap in the port, not a
# feature of the hybrid; delete it when the port catches up.
PARTIAL = {}


def die(msg):
    sys.stderr.write("hv-hybrid: %s\n" % msg)
    sys.exit(70)


# A binary that lists none of these is not a usable `hv` (a stale build, the
# wrong file): fail loudly instead of sending every call to the shim, which
# would make a phase look green without Go serving anything.
SENTINEL = "version"


def checked(go_bin, verbs):
    if not verbs:
        die("%s __verbs listed no verbs; refusing to route everything to the shim" % go_bin)
    if SENTINEL not in verbs:
        die("%s __verbs lacks the sentinel verb %r; not a usable hv binary" % (go_bin, SENTINEL))
    return verbs


def go_verbs(go_bin):
    st = os.stat(go_bin)
    key = hashlib.sha1(("%s:%d:%d" % (os.path.realpath(go_bin), st.st_size, st.st_mtime_ns)).encode()).hexdigest()[:16]
    cache = os.path.join(os.environ.get("TMPDIR", "/tmp"), "hv-hybrid-verbs-%s" % key)
    try:
        with open(cache) as f:
            return checked(go_bin, set(f.read().split("\n")) - {""})
    except OSError:
        pass
    out = subprocess.run([go_bin, "__verbs"], capture_output=True, text=True)
    if out.returncode != 0:
        die("%s __verbs failed: %s" % (go_bin, out.stderr.strip()))
    verbs = checked(go_bin, set(out.stdout.split("\n")) - {""})
    try:
        tmp = cache + ".%d" % os.getpid()
        with open(tmp, "w") as f:
            f.write(out.stdout)
        os.replace(tmp, cache)
    except OSError:
        pass
    return verbs


def words(argv):
    out, skip = [], False
    for a in argv:
        if a == "--":
            break
        if skip:
            skip = False
        elif a in VALUE_FLAGS:
            skip = True
        elif a.startswith("-") and a != "-":
            continue
        else:
            out.append(a)
    return out


def check():
    """Post-run acceptance check: HV_HYBRID_EXPECT=<group,...> names the verb
    groups, or verb paths such as "migrate v4", a phase owns. Fails (exit 1) unless the log has at least one Go call
    for each group and no shim or stub call for any of them (a stub is a verb the
    binary lists but answers with exit 71, not implemented). An unset log or an empty
    one cannot prove anything and fails too."""
    groups = [g for g in os.environ.get("HV_HYBRID_EXPECT", "").split(",") if g.strip()]
    log = os.environ.get("HV_HYBRID_LOG", "")
    if not groups:
        sys.stderr.write("hv-hybrid --check: HV_HYBRID_EXPECT names no groups\n")
        return 1
    try:
        with open(log) as f:
            lines = [l.split(None, 1) for l in f.read().splitlines() if l.strip()]
    except OSError:
        sys.stderr.write("hv-hybrid --check: HV_HYBRID_LOG is unset or unreadable; nothing proves what served the run\n")
        return 1
    bad = False
    for g in groups:
        g = g.strip()
        def inside(v):  # an entry is a group ("knowledge") or a verb path ("migrate v4")
            return v == g or v.startswith(g + " ")
        go = sum(1 for b, v in lines if b == "go" and inside(v))
        shim = sorted({v for b, v in lines if b == "shim" and inside(v)})
        stub = sorted({v for b, v in lines if b == "stub" and inside(v)})
        if go == 0:
            sys.stderr.write("hv-hybrid --check: no call to the %r group was served by Go\n" % g)
            bad = True
        for v in shim:
            sys.stderr.write("hv-hybrid --check: %r was served by the shim\n" % v)
            bad = True
        for v in stub:
            sys.stderr.write("hv-hybrid --check: %r is a stub (the Go binary exited 71, not implemented)\n" % v)
            bad = True
        if not bad:
            sys.stderr.write("hv-hybrid --check: %-12s %d call(s) served by Go, none by the shim\n" % (g, go))
    return 1 if bad else 0


def main(argv):
    if argv == ["--check"]:
        sys.exit(check())
    go_bin = os.environ.get("HV_GO_BIN", "")
    if not go_bin or not os.access(go_bin, os.X_OK):
        die("HV_GO_BIN must name the built hv binary")
    verbs = go_verbs(go_bin)
    w = words(argv)
    verb = ""
    for n in range(len(w), 0, -1):
        if " ".join(w[:n]) in verbs:
            verb = " ".join(w[:n])
            break
    # A group named in HV_HYBRID_EXPECT is claimed by the phase under test, so a
    # call under it that names no verb (a typo, `worker pool bogus`) belongs to
    # the Go binary too: its unknown-verb error is what the section checks.
    owned = False
    if not verb:
        for entry in os.environ.get("HV_HYBRID_EXPECT", "").split(","):
            ew = entry.split()
            if ew and w[:len(ew)] == ew and len(w) > len(ew):
                owned = True
    for (pverb, flag), _why in PARTIAL.items():
        if verb == pverb and flag in argv:
            verb = ""
    backend = "go" if (verb or owned) else "shim"
    log = os.environ.get("HV_HYBRID_LOG")

    def record(kind):
        if log:
            with open(log, "a") as f:
                f.write("%s %s\n" % (kind, verb or " ".join(w[:2])))

    if not (verb or owned):
        record("shim")
        os.execv(sys.executable, [sys.executable, SHIM] + argv)
    # The binary lists a verb it has only registered: exit 71 (not_implemented)
    # means Go did not serve it. Run it as a child to see the code, and log such
    # a call as "stub" so --check cannot pass a phase on a stub.
    rc = subprocess.run([go_bin] + argv).returncode
    record("stub" if rc == 71 else "go")
    sys.exit(rc if rc >= 0 else 128 - rc)


if __name__ == "__main__":
    main(sys.argv[1:])

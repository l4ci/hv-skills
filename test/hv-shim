#!/usr/bin/env python3
# TEMPORARY: removed in A9 (#53), when the Go `hv` binary replaces bin/.
#
# Test shim for the black-box smoke suite (A2, #46). It accepts `hv <group>
# <verb>` calls in the shape docs/design/5.0-verb-contract.md defines,
# translates each one into the old bin/ helper call, and maps the helper's
# output and exit code back onto the contract: the --json envelope, the exit
# table and the stderr format from docs/design/5.0-cli-conventions.md.
#
# Smoke reaches it through $HV_BIN, so pointing HV_BIN at a real `hv` binary
# runs the same sections against the port with no other change.
#
# Leak guard: helpers run from a staged copy of bin/ ($HV_SHIM_HELPERS) that
# lives outside every project. hv_self_locate's last fallback walks up from the
# helper's own directory; from the repo's bin/ that walk lands on the dev
# tree's .hv/, but from the staged copy it finds nothing and fails. Verbs that
# need a project also check for a .hv/ root here first (exit 3), so a helper is
# never started without one.
#
# A verb in the contract with no adapter yet exits 71 (not_implemented). Each
# phase batch of #46 adds the adapters its sections need.
#
# The code lives in test/shim/: core.py (parsing, envelope, registry) and one
# module per verb group, each registering its adapters with @verb.
import glob
import os
import sys

sys.dont_write_bytecode = True  # keep test/shim/ free of __pycache__
SHIM = os.path.join(os.path.dirname(os.path.realpath(__file__)), "shim")
sys.path.insert(0, SHIM)

import core  # noqa: E402

for path in sorted(glob.glob(os.path.join(SHIM, "*.py"))):
    name = os.path.splitext(os.path.basename(path))[0]
    if name != "core":
        __import__(name)

if __name__ == "__main__":
    sys.exit(core.main(sys.argv[1:]))

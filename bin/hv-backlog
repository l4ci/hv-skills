#!/usr/bin/env bash
# Render pre-sorted backlog tables from .hv/TODO.md, excluding items active in status.json.
# Lookup helper: always exits 0; empty output when backlog is empty.
# Output: markdown — "In Progress" + "Bugs" (P0/P1/P2) + "Features" (Cosmetic/Minor/Major) + "Tasks".
# Empty sections are omitted. Prints a placeholder if the whole backlog is empty.
# Usage: hv-backlog [--grep <pattern>]
#   --grep <pattern>   Filter Bugs/Features/Tasks by case-insensitive substring against
#                      each item's raw bullet line (matches ID, title, description, Related,
#                      etc.). Clusters are kept if any member matches; In Progress is never
#                      filtered.
set -euo pipefail
HERE="$(cd "$(dirname "$0")" && pwd)"
. "$HERE/hv-types.sh"
. "$HERE/hv-self-locate.sh"
hv_self_locate

GREP_PATTERN=""
while [ $# -gt 0 ]; do
  case "$1" in
    --grep)
      GREP_PATTERN="${2:-}"
      shift 2
      ;;
    --grep=*)
      GREP_PATTERN="${1#*=}"
      shift
      ;;
    *)
      echo "error: unknown argument: $1" >&2
      exit 1
      ;;
  esac
done
export GREP_PATTERN

PYTHONPATH="$HERE${PYTHONPATH:+:$PYTHONPATH}" python3 - <<'PY'
import json, os, re
from collections import defaultdict
from pathlib import Path
from hvlib import iter_open_sections, load_json, parse_todo_fields, active_items, parse_open_bullet

ITEM_CLASS = f"[{os.environ['HV_ITEM_TYPES']}]"

todo_path = Path(".hv/TODO.md")
if not todo_path.exists():
    print("No .hv/TODO.md yet. Run /hv-init then /hv-capture.")
    raise SystemExit(0)
content = todo_path.read_text()

status_path = Path(".hv/status.json")
active_entries, active_ids = [], set()
data = load_json(status_path, {"active": []})
for entry in data.get("active", []):
    active_entries.append(entry)
    for i in active_items(entry):
        active_ids.add(i)

def parse_items(body):
    items = []
    for line in body.splitlines():
        line = line.strip()
        parsed = parse_open_bullet(line)
        if parsed is None:
            continue
        item_id = parsed.get("id")
        tag = parsed.get("tag") or ""
        title = parsed.get("title") or ""
        fields = parse_todo_fields(line)
        related = fields["related"].rstrip(".")
        milestones = ", ".join(re.findall(r"M\d+", fields["milestone"]))
        items.append({"id": item_id, "tag": tag, "title": title, "related": related, "milestone": milestones, "raw": line})
    return items

_open_bodies = dict(iter_open_sections(content))
bugs = [i for i in parse_items(_open_bodies.get("Bugs", "")) if i["id"] not in active_ids]
features = [i for i in parse_items(_open_bodies.get("Features", "")) if i["id"] not in active_ids]
tasks = [i for i in parse_items(_open_bodies.get("Tasks", "")) if i["id"] not in active_ids]

prio = {"P0": 0, "P1": 1, "P2": 2, "": 3}
size = {"Cosmetic": 0, "Minor": 1, "Major": 2, "": 3}
bugs.sort(key=lambda x: prio.get(x["tag"], 3))
features.sort(key=lambda x: size.get(x["tag"], 3))

# --grep <pattern> filters Bugs/Features/Tasks rows by case-insensitive substring
# against each item's full raw bullet line (ID, title, desc, Related, etc.).
# In Progress is state and is never filtered. Clusters keep all members if any
# member matched (cluster context is the value-add).
_raw_pattern = os.environ.get("GREP_PATTERN", "")
_pattern = _raw_pattern.lower()
if _pattern:
    bugs = [i for i in bugs if _pattern in i["raw"].lower()]
    features = [i for i in features if _pattern in i["raw"].lower()]
    tasks = [i for i in tasks if _pattern in i["raw"].lower()]

def title_of(item_id):
    m = re.search(rf"\*\*\[{re.escape(item_id)}\][^*]*\*\*", content)
    if not m:
        return "?"
    tm = re.search(r"\]\s+([^.]+?)\.", m.group(0))
    return tm.group(1).strip() if tm else "?"

out = []

if active_entries:
    show_repo = any(e.get("repo") for e in active_entries)
    out.append("### In Progress\n")
    if show_repo:
        out.append("| ID | Title | Branch | Repo | Started |")
        out.append("|----|-------|--------|------|---------|")
    else:
        out.append("| ID | Title | Branch | Started |")
        out.append("|----|-------|--------|---------|")
    for e in active_entries:
        branch = e.get("branch", "")
        started = (e.get("startedAt") or "")[:10]
        repo = e.get("repo") or ""
        for iid in active_items(e):
            if show_repo:
                out.append(f"| {iid} | {title_of(iid)} | {branch} | {repo} | {started} |")
            else:
                out.append(f"| {iid} | {title_of(iid)} | {branch} | {started} |")
    out.append("")

def render_table(label, items, base_headers, row_fn):
    if not items:
        return
    show_ms = any(i["milestone"] for i in items)
    headers = list(base_headers) + (["Milestone"] if show_ms else [])
    out.append(f"### {label}\n")
    out.append("| " + " | ".join(headers) + " |")
    out.append("|" + "|".join("----" for _ in headers) + "|")
    for i in items:
        row = row_fn(i) + ([i["milestone"]] if show_ms else [])
        out.append("| " + " | ".join(row) + " |")
    out.append("")

render_table("Bugs", bugs, ["ID", "Prio", "Title", "Related"],
             lambda i: [i["id"], i["tag"], i["title"], i["related"]])
render_table("Features", features, ["ID", "Size", "Title", "Related"],
             lambda i: [i["id"], i["tag"], i["title"], i["related"]])
render_table("Tasks", tasks, ["ID", "Title", "Related"],
             lambda i: [i["id"], i["title"], i["related"]])

# Connected components across all backlog items (≥ 2 members).
# Built from the original parsed lists so active items remain in the graph —
# a backlog item related to an in-flight one is still useful context.
all_items = [i for _name, body in iter_open_sections(content) for i in parse_items(body)]
title_by_id = {i["id"]: i["title"] for i in all_items}
adj = defaultdict(set)
id_pat = re.compile(rf"\[({ITEM_CLASS}\d+)\]")
for item in all_items:
    iid = item["id"]
    for rid in id_pat.findall(item["related"]):
        if rid != iid and rid in title_by_id:
            adj[iid].add(rid)
            adj[rid].add(iid)

seen, components = set(), []
for iid in sorted(title_by_id):
    if iid in seen:
        continue
    comp, queue = [], [iid]
    while queue:
        node = queue.pop()
        if node in seen:
            continue
        seen.add(node)
        comp.append(node)
        queue.extend(adj.get(node, ()))
    if len(comp) >= 2:
        components.append(sorted(comp))
components.sort(key=lambda c: c[0])

if _pattern:
    matched_ids = {i["id"] for i in all_items if _pattern in i["raw"].lower()}
    components = [c for c in components if any(cid in matched_ids for cid in c)]

if components:
    out.append("### Clusters\n")
    for comp in components:
        sep = " ↔ " if len(comp) == 2 else ", "
        out.append("- " + sep.join(f"[{cid}] {title_by_id[cid]}" for cid in comp))
    out.append("")

if not (active_entries or bugs or features or tasks):
    if _pattern:
        out.append(f"No matches for pattern '{_raw_pattern}'.")
    else:
        out.append("Backlog empty. Run /hv-capture to add items.")

print("\n".join(out))
PY

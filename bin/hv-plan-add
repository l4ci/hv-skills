#!/usr/bin/env bash
# Create a plan file under .hv/plans/<milestone>-<unit>.md.
# Issue mode (backlog.backend "issues"): an item plan (<milestone> <itemId>) is a `plan` note on the
#   item's issue and its --design pointer is recorded as `note:design`; a slice plan is a `plan:S<NN>` note on the
#   milestone's tracking issue (next S<NN> minted from the existing slice notes) and its --design
#   .hv/designs/<ID>.md is recorded as `note:<ID>:design` (the design note on item <ID>'s issue).
# Writer helper: exit 0 on successful plan creation; exit 1 on usage error or conflict.
# Usage:
#   hv-plan-add [--repo <name>] [--design <path>] <milestone> slice "<title>"        — mints next S<NN> for that milestone
#   hv-plan-add [--repo <name>] [--design <path>] <milestone> <itemId> "<title>"     — uses item ID (B07, F03, T11, S01, …) verbatim
#   --repo    Tag plan with sub-repo name for umbrella mode; validated against .hv/repos.json.
#   --design  Path to design artifact under .hv/designs/; recorded in plan frontmatter as a traceability pointer.
# Prints the full plan key on stdout (e.g. "M01-S03" or "M01-B07").
set -euo pipefail
. "$(dirname "${BASH_SOURCE[0]}")/hv-preamble.sh"
. "$HERE/hv-types.sh"
REPO=""
DESIGN=""
while :; do
  case "${1:-}" in
    --repo) REPO="${2:?usage: hv-plan-add [--repo <name>] [--design <path>] <milestone> <unit-or-slice> <title>}"; shift 2 ;;
    --design) DESIGN="${2:?usage: hv-plan-add [--repo <name>] [--design <path>] <milestone> <unit-or-slice> <title>}"; shift 2 ;;
    *) break ;;
  esac
done
if [ -n "$DESIGN" ]; then
  case "$DESIGN" in
    .hv/designs/*) ;;
    *) echo "error: --design path must start with .hv/designs/, got '$DESIGN'" >&2; exit 1 ;;
  esac
  # Issue mode: the design is a note on the item's issue, so there is no file to check.
  if [ ! -f "$DESIGN" ] && ! PYTHONPATH="$HERE${PYTHONPATH:+:$PYTHONPATH}" python3 -m hvlib_backend is-issues; then
    echo "error: --design file not found: $DESIGN" >&2
    exit 1
  fi
fi
MILESTONE="${1:?usage: hv-plan-add [--repo <name>] [--design <path>] <milestone> <unit-or-slice> <title>}"
UNIT="${2:?usage: hv-plan-add [--repo <name>] [--design <path>] <milestone> <unit-or-slice> <title>}"
TITLE="${3:?usage: hv-plan-add [--repo <name>] [--design <path>] <milestone> <unit-or-slice> <title>}"
PYTHONPATH="$HERE${PYTHONPATH:+:$PYTHONPATH}" python3 - "$MILESTONE" "$UNIT" "$TITLE" "$REPO" "$DESIGN" <<'PY'
import os, re, sys
from datetime import date
from pathlib import Path
from hvlib import write_text_atomic, get_backend, IssueBackend, BackendUnavailable, TrackerError, tracker_exit_code

milestone, unit_in, title, repo, design = sys.argv[1], sys.argv[2], sys.argv[3], sys.argv[4], sys.argv[5]
_plannable = os.environ.get("HV_PLANNABLE_TYPES", "BFTS")

if not re.fullmatch(r"M\d{2,}", milestone):
    print(f"error: milestone must look like M01/M02/…, got {milestone!r}", file=sys.stderr)
    sys.exit(1)

if repo:
    from hvlib import validate_repos
    names, missing, _ = validate_repos(repo)
    if not names:
        print(f"error: --repo {repo!r} is empty after parsing", file=sys.stderr)
        sys.exit(1)
    if missing:
        print(f"error: --repo name(s) not in .hv/repos.json: {', '.join(missing)}", file=sys.stderr)
        sys.exit(1)
    repo = ", ".join(names)

try:
    backend = get_backend()
except ValueError:
    backend = None  # file mode never depended on config
issue = isinstance(backend, IssueBackend)

plans_dir = Path(".hv/plans")
if not issue:
    plans_dir.mkdir(parents=True, exist_ok=True)

def tracker_call(fn, *args):
    try:
        return fn(*args)
    except BackendUnavailable as e:
        print(f"error: hv-plan-add: {e}", file=sys.stderr); sys.exit(2)
    except TrackerError as e:
        print(f"error: hv-plan-add: {e.message}", file=sys.stderr); sys.exit(tracker_exit_code(e))
    except LookupError as e:
        print(f"error: hv-plan-add: {e.args[0]}", file=sys.stderr); sys.exit(1)

if unit_in == "slice":
    if issue:
        existing = [Path(f"{milestone}-{u}.md") for u in tracker_call(backend.slice_units, milestone)]
    else:
        existing = sorted(plans_dir.glob(f"{milestone}-S*.md"))
    nums = []
    for p in existing:
        m = re.match(rf"{re.escape(milestone)}-S(\d+)", p.stem)
        if m:
            nums.append(int(m.group(1)))
    next_n = (max(nums) + 1) if nums else 1
    unit = f"S{next_n:02d}"
    unit_kind = "slice"
else:
    if not re.fullmatch(rf"[{_plannable}]\d{{1,}}" if issue else rf"[{_plannable}]\d{{2,}}", unit_in):
        print(f"error: unit must be 'slice' or an ID like B07/F03/T11/S02, got {unit_in!r}", file=sys.stderr)
        sys.exit(1)
    unit = unit_in
    unit_kind = "slice" if unit.startswith("S") else "item"

key = f"{milestone}-{unit}"
plan_path = plans_dir / f"{key}.md"
# Issue mode: an item plan (not a slice plan) is a `plan` note on the item's issue.
as_note = issue and unit_kind == "item"
as_slice = issue and unit_kind == "slice"
if as_slice:
    if tracker_call(backend.slice_get, milestone, unit) is not None:
        print(f"error: plan note for {key} already exists", file=sys.stderr)
        sys.exit(1)
    if design:
        m = re.fullmatch(rf"([{_plannable}]\d+)\.md", Path(design).name)
        if not m:
            print(f"error: --design for a slice plan must be .hv/designs/<ID>.md, got {design!r}", file=sys.stderr)
            sys.exit(1)
        design = f"note:{m.group(1)}:design"
elif as_note:
    try:
        exists = backend.note_get(unit, "plan") is not None
    except BackendUnavailable as e:
        print(f"error: hv-plan-add: {e}", file=sys.stderr); sys.exit(2)
    except TrackerError as e:
        print(f"error: hv-plan-add: {e.message}", file=sys.stderr); sys.exit(tracker_exit_code(e))
    except LookupError as e:
        print(f"error: hv-plan-add: {e.args[0]}", file=sys.stderr); sys.exit(1)
    if exists:
        print(f"error: plan note for {unit} already exists", file=sys.stderr)
        sys.exit(1)
    if design:
        design = "note:design"
elif plan_path.exists():
    print(f"error: {plan_path} already exists", file=sys.stderr)
    sys.exit(1)
else:
    plans_dir.mkdir(parents=True, exist_ok=True)

repo_line = f"repo: {repo}\n" if repo else ""
design_line = f"design: {design}\n" if design else ""

stub = (
    f"""---
key: {key}
milestone: {milestone}
unit: {unit}
unitKind: {unit_kind}
{repo_line}{design_line}title: {title}
status: planned
created: {date.today().isoformat()}
---

# {key} — {title}

## Goal

_(one sentence — what shipping this means)_

## Approach

_(3–6 sentences — the shape of the implementation, the design choice, why this over alternatives)_

## Tasks

- **T1** — _(observable behavior)_
  - Files: _(paths the orchestrator will touch or create)_
  - Verify: _(command or manual check that proves T1 done)_

## Open questions

- _(unresolved decisions — answer before or during execution)_

## Assumptions

- _(named assumptions made implicit by the approach)_
"""
)
if as_slice:
    tracker_call(backend.slice_put, milestone, unit, stub)
elif as_note:
    try:
        backend.note_put(unit, "plan", stub)
    except BackendUnavailable as e:
        print(f"error: hv-plan-add: {e}", file=sys.stderr); sys.exit(2)
    except TrackerError as e:
        print(f"error: hv-plan-add: {e.message}", file=sys.stderr); sys.exit(tracker_exit_code(e))
    except LookupError as e:
        print(f"error: hv-plan-add: {e.args[0]}", file=sys.stderr); sys.exit(1)
else:
    write_text_atomic(plan_path, stub)
print(key)
PY

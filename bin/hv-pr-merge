#!/usr/bin/env bash
# Merge a PR / MR (issue mode) and make sure the items it closes end up closed. Proof is checked
# first: if any open linked item has no proof row, nothing is merged (a merge into the default branch
# would let the host close the issue and skip the gate); each such item becomes changes-requested
# with a feedback comment. Otherwise merges with a merge commit, deletes the branch, and closes any
# linked issue the host left open with hv-complete semantics (reason done, merge sha).
# Linked items: --items, else every issue the PR body closes (a closing keyword like `Closes #N`).
# Prints: `merged <pr> as <sha7>`, then `closed <ID>` per closed item.
# Writer helper: exit 0 merged and every item closed; exit 5 not merged, an item is unproven (one
#   `unproven <ID>: ...` line each on stderr); exit 1 on usage error, unknown PR / item or tracker
#   failure; exit 2 file backend (use hv-merge); exit 3 tracker unavailable; exit 4 rate-limited.
# Usage: hv-pr-merge <pr> [--items <ID[,ID...]>]
set -euo pipefail
. "$(dirname "${BASH_SOURCE[0]}")/hv-preamble.sh"
USAGE="usage: hv-pr-merge <pr> [--items <ID[,ID...]>]"
PR="${1:?$USAGE}"; shift
ITEMS=""
while [ $# -gt 0 ]; do
  case "$1" in
    --items) ITEMS="${2:?$USAGE}"; shift 2 ;;
    *) echo "$USAGE" >&2; exit 1 ;;
  esac
done
case "$PR" in ''|*[!0-9]*) echo "$USAGE" >&2; exit 1 ;; esac
PYTHONPATH="$HERE${PYTHONPATH:+:$PYTHONPATH}" python3 - "$PR" "$ITEMS" <<'PY'
import sys
from hvlib import get_backend, IssueBackend, TrackerError, tracker_exit_code

pr, items = sys.argv[1], [x.strip() for x in sys.argv[2].split(",") if x.strip()]

def die(msg, code=1):
    sys.stderr.write(f"error: hv-pr-merge: {msg}\n"); sys.exit(code)

try:
    backend = get_backend()
    if not isinstance(backend, IssueBackend):
        die('not available with backlog.backend "file" — use hv-merge', 2)
    sha, closed, unproven = backend.merge_pr(pr, items or None)
except TrackerError as e:
    die(e.message, tracker_exit_code(e))
except (LookupError, ValueError) as e:
    die(e.args[0])
if unproven:
    for i in unproven:
        sys.stderr.write(f"unproven {i}: not merged, no proof recorded (now changes-requested)\n")
    sys.exit(5)
print(f"merged {pr} as {sha[:7]}")
for i in closed:
    print(f"closed {i}")
PY

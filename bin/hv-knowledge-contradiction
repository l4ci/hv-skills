#!/usr/bin/env bash
# Manage the pending-contradictions queue at .hv/knowledge-contradictions.json.
# /hv-work and /hv-review --add candidates when user corrections overlap with
# queried KNOWLEDGE bullets. /hv-learn --list / --clear processes them at
# session end. hv-knowledge-hit --has gates auto-promotion when pending.
# Writer/lookup helper: exit 0 on success (or empty queue);
# exit 1 on argv error, schema mismatch, or --has miss.
# Usage: hv-knowledge-contradiction --add|--list|--clear|--has [flags]
set -euo pipefail
. "$(dirname "${BASH_SOURCE[0]}")/hv-preamble.sh"
PYTHONPATH="$HERE${PYTHONPATH:+:$PYTHONPATH}" python3 - "$@" <<'PY'
import argparse
import json
import sys
from datetime import datetime, timezone
from pathlib import Path
from hvlib import load_sidecar, dump_json_atomic, locked

QUEUE_PATH = Path(".hv/knowledge-contradictions.json")
EXPECTED_VERSION = 1


def load_queue():
    try:
        return load_sidecar(
            QUEUE_PATH,
            schema_version=EXPECTED_VERSION,
            default={"version": EXPECTED_VERSION, "pending": []},
        )
    except ValueError as e:
        print(f"error: {e}", file=sys.stderr)
        sys.exit(1)


def atomic_write(data):
    QUEUE_PATH.parent.mkdir(parents=True, exist_ok=True)
    dump_json_atomic(QUEUE_PATH, data)


def cmd_add(args):
    # Serialize the read-modify-write — concurrent --add calls must not lose entries.
    with locked(QUEUE_PATH):
        data = load_queue()
        data["pending"].append({
            "topic": args.topic,
            "title": args.title,
            "correctionText": args.text,
            "loggedAt": datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ"),
        })
        atomic_write(data)


def cmd_list(_args):
    data = load_queue()
    print(json.dumps(data["pending"], indent=2))


def cmd_clear(_args):
    with locked(QUEUE_PATH):
        data = load_queue()
        data["pending"] = []
        atomic_write(data)


def cmd_has(args):
    data = load_queue()
    for entry in data["pending"]:
        if entry.get("topic") == args.topic and entry.get("title") == args.title:
            sys.exit(0)
    sys.exit(1)


# argparse cannot use '--foo' as a subcommand name (parsed as optional arg),
# so we peel the subcommand off argv[0] ourselves and delegate flag parsing
# to per-subcommand ArgumentParser instances — typos in flags still hard-error.
def make_parser_add():
    p = argparse.ArgumentParser(prog="hv-knowledge-contradiction --add")
    p.add_argument("--topic", required=True)
    p.add_argument("--title", required=True)
    p.add_argument("--text", required=True)
    return p


def make_parser_has():
    p = argparse.ArgumentParser(prog="hv-knowledge-contradiction --has")
    p.add_argument("--topic", required=True)
    p.add_argument("--title", required=True)
    return p


def make_parser_no_flags(subcmd):
    return argparse.ArgumentParser(prog=f"hv-knowledge-contradiction {subcmd}")


COMMANDS = {
    "--add":   (cmd_add,   make_parser_add),
    "--list":  (cmd_list,  lambda: make_parser_no_flags("--list")),
    "--clear": (cmd_clear, lambda: make_parser_no_flags("--clear")),
    "--has":   (cmd_has,   make_parser_has),
}

argv = sys.argv[1:]
if not argv or argv[0] not in COMMANDS:
    print("error: subcommand required: --add | --list | --clear | --has", file=sys.stderr)
    sys.exit(1)

func, make_parser = COMMANDS[argv[0]]
ns = make_parser().parse_args(argv[1:])
func(ns)
PY

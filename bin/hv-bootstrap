#!/usr/bin/env bash
# Seed .hv/ directories and data files in the current directory.
# Idempotent — never overwrites existing files. Safe to re-run.
# Tool: seeds .hv/ directory structure; idempotent; exit 0 on success.
# Mutator (writer): seeds .hv/ files idempotently and renames legacy .hv/TODO.md → .hv/BACKLOG.md if present. Exit 0 on rename action OR no-op; exit 1 only on missing precondition. Emits 'wrote: <path>' or 'noop: <path>' to stderr.
# Called by /hv-init Step 2 from the source bin/ before .hv/bin/ exists.
set -euo pipefail

HV=".hv"
mkdir -p "$HV"/{bugs,features,tasks,milestones,plans,spikes,map,bin}

# Legacy migration: if a legacy .hv/TODO.md exists AND .hv/BACKLOG.md does not,
# rename it. Idempotent: both files present → prefer BACKLOG.md, emit 'noop:'
# and continue (do NOT error). Only TODO.md present → rename and emit 'wrote:'.
# Exit 0 in either branch per the mutator-exit-code decision.
if [ -f "$HV/TODO.md" ] && [ ! -f "$HV/BACKLOG.md" ]; then
  mv "$HV/TODO.md" "$HV/BACKLOG.md"
  echo "wrote: $HV/BACKLOG.md (renamed from TODO.md)" >&2
elif [ -f "$HV/TODO.md" ] && [ -f "$HV/BACKLOG.md" ]; then
  echo "noop: $HV/BACKLOG.md (legacy $HV/TODO.md still present; not overwriting)" >&2
fi

[ -f "$HV/BACKLOG.md" ] || cat > "$HV/BACKLOG.md" <<'EOF'
# Backlog

## Bugs

## Features

## Tasks

## Completed
EOF

[ -f "$HV/KNOWLEDGE.md" ] || cat > "$HV/KNOWLEDGE.md" <<'EOF'
# Knowledge

Durable learnings captured from sessions — gotchas, conventions, constraints, and hard-won debugging insights. Grouped by topic, newest first within each topic.

Use `/hv-learn` at the end of a session to capture new learnings. `/hv-work` consults this file when its topics are relevant to the task.

## Glossary

_(no terms yet — use `/hv-learn --term <name>` to capture project terminology)_
EOF

[ -f "$HV/DECISIONS.md" ] || cat > "$HV/DECISIONS.md" <<'EOF'
# Decisions

Hard boundaries for this project. Each entry is a commitment, not a preference — re-read before proposing changes that touch its area.

Use `/hv-decide` to capture a new decision. `/hv-work`, `/hv-debug`, `/hv-plan`, `/hv-refactor`, `/hv-review`, and `/hv-vision` consult this file when its topics are relevant.
EOF

[ -f "$HV/MAP.md" ] || cat > "$HV/MAP.md" <<'EOF'
# Project map

AI-facing index of subsystems. Detail files live in `.hv/map/<name>.md` and are loaded on demand via `.hv/bin/hv-map-query <name>`. The thin always-on summary in `CLAUDE.md` is regenerated by `.hv/bin/hv-map-index`.

Write `.hv/map/<name>.md` files describing subsystems as you discover them. Cycle skills (`/hv-work`, `/hv-debug`, `/hv-go`) bump `touched:` post-cycle on subsystems whose key files or entry points overlap the cycle's changes.
EOF

[ -f "$HV/MILESTONES.md" ] || cat > "$HV/MILESTONES.md" <<'EOF'
# Milestones

_(no vision yet — run `/hv-vision` to brainstorm milestones)_

## Active milestones

_(none active — set with `/hv-vision`)_

## Milestones
EOF

# Migrate existing MILESTONES.md files whose H1 is still "# Vision" → "# Milestones".
# Rewrites only line 1 when it is exactly "# Vision"; all other content is preserved.
# Idempotent: files already starting with "# Milestones" (or anything else) are untouched.
if [ -f "$HV/MILESTONES.md" ] && [ "$(head -1 "$HV/MILESTONES.md")" = "# Vision" ]; then
  python3 - <<'PY'
from pathlib import Path
p = Path(".hv/MILESTONES.md")
lines = p.read_text().splitlines(keepends=True)
if lines and lines[0].rstrip('\n') == "# Vision":
    lines[0] = "# Milestones\n"
    p.write_text("".join(lines))
PY
fi

[ -f "$HV/counters.json" ] || echo '{"bugs":0,"features":0,"tasks":0,"milestones":0,"since_refactor":{"features":0,"bugs":0}}' > "$HV/counters.json"

# Migrate older counters.json files to backfill keys added in later versions.
HERE="$(cd "$(dirname "$0")" && pwd)"
PYTHONPATH="$HERE${PYTHONPATH:+:$PYTHONPATH}" python3 - <<'PY'
from pathlib import Path
from hvlib import load_json, dump_json_atomic
p = Path(".hv/counters.json")
d = load_json(p, {})
changed = False
if "milestones" not in d:
    d["milestones"] = 0
    changed = True
if "since_refactor" not in d:
    d["since_refactor"] = {"features": 0, "bugs": 0}
    changed = True
if changed:
    dump_json_atomic(p, d)
PY

[ -f "$HV/status.json" ] || echo '{"active":[]}' > "$HV/status.json"

[ -f "$HV/repos.json" ] || echo '{"repos":[]}' > "$HV/repos.json"

[ -f "$HV/config.json" ] || cat > "$HV/config.json" <<'EOF'
{
  "issues": {
    "label": "in-progress",
    "autoCreateLabel": true,
    "filterMineOnly": false,
    "providers": {
      "github": true,
      "gitlab": true
    }
  }
}
EOF

# Partial-tracking gitignore: most of .hv/ travels with the repo so team
# members share backlog/knowledge/decisions/plans/designs context. Only
# machine-specific or regenerated paths are ignored.
IGNORE_LINES=(
  '# ── hv-skills ──'
  '.hv/bin/'
  '.hv/status.json'
  '.hv/repos.json'
  '.hv/config.local.json'
  '.hv/handoff/'
  '.hv/qa-runs/'
  '.hv/**/*.lock'
)
if [ -f .gitignore ]; then
  missing=0
  for line in "${IGNORE_LINES[@]:1}"; do
    grep -qxF "$line" .gitignore 2>/dev/null || missing=1
  done
  if [ "$missing" = 1 ]; then
    printf '\n' >> .gitignore
    for line in "${IGNORE_LINES[@]}"; do printf '%s\n' "$line" >> .gitignore; done
  fi
  # Legacy migration: a project upgrading from v4.0.x or earlier may carry a
  # blanket `.hv/` line. Strip it so the new per-file pattern takes effect
  # (the per-file rules above are stricter and produce the intended subset).
  if grep -qxF '.hv/' .gitignore 2>/dev/null; then
    tmp="$(mktemp)"
    grep -vxF '.hv/' .gitignore > "$tmp" && mv "$tmp" .gitignore
  fi
else
  for line in "${IGNORE_LINES[@]}"; do printf '%s\n' "$line" >> .gitignore; done
fi

# Umbrella scaffolding: per-sub-repo glossary support is deferred to F21
# (Umbrella-aware KNOWLEDGE.md); v4.0 ships single-repo Glossary only.

# Migrate KNOWLEDGE.md preamble from legacy /hv:X to /hv-X (Claude Code
# normalizes colons; the rename shipped in plugin 1.3.6+). Only rewrites
# the preamble region — captured learning bullets are never touched.
if [ -f "$HV/KNOWLEDGE.md" ] && grep -q '^Use `/hv:' "$HV/KNOWLEDGE.md"; then
  python3 - <<'PY'
from pathlib import Path
import re
p = Path(".hv/KNOWLEDGE.md")
lines = p.read_text().splitlines(keepends=True)
changed = False
for i, line in enumerate(lines):
    if line.startswith("## "):
        break
    new = re.sub(r"/hv:([a-z][a-z0-9-]*)", r"/hv-\1", line)
    if new != line:
        lines[i] = new
        changed = True
if changed:
    p.write_text("".join(lines))
PY
fi

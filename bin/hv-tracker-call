#!/usr/bin/env bash
# The single place gh/glab is invoked: resolves the provider, injects list limits and
# pagination, and handles rate limits in a bounded way.
# Wrapper helper: stdout is the CLI's stdout, unchanged.
# Exit codes: 0 success / the CLI's own exit code on a plain failure / 3 tracker unavailable
# (provider unknown, CLI not installed, not authenticated) / 4 rate-limited.
# Provider: --provider flag > issues.provider (when not "auto") > hv-issues-provider (run in the caller's cwd).
# Injected: gh `issue|pr list` get --limit 1000, glab `issue list|mr list` get --per-page 100 (only when
#   absent); GET-only `api` calls get --paginate. A JSON array result that hits the injected limit warns on stderr.
# Rate limits: a secondary/abuse limit stops at once (retrying extends the lockout); a primary limit waits
#   issues.retryWaitSeconds and retries once. Never more than two attempts.
# stdin: read once and fed to every attempt only when an argument takes it (`-`, `@-`, `=-`), so `-F -`
#   bodies survive a retry; otherwise the CLI gets /dev/null and an inherited open pipe can't block.
# Usage: hv-tracker-call [--provider auto|github|gitlab] -- <cli args...>
set -euo pipefail
. "$(dirname "${BASH_SOURCE[0]}")/hv-preamble.sh"
USAGE="usage: hv-tracker-call [--provider auto|github|gitlab] -- <cli args...>"
PROVIDER=""
while [ $# -gt 0 ]; do
  case "$1" in
    --provider) PROVIDER="${2:?$USAGE}"; shift 2 ;;
    --) shift; break ;;
    *) echo "$USAGE" >&2; exit 1 ;;
  esac
done
case "${PROVIDER:-auto}" in auto|github|gitlab) ;; *) echo "$USAGE" >&2; exit 1 ;; esac
[ $# -ge 1 ] || { echo "$USAGE" >&2; exit 1; }

# stdin stays free for the payload, so the script travels via -c rather than a heredoc on python's stdin.
PYSRC="$(cat <<'PY'
import json, os, re, subprocess, shutil, sys, time

from hvlib import load_config, config_value

provider, here, *args = sys.argv[1:]
cfg = load_config()
wait = config_value(cfg, "issues.retryWaitSeconds")

# hv-preamble.sh cd'd to the project root; the CLI and provider detection want the caller's cwd.
orig = os.environ.get("HV_ORIG_PWD")
if orig:
    os.chdir(orig)

def die(code, msg):
    print(f"error: hv-tracker-call: {msg}", file=sys.stderr)
    sys.exit(code)

if provider in ("", "auto"):
    provider = config_value(cfg, "issues.provider")
if provider not in ("github", "gitlab"):
    r = subprocess.run([os.path.join(here, "hv-issues-provider")], capture_output=True, text=True)
    provider = r.stdout.strip() or "unknown"
if provider not in ("github", "gitlab"):
    die(3, "cannot determine provider (set issues.provider)")
cli = "gh" if provider == "github" else "glab"
if not shutil.which(cli):
    die(3, f"{cli} is not installed")

def has(flags, args):
    return any(a in flags or any(a.startswith(f + "=") for f in flags if f.startswith("--")) for a in args)

limit = None
if provider == "github" and args[:2] in (["issue", "list"], ["issue", "ls"], ["pr", "list"], ["pr", "ls"]):
    if not has(("-L", "--limit"), args) and not any(re.fullmatch(r"-L\d+", a) for a in args):
        args += ["--limit", "1000"]; limit = 1000
elif provider == "gitlab" and args[:2] in (["issue", "list"], ["issue", "ls"], ["mr", "list"], ["mr", "ls"]):
    if not has(("-P", "--per-page"), args) and not any(re.fullmatch(r"-P\d+", a) for a in args):
        args += ["--per-page", "100"]; limit = 100

if args[:1] == ["api"] and "--paginate" not in args:
    method = "GET"
    for i, a in enumerate(args):
        if a in ("-X", "--method") and i + 1 < len(args):
            method = args[i + 1].upper()
        elif a.startswith("--method="):
            method = a.split("=", 1)[1].upper()
        elif a.startswith("-X") and len(a) > 2:
            method = a[2:].upper()
    fields = has(("-f", "-F", "--field", "--raw-field", "--input"), args) or any(
        re.match(r"-[fF][^-]", a) for a in args)
    if method == "GET" and not fields:
        args.append("--paginate")

wants_stdin = any(a == "-" or a.endswith(("=-", "@-")) for a in args)
data = sys.stdin.buffer.read() if wants_stdin else b""

SECONDARY = re.compile(r"secondary rate limit|abuse detection", re.I)
PRIMARY = re.compile(r"api rate limit exceeded|http 429|429 too many requests|rate limit exceeded", re.I)
AUTH = re.compile(r"gh auth login|glab auth login|not logged in|http 401|401 unauthorized", re.I)

def attempt():
    return subprocess.run([cli] + args, input=data, capture_output=True)

r = attempt()
for tries in (1, 2):
    err = r.stderr.decode(errors="replace")
    if r.returncode == 0:
        break
    if SECONDARY.search(err):
        die(4, f"{provider} secondary rate limit — stopped; wait several minutes before retrying")
    if PRIMARY.search(err):
        if tries == 2:
            die(4, f"{provider} rate limit — stopped after one retry")
        time.sleep(float(wait))
        r = attempt()
        continue
    break

err = r.stderr.decode(errors="replace")
if r.returncode != 0:
    if AUTH.search(err):
        die(3, f"{cli} is not authenticated; run '{cli} auth login'")
    sys.stdout.buffer.write(r.stdout); sys.stdout.flush()
    sys.stderr.write(err)
    sys.exit(r.returncode)

sys.stdout.buffer.write(r.stdout); sys.stdout.flush()
sys.stderr.write(err)
if limit:
    try:
        parsed = json.loads(r.stdout)
    except ValueError:
        parsed = None
    if isinstance(parsed, list) and len(parsed) == limit:
        print(f"warning: hv-tracker-call: result hit the list limit ({limit}); results may be truncated", file=sys.stderr)
PY
)"
PYTHONPATH="$HERE${PYTHONPATH:+:$PYTHONPATH}" exec python3 -c "$PYSRC" "$PROVIDER" "$HERE" "$@"

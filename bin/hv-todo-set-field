#!/usr/bin/env bash
# Set/replace/clear a trailing field on the open TODO bullet of <ID> in
# .hv/BACKLOG.md, using hvlib.set_todo_field. The writer counterpart of the
# read-only hv-todo-field — lets skills retag an existing entry (e.g. /hv-plan
# tagging a milestone) without hand-editing .hv/BACKLOG.md, which the project
# forbids.
# Resolve helper: exits 1 when ID has no open bullet or field is not settable.
#
# Usage: hv-todo-set-field <ID> <field> <value>
#          <field>: milestone | related | repos | subsystem | detail
#          <value>: new field value; an empty value ("") clears the field
#          exit:   0 on success (incl. idempotent no-op), 1 on unknown
#                  open ID / bad field, 2 on usage error
#
# detail takes the path of an existing file and is file-backend only.
#
# With backlog.backend "issues" the field lands on the open issue (Milestone is
# the native milestone); tracker failures exit 1 (3/4 pass through).
#
# Only open bullets in .hv/BACKLOG.md are mutated — completed/archived items
# are intentionally out of scope (retagging is a planning-time operation on
# live work).
set -euo pipefail

if [ "$#" -lt 3 ]; then
  echo "usage: hv-todo-set-field <ID> <field> <value>" >&2
  exit 2
fi
ID="$1"
FIELD="$2"
VALUE="$3"
HERE="$(cd "$(dirname "$0")" && pwd)"
PYTHONPATH="$HERE${PYTHONPATH:+:$PYTHONPATH}" python3 - "$ID" "$FIELD" "$VALUE" <<'PY'
import sys

from hvlib import get_backend, TrackerError, tracker_exit_code

iid, field, value = sys.argv[1], sys.argv[2], sys.argv[3]

try:
    backend = get_backend()
except ValueError as e:
    sys.stderr.write(f"error: hv-todo-set-field: {e}\n"); sys.exit(1)
try:
    backend.set_field(iid, field, value)
except TrackerError as e:
    sys.stderr.write(f"error: hv-todo-set-field: {e.message}\n"); sys.exit(tracker_exit_code(e))
except FileNotFoundError as e:
    sys.stderr.write(f"error: {e} not found\n")
    sys.exit(1)
except (LookupError, ValueError) as e:
    sys.stderr.write(f"error: {e.args[0]}\n")
    sys.exit(1)
PY

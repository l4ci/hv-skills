#!/usr/bin/env bash
# This is a resolve helper — exits 1 when an ID is not found in TODO+ARCHIVE.
# Remove one or more captured items from .hv/TODO.md and clean up dependencies.
# Usage: hv-rm [--dry-run] [--force] [--scrub-archive] <ID>[,<ID>...]
#   --dry-run       Preview changes without writing (default behaviour).
#   --force         Apply changes (remove entries, strip cross-refs, delete files).
#   --scrub-archive Also remove matching entries from .hv/ARCHIVE.md.
set -euo pipefail
HERE="$(cd "$(dirname "$0")" && pwd)"
. "$HERE/hv-types.sh"
. "$HERE/hv-self-locate.sh"
hv_self_locate
FORCE=0
SCRUB_ARCHIVE=0
while :; do
  case "${1:-}" in
    --dry-run) shift ;;
    --force) FORCE=1; shift ;;
    --scrub-archive) SCRUB_ARCHIVE=1; shift ;;
    --*) echo "error: unknown flag: ${1}" >&2; exit 1 ;;
    *) break ;;
  esac
done
IDS_CSV="${1:?usage: hv-rm [--dry-run] [--force] [--scrub-archive] <ID>[,<ID>...]}"
PYTHONPATH="$HERE${PYTHONPATH:+:$PYTHONPATH}" python3 - "$IDS_CSV" "$FORCE" "$SCRUB_ARCHIVE" <<'PY'
import os
import re
import sys
from pathlib import Path
from hvlib import (
    find_section,
    replace_section,
    write_text_atomic,
    dump_json_atomic,
    load_json,
    parse_todo_fields,
    find_bullet_in_content,
    infer_type_from_section,
    infer_type_from_id,
    detail_dir_for_id,
    strip_bullet_from_content,
    parse_related_ids,
    remove_id_from_related_field,
    collect_cross_refs,
    apply_cross_ref_strips,
    active_items,
)

ids_csv, force_str, scrub_str = sys.argv[1], sys.argv[2], sys.argv[3]
force = force_str == "1"
scrub_archive = scrub_str == "1"

# Parse IDs from CSV.
raw_ids = [i.strip() for i in ids_csv.split(",") if i.strip()]
if not raw_ids:
    print("error: no IDs provided", file=sys.stderr)
    sys.exit(1)

TODO_PATH = Path(".hv/TODO.md")
ARCHIVE_PATH = Path(".hv/ARCHIVE.md")
STATUS_PATH = Path(".hv/status.json")

# Derive active sections from the canonical env var (single source of truth in
# hv-types.sh). "Completed" is appended locally because it isn't an OPEN
# section — hv-rm needs to scan it for done/strikethrough bullets too.
_OPEN = os.environ.get("HV_OPEN_SECTIONS", "Bugs|Features|Tasks").split("|")
TODO_ACTIVE_SECTIONS = _OPEN + ["Completed"]
_TYPES = os.environ.get("HV_ITEM_TYPES", "BFT")
_PREFIX_TO_SECTION = dict(zip(_TYPES, _OPEN))

# ── helpers ──────────────────────────────────────────────────────────────────

def read_file(path: Path) -> str:
    if path.exists():
        return path.read_text()
    return ""

def find_plan_files(iid: str) -> list[Path]:
    """Scan .hv/plans/ for files whose stem ends in -<iid>."""
    plans_dir = Path(".hv/plans")
    if not plans_dir.is_dir():
        return []
    matches = [p for p in plans_dir.iterdir() if p.suffix == ".md" and p.stem.endswith(f"-{iid}")]
    return sorted(matches)

# ── validation pass: all IDs must exist before any write ─────────────────────

todo_content = read_file(TODO_PATH)
archive_content = read_file(ARCHIVE_PATH)

# Build info per ID.
id_info = {}  # iid → {source, sec_name, bullet_line, item_type}

for iid in raw_ids:
    # Try TODO first.
    sec_name, bullet = find_bullet_in_content(todo_content, iid, TODO_ACTIVE_SECTIONS)
    if sec_name is not None:
        id_info[iid] = {
            "source": "todo",
            "source_path": TODO_PATH,
            "source_content": todo_content,
            "sec_name": sec_name,
            "bullet_line": bullet,
            "item_type": infer_type_from_section(sec_name),
        }
        continue

    # Fall through to ARCHIVE.
    if archive_content:
        sec_name, bullet = find_bullet_in_content(archive_content, iid, TODO_ACTIVE_SECTIONS)
        if sec_name is not None:
            id_info[iid] = {
                "source": "archive",
                "source_path": ARCHIVE_PATH,
                "source_content": archive_content,
                "sec_name": sec_name,
                "bullet_line": bullet,
                "item_type": infer_type_from_section(sec_name),
            }
            continue

    # Not found.
    print(f"error: [{iid}] not found in .hv/TODO.md or .hv/ARCHIVE.md", file=sys.stderr)
    sys.exit(1)

# ── active-stream guard ───────────────────────────────────────────────────────

status_data = load_json(STATUS_PATH, {"active": []})
active_entries = status_data.get("active", [])

# Map iid → entry for active items.
active_hit = {}  # iid → entry dict
for iid in raw_ids:
    for entry in active_entries:
        entry_ids = active_items(entry)
        if iid in entry_ids:
            active_hit[iid] = entry
            break

for iid, entry in active_hit.items():
    branch = entry.get("branch", "(unknown)")
    if not force:
        print(
            f"error: [{iid}] is active on branch {branch}; pass --force to strip from active stream",
            file=sys.stderr,
        )
        sys.exit(2)
    else:
        print(
            f"warning: [{iid}] was active on branch {branch}; stripped from status.json",
            file=sys.stderr,
        )

# ── compute cleanup plan ──────────────────────────────────────────────────────

plans = {}  # iid → {todo_entry, xrefs_todo, xrefs_archive, detail_path, plan_files, status_strip}

# Sections to scan for cross-references in TODO.
xref_sections_todo = ["Bugs", "Features", "Tasks", "Completed"]

for iid in raw_ids:
    info = id_info[iid]
    source = info["source"]  # "todo" or "archive"

    # Cross-references in TODO (always).
    xrefs_todo = collect_cross_refs(todo_content, iid, xref_sections_todo)

    # Cross-references in ARCHIVE (only if scrub_archive).
    xrefs_archive = []
    if scrub_archive and archive_content:
        # Scan all ## sections in ARCHIVE.
        import re as _re
        archive_secs = [m.group(1) for m in _re.finditer(r"^## (.+)$", archive_content, _re.MULTILINE)]
        xrefs_archive = collect_cross_refs(archive_content, iid, archive_secs)

    # Detail file.
    dir_name = detail_dir_for_id(iid)
    detail_path: Path | None = None
    if dir_name:
        candidate = Path(".hv") / dir_name / f"{iid}.md"
        if candidate.exists():
            detail_path = candidate

    # Plan files.
    plan_files = find_plan_files(iid)

    # Status strip plan.
    status_strip = active_hit.get(iid)  # the entry to strip iid from, or None

    plans[iid] = {
        "info": info,
        "xrefs_todo": xrefs_todo,
        "xrefs_archive": xrefs_archive,
        "detail_path": detail_path,
        "plan_files": plan_files,
        "status_strip": status_strip,
    }

# ── dry-run output ────────────────────────────────────────────────────────────

def short_path(p: Path) -> str:
    return str(p)

for iid in raw_ids:
    plan = plans[iid]
    info = plan["info"]
    xrefs_todo = plan["xrefs_todo"]
    xrefs_archive = plan["xrefs_archive"]
    detail_path = plan["detail_path"]
    plan_files = plan["plan_files"]
    status_strip = plan["status_strip"]
    source = info["source"]
    sec_name = info["sec_name"]
    bullet = info["bullet_line"]
    src_path = info["source_path"]

    print(f"[{iid}] removal plan:")

    # TODO/ARCHIVE entry.
    print(f"  TODO entry: {short_path(src_path)} ## {sec_name} (line removed)")
    print(f"    {bullet}")

    # Cross-references in TODO.
    total_xrefs = len(xrefs_todo) + len(xrefs_archive)
    if total_xrefs:
        print(f"  Cross-references to strip: {total_xrefs}")
        for sec, old_line, new_line in xrefs_todo:
            # Extract the ID of the bullet being modified.
            m = re.match(r"- (?:~~)?\*\*\[([A-Z]\d+)\]", old_line)
            ref_id = m.group(1) if m else "?"
            print(f"    {short_path(TODO_PATH)} ## {sec} [{ref_id}]: Related: [{iid}] → (removed)")
        for sec, old_line, new_line in xrefs_archive:
            m = re.match(r"- (?:~~)?\*\*\[([A-Z]\d+)\]", old_line)
            ref_id = m.group(1) if m else "?"
            print(f"    {short_path(ARCHIVE_PATH)} ## {sec} [{ref_id}]: Related: [{iid}] → (removed)")
    else:
        print(f"  Cross-references to strip: 0")

    # Detail file.
    if detail_path:
        print(f"  Detail file: {short_path(detail_path)} (delete)")
    else:
        dir_name = detail_dir_for_id(iid)
        if dir_name:
            print(f"  Detail file: .hv/{dir_name}/{iid}.md (not present — skip)")
        else:
            print(f"  Detail file: none (cannot infer type from ID prefix)")

    # Plan files.
    if plan_files:
        print(f"  Plan files: {len(plan_files)}")
        for pf in plan_files:
            print(f"    {short_path(pf)} (delete)")
    else:
        print(f"  Plan files: 0")

    # ARCHIVE note.
    if source == "archive":
        if scrub_archive:
            print(f"  ARCHIVE: entry in {short_path(ARCHIVE_PATH)} ## {sec_name} (line removed)")
        else:
            print(f"  ARCHIVE: entry found but untouched (use --scrub-archive to remove)")
    else:
        if scrub_archive:
            print(f"  ARCHIVE: untouched (item not in ARCHIVE)")
        else:
            print(f"  ARCHIVE: untouched (use --scrub-archive to mirror)")

    # Active stream.
    if status_strip:
        branch = status_strip.get("branch", "(unknown)")
        print(f"  Active stream: [{iid}] will be stripped from branch {branch} in status.json")
    else:
        print(f"  Active stream: none")

    print()

if not force:
    print("dry-run — no files modified.")
    sys.exit(0)

# ── apply mode ────────────────────────────────────────────────────────────────

# Work on fresh copies of file content (read once, mutate in memory, write once).
new_todo = todo_content
new_archive = archive_content

for iid in raw_ids:
    plan = plans[iid]
    info = plan["info"]
    xrefs_todo = plan["xrefs_todo"]
    xrefs_archive = plan["xrefs_archive"]
    detail_path = plan["detail_path"]
    plan_files = plan["plan_files"]
    status_strip = plan["status_strip"]
    source = info["source"]
    sec_name = info["sec_name"]
    bullet = info["bullet_line"]

    # Remove the origin bullet from its source file.
    if source == "todo":
        new_todo = strip_bullet_from_content(new_todo, bullet, sec_name)
    elif source == "archive" and scrub_archive:
        new_archive = strip_bullet_from_content(new_archive, bullet, sec_name)

    # Strip cross-references in TODO.
    new_todo = apply_cross_ref_strips(new_todo, xrefs_todo)

    # Strip cross-references in ARCHIVE.
    if scrub_archive and xrefs_archive:
        new_archive = apply_cross_ref_strips(new_archive, xrefs_archive)

# Write TODO if changed.
if new_todo != todo_content:
    write_text_atomic(TODO_PATH, new_todo)

# Write ARCHIVE if changed.
if new_archive != archive_content and scrub_archive:
    write_text_atomic(ARCHIVE_PATH, new_archive)

# Delete detail files and plan files.
for iid in raw_ids:
    plan = plans[iid]
    detail_path = plan["detail_path"]
    plan_files = plan["plan_files"]

    if detail_path and detail_path.exists():
        detail_path.unlink()

    for pf in plan_files:
        if pf.exists():
            pf.unlink()

# Strip active stream entries.
if any(plan["status_strip"] for plan in plans.values()):
    def mutator(data):
        active = data.get("active", [])
        new_active = []
        for entry in active:
            entry_ids = active_items(entry)
            # Remove any of the IDs being deleted.
            remaining = [i for i in entry_ids if i not in raw_ids]
            if remaining:
                entry = dict(entry)
                entry["items"] = remaining
                new_active.append(entry)
            # else: drop the entry entirely.
        data["active"] = new_active

    from hvlib import update_json
    update_json(STATUS_PATH, {"active": []}, mutator)

# ── apply summary ─────────────────────────────────────────────────────────────

for iid in raw_ids:
    plan = plans[iid]
    info = plan["info"]
    xrefs_todo = plan["xrefs_todo"]
    xrefs_archive = plan["xrefs_archive"]
    detail_path = plan["detail_path"]
    plan_files = plan["plan_files"]
    status_strip = plan["status_strip"]
    source = info["source"]

    parts = ["TODO entry"]

    total_xrefs = len(xrefs_todo) + len(xrefs_archive)
    if total_xrefs == 1:
        parts.append("1 cross-reference")
    elif total_xrefs > 1:
        parts.append(f"{total_xrefs} cross-references")

    if detail_path:
        parts.append("detail file")

    if len(plan_files) == 1:
        parts.append("1 plan file")
    elif len(plan_files) > 1:
        parts.append(f"{len(plan_files)} plan files")

    if source == "archive" and scrub_archive:
        parts.append("ARCHIVE entry")

    if status_strip:
        parts.append("status.json strip")

    print(f"[{iid}] removed: {', '.join(parts)}")

PY

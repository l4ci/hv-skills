#!/usr/bin/env bash
# Register a "hit" for a KNOWLEDGE.md bullet — increments the hit counter
# and auto-promotes provisional → confirmed when hits reach the threshold
# (config: learn.promoteThreshold, default 3). Skips auto-promotion if the
# bullet has a pending contradiction. Called by /hv-work and /hv-review
# after consuming a queried bullet.
# Writer helper: exit 0 on success; exit 1 on argv error.
# Usage: hv-knowledge-hit --topic <T> --title <S>
#
# Inlines the read-modify-write of .hv/knowledge-tier.json — the sidecar
# schema lives in hv-knowledge-tier; keep the invariants in lockstep:
#   {version: 1, entries: {"<topic>::<title>": {tier, hits, lastSeen}}}
set -euo pipefail
. "$(dirname "${BASH_SOURCE[0]}")/hv-preamble.sh"

USAGE="usage: hv-knowledge-hit --topic <T> --title <S>"

TOPIC=""
TITLE=""

while [[ $# -gt 0 ]]; do
  case "$1" in
    --topic)
      TOPIC="${2:?$USAGE}"
      shift 2
      ;;
    --title)
      TITLE="${2:?$USAGE}"
      shift 2
      ;;
    --help|-h)
      echo "$USAGE" >&2
      exit 0
      ;;
    *)
      echo "error: unknown argument: $1" >&2
      echo "$USAGE" >&2
      exit 1
      ;;
  esac
done

if [[ -z "$TOPIC" || -z "$TITLE" ]]; then
  echo "error: --topic and --title are required" >&2
  echo "$USAGE" >&2
  exit 1
fi

# Glossary terms aren't tier-eligible (canonical names, not probationary
# observations) — mirror the canonical skip from hv-knowledge-tier.
if [[ "$TOPIC" == "Glossary" ]]; then
  exit 0
fi

export _HV_KH_TOPIC="$TOPIC"
export _HV_KH_TITLE="$TITLE"
export HV_BIN="$HERE"

PYTHONPATH="$HERE${PYTHONPATH:+:$PYTHONPATH}" python3 - <<'PY'
import os
import subprocess
import sys
from datetime import date
from pathlib import Path
from hvlib import load_sidecar, dump_json_atomic, load_config

SIDECAR        = Path(".hv/knowledge-tier.json")
DEFAULT_THRESHOLD = 3

topic = os.environ["_HV_KH_TOPIC"]
title = os.environ["_HV_KH_TITLE"]
today = date.today().isoformat()
key   = f"{topic}::{title}"

cfg = load_config()
val = cfg.get("learn", {}).get("promoteThreshold")
threshold = val if isinstance(val, int) and val > 0 else DEFAULT_THRESHOLD

try:
    data = load_sidecar(SIDECAR, schema_version=1, default={"version": 1, "entries": {}})
except ValueError as e:
    print(f"error: {e}", file=sys.stderr)
    sys.exit(1)

entries = data["entries"]
if key in entries:
    entries[key]["hits"] += 1
    entries[key]["lastSeen"] = today
else:
    entries[key] = {"tier": "provisional", "hits": 1, "lastSeen": today}

state = entries[key]
auto_promoted = False

if state["tier"] == "provisional" and state["hits"] >= threshold:
    bin_dir = os.environ["HV_BIN"]
    result = subprocess.run(
        [f"{bin_dir}/hv-knowledge-contradiction", "--has", "--topic", topic, "--title", title],
        check=False,
        capture_output=True,
        text=True,
    )
    if result.returncode == 0:
        has_contradiction = True
    elif result.returncode == 1:
        has_contradiction = False
    else:
        sys.stderr.write(result.stderr)
        sys.exit(result.returncode)
    if has_contradiction:
        print(
            f"skip-auto-promote: {topic} :: {title} has pending contradiction",
            file=sys.stderr,
        )
    else:
        state["tier"] = "confirmed"
        auto_promoted = True

dump_json_atomic(SIDECAR, data)

if auto_promoted:
    print(
        f"auto-promoted: {topic} :: {title} (hits={state['hits']}, threshold={threshold})",
        file=sys.stderr,
    )
PY

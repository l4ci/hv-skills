#!/usr/bin/env bash
# Release gate for a milestone (issue mode): lists the open issues in its native milestone. An issue
# carrying in-progress / needs-review / changes-requested (the configured label names) blocks the
# release; any other open issue is a warning. The milestone's tracking issue is never listed.
# Prints `blocked: #<n> <title> [<label>]` and `warning: #<n> <title> (still open)`, one per issue,
# lowest number first; nothing when clear.
# Reader helper: exit 0 clear (warnings allowed); exit 6 blocked; exit 1 on usage error or unknown
#   milestone; exit 2 file backend (issue mode only); exit 3 tracker unavailable; exit 4 rate-limited.
# Usage: hv-release-milestone-check <MNN>
set -euo pipefail
. "$(dirname "${BASH_SOURCE[0]}")/hv-preamble.sh"
[ $# -eq 1 ] || { echo "usage: hv-release-milestone-check <MNN>" >&2; exit 1; }
PYTHONPATH="$HERE${PYTHONPATH:+:$PYTHONPATH}" python3 - "$1" <<'PY'
import sys
from hvlib import get_backend, IssueBackend, TrackerError, tracker_exit_code

def die(msg, code=1):
    sys.stderr.write(f"error: hv-release-milestone-check: {msg}\n"); sys.exit(code)

try:
    backend = get_backend()
    if not isinstance(backend, IssueBackend):
        die("issue mode only (backlog.backend is \"file\")", 2)
    blocked, warn = backend.release_gate(sys.argv[1])
except TrackerError as e:
    die(e.message, tracker_exit_code(e))
except (LookupError, ValueError) as e:
    die(e.args[0])
for i, label in blocked:
    print(f"blocked: #{i['number']} {i['title']} [{label}]")
for i in warn:
    print(f"warning: #{i['number']} {i['title']} (still open)")
sys.exit(6 if blocked else 0)
PY

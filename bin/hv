#!/bin/sh
# hv launcher: the plugin's bin/hv. Finds the hv binary for this plugin
# version, fetching it once, then execs it with all arguments.
#
# Order:
#   1. $HV_BINARY, when set.
#   2. Dev checkout (a git work tree not sitting on tag v<version>) with go
#      on PATH: go build into the cache, rebuilt when any Go source is newer.
#   3. Release binary for the version in .claude-plugin/plugin.json, cached
#      under ${HV_CACHE_DIR:-${XDG_CACHE_HOME:-~/.cache}/hv}/<version>/hv.
#      First use downloads hv_<os>_<arch> and checksums.txt from the GitHub
#      release and refuses a binary whose sha256 does not match.
#
# Not a helper: it does not source hv-preamble.sh, because it must run
# outside any .hv/ project (hv init, hv version) and must not change the
# working directory the binary sees. Failures exit 5 (unavailable), per
# docs/design/5.0-cli-conventions.md.
#
# Env: HV_BINARY, HV_CACHE_DIR, HV_LAUNCHER_MODE=dev|release (skip detection),
#      HV_RELEASE_BASE_URL (default https://github.com/l4ci/hv-skills/releases/download).
set -eu

die() {
  printf 'hv: %s\n' "$1" >&2
  case $hv_args in
    *" --json "*)
      msg=$(printf '%s' "$1" | sed 's/[\\"]/\\&/g')
      printf '{"ok": false, "error": {"code": "unavailable", "exit": 5, "message": "%s"}}\n' "$msg" ;;
  esac
  exit 5
}
hv_args=" $* "

if [ -n "${HV_BINARY:-}" ]; then exec "$HV_BINARY" "$@"; fi

# Plugin root: follow symlinks to the real bin/hv (stow installs link it).
self=$0
while [ -L "$self" ]; do
  link=$(readlink "$self")
  case $link in /*) self=$link ;; *) self=$(dirname "$self")/$link ;; esac
done
root=$(cd "$(dirname "$self")/.." && pwd)

version=$(sed -n 's/^[[:space:]]*"version":[[:space:]]*"\([^"]*\)".*/\1/p' "$root/.claude-plugin/plugin.json" | head -n 1)
[ -n "$version" ] || die "cannot read version from $root/.claude-plugin/plugin.json"
cache=${HV_CACHE_DIR:-${XDG_CACHE_HOME:-$HOME/.cache}/hv}

mode=${HV_LAUNCHER_MODE:-}
if [ -z "$mode" ]; then
  mode=release
  if [ -f "$root/go.mod" ] && git -C "$root" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    if [ "$(git -C "$root" describe --tags --exact-match 2>/dev/null || true)" != "v$version" ]; then
      mode=dev
    fi
  fi
fi

if [ "$mode" = dev ]; then
  if command -v go >/dev/null 2>&1; then
    # One build per checkout: key the cache dir on the checkout path.
    key=$(printf '%s' "$root" | cksum | cut -d' ' -f1)
    bin=$cache/dev-$key/hv
    if [ ! -x "$bin" ] || [ -n "$(find "$root/go.mod" "$root/cmd" "$root/internal" -newer "$bin" 2>/dev/null | head -n 1)" ]; then
      mkdir -p "$(dirname "$bin")" || die "cannot create $(dirname "$bin")"
      commit=$(git -C "$root" rev-parse --short HEAD 2>/dev/null || true)
      pkg=github.com/l4ci/hv-skills/v5/internal/version
      (cd "$root" && go build -o "$bin.tmp" \
        -ldflags "-X $pkg.Version=$version-dev -X $pkg.Commit=$commit" ./cmd/hv) >&2 ||
        die "go build failed in $root"
      mv -f "$bin.tmp" "$bin"
    fi
    exec "$bin" "$@"
  fi
  printf 'hv: warning: dev checkout without go; using the v%s release binary\n' "$version" >&2
fi

bin=$cache/$version/hv
if [ ! -x "$bin" ]; then
  case $(uname -s) in Linux) os=linux ;; Darwin) os=darwin ;; *) die "unsupported OS $(uname -s)" ;; esac
  case $(uname -m) in x86_64 | amd64) arch=amd64 ;; aarch64 | arm64) arch=arm64 ;; *) die "unsupported CPU $(uname -m)" ;; esac
  asset=hv_${os}_${arch}
  base=${HV_RELEASE_BASE_URL:-https://github.com/l4ci/hv-skills/releases/download}/v$version
  dir=$(dirname "$bin")
  mkdir -p "$dir" || die "cannot create $dir"
  tmp=$(mktemp "$dir/.dl.XXXXXX") || die "cannot write to $dir"
  sums=$tmp.sums
  trap 'rm -f "$tmp" "$sums"' EXIT
  fetch() {
    if command -v curl >/dev/null 2>&1; then curl -fsSL -o "$2" "$1"
    elif command -v wget >/dev/null 2>&1; then wget -q -O "$2" "$1"
    else die "need curl or wget to download hv v$version"
    fi
  }
  printf 'hv: downloading %s v%s\n' "$asset" "$version" >&2
  fetch "$base/$asset" "$tmp" || die "download failed: $base/$asset"
  fetch "$base/checksums.txt" "$sums" || die "download failed: $base/checksums.txt"
  want=$(awk -v a="$asset" '$2 == a || $2 == "*" a { print $1 }' "$sums")
  [ -n "$want" ] || die "checksums.txt has no entry for $asset"
  if command -v sha256sum >/dev/null 2>&1; then got=$(sha256sum "$tmp" | cut -d' ' -f1)
  else got=$(shasum -a 256 "$tmp" | cut -d' ' -f1)
  fi
  [ "$got" = "$want" ] || die "checksum mismatch for $asset (want $want, got $got)"
  chmod 755 "$tmp"
  mv -f "$tmp" "$bin"
  rm -f "$sums"
  trap - EXIT
fi
exec "$bin" "$@"

#!/usr/bin/env bash
# Exit 0 if git working tree is clean, 1 if dirty, 2 if not a git repo.
# Validator helper: exits 0 when working tree is clean; exits 1 if dirty; exits 2 if not a git repo.
# Umbrella-aware: when invoked from an umbrella root (no local repo, but a
# `.hv/` with `umbrella.enabled: true` and a `repos.json`), walks every
# registered sub-repo and reports any that are dirty or missing.
# Usage: hv-guard-clean [context]   # context is printed in the warning
set -euo pipefail
CTX="${1:-this command}"

if git rev-parse --git-dir >/dev/null 2>&1; then
  if [ -n "$(git status --porcelain)" ]; then
    if ! git rev-parse --verify HEAD >/dev/null 2>&1; then
      echo "error: uncommitted changes on a fresh repo (no commits yet) — make a baseline commit before running $CTX:" >&2
      echo "  git add -A && git commit -m \"chore: import initial files\"" >&2
      echo "then re-run." >&2
    else
      echo "error: uncommitted changes — stash (\`git stash\`) or commit before running $CTX" >&2
    fi
    exit 1
  fi
  exit 0
fi

BIN_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
HV_DIR="$(pwd -P)/.hv"
if [ ! -d "$HV_DIR" ]; then
  echo "error: not a git repository — $CTX requires git" >&2
  exit 2
fi

UMBRELLA_ON="$("$BIN_DIR/hv-umbrella-on")"
if [ "$UMBRELLA_ON" != "yes" ]; then
  echo "error: not a git repository — $CTX requires git" >&2
  exit 2
fi

REPOS_JSON="$HV_DIR/repos.json"
if [ ! -f "$REPOS_JSON" ]; then
  echo "error: umbrella mode is on but $REPOS_JSON is missing — run /hv-init from the umbrella root" >&2
  exit 2
fi

DIRTY="$(python3 - "$REPOS_JSON" <<'PY'
import json, subprocess, sys
from pathlib import Path
# Intentionally no try/except: corrupt repos.json should crash loudly here
# so the user is forced to fix it before any work cycle proceeds.
data = json.loads(Path(sys.argv[1]).read_text())
dirty = []
for entry in data.get("repos", []) or []:
    name = entry.get("name", "")
    rel = entry.get("path", "")
    if not name or not rel:
        continue
    try:
        out = subprocess.check_output(
            ["git", "-C", rel, "status", "--porcelain"],
            stderr=subprocess.DEVNULL,
        ).decode()
    except (subprocess.CalledProcessError, FileNotFoundError):
        dirty.append(f"{name} (not a git repo at {rel})")
        continue
    if out.strip():
        dirty.append(name)
print("\n".join(dirty))
PY
)"

if [ -n "$DIRTY" ]; then
  echo "error: uncommitted changes in sub-repo(s) — stash or commit before running $CTX:" >&2
  echo "$DIRTY" | sed 's/^/  /' >&2
  exit 1
fi
exit 0

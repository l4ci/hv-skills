#!/usr/bin/env bash
# Take an item so two agents never work it at once (issue mode).
# Posts a `<!-- hv:claim <claim-id> -->` comment, re-reads the comments, and the earliest claim without
# a later `<!-- hv:release <id> -->` wins. The winner gets the in-progress label (needs-review and
# changes-requested are removed) and is assigned; a loser posts its release marker, changes no labels,
# prints `error: hv-item-claim: <ID> is claimed by <other>` and exits 5. Claiming an item this claim-id
# already holds posts nothing. File backend: silent no-op (status.json is the file-mode lock).
# Prints `claimed <ID> as <claim-id>` on success (issue mode only).
# Writer helper: exit 0 claimed or file-mode no-op; exit 1 on usage error, unknown or closed item or
#   tracker failure; exit 2 backend unavailable; exit 3 tracker unavailable; exit 5 claimed by another;
#   exit 4 rate-limited.
# Usage: hv-item-claim <ref> --as <claim-id>
set -euo pipefail
. "$(dirname "${BASH_SOURCE[0]}")/hv-preamble.sh"
USAGE="usage: hv-item-claim <ref> --as <claim-id>"
REF="${1:?$USAGE}"
shift
AS=""
while [ $# -gt 0 ]; do
  case "$1" in
    --as) AS="${2:?$USAGE}"; shift 2 ;;
    *) echo "$USAGE" >&2; exit 1 ;;
  esac
done
case "$AS" in ""|*[[:space:]]*|*"-->"*) echo "$USAGE" >&2; exit 1 ;; esac
PYTHONPATH="$HERE${PYTHONPATH:+:$PYTHONPATH}" python3 - "$REF" "$AS" <<'PY'
import sys
from hvlib import get_backend, BackendUnavailable, TrackerError, tracker_exit_code

ref, claim_id = sys.argv[1:3]

def die(msg, code=1):
    sys.stderr.write(f"error: hv-item-claim: {msg}\n"); sys.exit(code)

try:
    backend = get_backend()
    won, holder = backend.claim(ref, claim_id)
    if backend.backlog_name != "BACKLOG.md":
        item = backend.canonical_id(ref) or ref
        if not won:
            die(f"{item} is claimed by {holder}", 5)
        print(f"claimed {item} as {claim_id}")
except BackendUnavailable as e:
    die(str(e), 2)
except TrackerError as e:
    die(e.message, tracker_exit_code(e))
except (LookupError, ValueError) as e:
    die(e.args[0])
PY

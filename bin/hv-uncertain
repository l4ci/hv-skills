#!/usr/bin/env bash
# Determine whether an item warrants /hv-assume before /hv-plan in loop mode.
# Resolve helper (tri-state): exits 0 when item is uncertain (peek warranted); exits 1 when certain; exits 2 on item-not-found error.
# Exit 0: uncertain (peek warranted), with reason(s) on stdout, one per line.
# Exit 1: certain (proceed direct to /hv-plan), no stdout.
# Exit 2: error (item not found, BACKLOG.md missing).
# Usage: hv-uncertain <itemId>
set -euo pipefail
. "$(dirname "${BASH_SOURCE[0]}")/hv-preamble.sh"
. "$HERE/hv-types.sh"
ITEM_ID="${1:?usage: hv-uncertain <itemId>}"
PYTHONPATH="$HERE${PYTHONPATH:+:$PYTHONPATH}" python3 - "$ITEM_ID" <<'PY'
import re
import sys
from pathlib import Path
import os
from hvlib import (parse_todo_fields, find_open_bullet, parse_open_bullet, get_backend,
                   BackendUnavailable, TrackerError, tracker_exit_code)

iid = sys.argv[1]
try:
    backend = get_backend()
    content = backend.backlog_markdown()
    if content is not None:
        iid = backend.canonical_id(iid) or iid
except BackendUnavailable as e:
    sys.stderr.write(f"error: hv-uncertain: {e}\n"); sys.exit(2)
except ValueError as e:
    sys.stderr.write(f"error: hv-uncertain: {e}\n"); sys.exit(1)
except TrackerError as e:
    sys.stderr.write(f"error: hv-uncertain: {e.message}\n"); sys.exit(tracker_exit_code(e))
if content is None:
    print("error: .hv/BACKLOG.md not found", file=sys.stderr)
    raise SystemExit(2)

sections_env = os.environ.get("HV_OPEN_SECTIONS", "Bugs|Features|Tasks").split("|")
sections_env = [s.strip() for s in sections_env if s.strip()]
found_line = find_open_bullet(content, iid, sections_env)

if found_line is None:
    print(f"error: item {iid} not found in BACKLOG.md", file=sys.stderr)
    raise SystemExit(2)

fields = parse_todo_fields(found_line)
# Size lives in the bracketed tag on the bullet, not in the trailing fields.
parsed = parse_open_bullet(found_line)
tag = parsed["tag"] if parsed else ""
if tag.lower() != "major":
    raise SystemExit(1)

# Detail text: the detail file (file backend) or the issue body (issues backend).
# Unreadable/absent counts as missing for gate (a).
try:
    detail = backend.detail_text(iid)
except TrackerError as e:
    sys.stderr.write(f"error: hv-uncertain: {e.message}\n"); sys.exit(tracker_exit_code(e))
body_text = found_line
detail_exists = detail is not None
if detail_exists:
    body_text = body_text + "\n" + detail

reasons = []

# Gate (a): no detail file.
if not detail_exists:
    reasons.append("no detail file")

# Gate (b): multiple open-question signals.
qmark_count = body_text.count("?")
markers = [
    r"\bTBD\b",
    r"\bunclear\b",
    r"\bunsure\b",
    r"\bopen question(s)?\b",
    r"\bheuristic TBD\b",
]
marker_hit = any(re.search(p, body_text, re.IGNORECASE) for p in markers)
if qmark_count >= 2 or marker_hit:
    reasons.append("multiple open-question signals")

# Gate (c): no backtick-delimited code spans.
if not re.search(r"`[^`]+`", body_text):
    reasons.append("no concrete identifiers (unknown surface)")

if reasons:
    for r in reasons:
        print(r)
    raise SystemExit(0)

raise SystemExit(1)
PY

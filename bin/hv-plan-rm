#!/usr/bin/env bash
# Remove a plan file.
# Writer helper: exit 0 on successful removal; exit 1 when plan key not found.
# Usage: hv-plan-rm <key>     (e.g. hv-plan-rm M01-S01)
set -euo pipefail
. "$(dirname "${BASH_SOURCE[0]}")/hv-preamble.sh"
. "$HERE/hv-artifact-rm.sh"
KEY="${1:?usage: hv-plan-rm <key>}"
# Issue mode: an item plan (<M>-<ID>) is a note on the item's issue (the milestone part is ignored);
# a slice plan (<M>-S<NN>) is a plan:S<NN> note on the milestone's tracking issue.
if PYTHONPATH="$HERE${PYTHONPATH:+:$PYTHONPATH}" python3 -m hvlib_backend is-issues; then
  RC=0
PYTHONPATH="$HERE${PYTHONPATH:+:$PYTHONPATH}" python3 - "$KEY" <<'PY' || RC=$?
import sys
from hvlib import get_backend, BackendUnavailable, TrackerError, tracker_exit_code

ref = sys.argv[1]
import re
m = re.fullmatch(r"M\d{2,}-([A-Z]\d+)", ref)
if not m:
    sys.exit(64)  # odd key: file behaviour
item = m.group(1)
try:
    backend = get_backend()
    # A slice plan (<M>-S<NN>) is a plan:S<NN> note on the milestone's tracking issue.
    gone = backend.slice_rm(ref.split("-")[0], item) if item.startswith("S") else backend.note_rm(item, "plan")
    if not gone:
        print("error: plan note for %s not found" % ref, file=sys.stderr); sys.exit(1)
except BackendUnavailable as e:
    print(f"error: hv-plan-rm: {e}", file=sys.stderr); sys.exit(2)
except TrackerError as e:
    print(f"error: hv-plan-rm: {e.message}", file=sys.stderr); sys.exit(tracker_exit_code(e))
except LookupError as e:
    print(f"error: hv-plan-rm: {e.args[0]}", file=sys.stderr); sys.exit(1)
PY
  [ "$RC" -eq 64 ] || exit "$RC"
fi
hv_artifact_rm plan "$KEY" .hv/plans

#!/usr/bin/env bash
# Remove a plan file.
# Usage: hv-plan-rm <key>     (e.g. hv-plan-rm M01-S01)
set -euo pipefail
HERE="$(cd "$(dirname "$0")" && pwd)"
. "$HERE/hv-self-locate.sh"
hv_self_locate
KEY="${1:?usage: hv-plan-rm <key>}"
PLAN=".hv/plans/${KEY}.md"
if [ ! -f "$PLAN" ]; then
  echo "error: $PLAN not found" >&2
  exit 1
fi
rm "$PLAN"

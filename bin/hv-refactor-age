#!/usr/bin/env bash
# Print features/bugs completed since the last `refactor:` commit.
# Lookup helper: always exits 0; reads counters.json.
# Reads .hv/counters.json — the field is maintained imperatively by
# hv-complete (increments on non-refactor completions) and zeroed by
# hv-refactor-reset at the end of a /hv-refactor cycle.
# Usage: hv-refactor-age
# Prints JSON: {"features": N, "bugs": M}
set -euo pipefail
. "$(dirname "${BASH_SOURCE[0]}")/hv-preamble.sh"
PYTHONPATH="$HERE${PYTHONPATH:+:$PYTHONPATH}" python3 - <<'PY'
import json
from hvlib import load_json
sr = load_json(".hv/counters.json", {}).get("since_refactor", {"features": 0, "bugs": 0})
print(json.dumps({"features": sr.get("features", 0), "bugs": sr.get("bugs", 0)}, indent=2))
PY

#!/usr/bin/env bash
# Run Codex headlessly against a worktree with a brief; return a structured verdict.
# Verifier helper: used by /hv-ship Step 3.5 (ship.secondOpinionRunner: codex) and by
# /hv-qa strategies as a `codex-verify` runner. Strategy is data, runners are commands.
#
# Usage: hv-codex-verify --worktree <path> --brief <file> [--schema <file>]
#                        [--sandbox read-only|workspace-write|danger-full-access]
#                        [--timeout <s>] | --doctor
#   --sandbox  omitted by default: Codex's own configured sandbox applies.
#   --schema   JSON Schema for the final message; default is a built-in
#              {verdict, summary, findings[], next_steps} schema
#              (additionalProperties:false, every property required).
#   --doctor   probe `codex --version`, `codex login status` and a trivial
#              read-only exec; print the bwrap diagnosis and host fix when broken.
#
# stdout: progress lines, artifact path, and the verdict as the LAST line:
#   PASS | FAIL | ERROR  (doctor: PASS | ERROR). exit 0 / 1 / 2 respectively.
# Artifacts (gitignored): .hv/qa-runs/<ts>/codex/{brief.md,events.jsonl,stderr.txt,last.json}
#
# ERROR, never FAIL, on: non-zero codex exit or timeout; last.json missing, unparsable
# or off-schema; no turn.completed event; bwrap text in stderr or in error / failed-command
# events (a sandbox that cannot start yields a bogus FAIL otherwise); worktree dirty
# after the run (`git status --porcelain` before and after must be identical, whatever
# the sandbox mode). Read-only grounding is requested in the prompt, enforced by the guard.
set -euo pipefail
. "$(dirname "${BASH_SOURCE[0]}")/hv-preamble.sh"

USAGE="usage: hv-codex-verify --worktree <path> --brief <file> [--schema <file>] [--sandbox read-only|workspace-write|danger-full-access] [--timeout <s>] | --doctor"
WORKTREE="" BRIEF="" SCHEMA="" SANDBOX="" TIMEOUT=900 DOCTOR=0
while [ $# -gt 0 ]; do
  case "$1" in
    --worktree) WORKTREE="${2:?$USAGE}"; shift 2 ;;
    --brief)    BRIEF="${2:?$USAGE}"; shift 2 ;;
    --schema)   SCHEMA="${2:?$USAGE}"; shift 2 ;;
    --sandbox)  SANDBOX="${2:?$USAGE}"; shift 2 ;;
    --timeout)  TIMEOUT="${2:?$USAGE}"; shift 2 ;;
    --doctor)   DOCTOR=1; shift ;;
    *) echo "$USAGE" >&2; exit 2 ;;
  esac
done

# preamble cds to the project root; resolve caller-relative paths against the original cwd
abs() { case "$1" in /*) printf '%s\n' "$1" ;; *) printf '%s/%s\n' "${HV_ORIG_PWD:-$PWD}" "$1" ;; esac; }

die() { echo "ERROR: $*"; echo "ERROR"; exit 2; }

BWRAP_FIX="bwrap diagnosis: Codex's read-only/workspace-write sandbox cannot start (Ubuntu 24.04 apparmor_restrict_unprivileged_userns=1, no bubblewrap profile).
host fix (needs sudo): install bubblewrap plus an AppArmor profile for it, or
  sudo sysctl kernel.apparmor_restrict_unprivileged_userns=0
until then pass --sandbox danger-full-access inside a disposable worktree (the dirty-tree guard still applies)."

with_timeout() { # <seconds> cmd...
  local s="$1"; shift
  if command -v timeout >/dev/null 2>&1; then timeout "$s" "$@"; else "$@"; fi
}

if [ "$DOCTOR" = 1 ]; then
  command -v codex >/dev/null 2>&1 || die "codex not on PATH"
  echo "codex: $(codex --version 2>&1 | head -1)"
  if with_timeout 30 codex login status >/dev/null 2>&1; then echo "login: ok"; else die "codex login status failed (run: codex login)"; fi
  PROBE="$(mktemp -d)"; trap 'rm -rf "$PROBE"' EXIT
  rc=0
  with_timeout 120 codex exec -s read-only -C "$PROBE" --skip-git-repo-check --ephemeral --color never \
    "Run the shell command: echo hv-probe-ok. Reply with one word." >"$PROBE/out" 2>&1 || rc=$?
  if grep -qi bwrap "$PROBE/out"; then echo "$BWRAP_FIX"; die "read-only sandbox broken"; fi
  [ "$rc" -eq 0 ] || die "read-only probe exited $rc"
  echo "sandbox: read-only probe ok"
  echo PASS; exit 0
fi

[ -n "$WORKTREE" ] && [ -n "$BRIEF" ] || { echo "$USAGE" >&2; exit 2; }
command -v codex >/dev/null 2>&1 || die "codex not on PATH"
WORKTREE="$(cd "$(abs "$WORKTREE")" 2>/dev/null && pwd -P)" || die "worktree not found"
BRIEF="$(abs "$BRIEF")"; [ -f "$BRIEF" ] || die "brief not found: $BRIEF"
git -C "$WORKTREE" rev-parse --git-dir >/dev/null 2>&1 || die "worktree is not a git repo: $WORKTREE"
case "$SANDBOX" in ""|read-only|workspace-write|danger-full-access) ;; *) die "bad --sandbox: $SANDBOX" ;; esac
case "$TIMEOUT" in ''|*[!0-9]*) die "bad --timeout: $TIMEOUT" ;; esac

OUT="$PWD/.hv/qa-runs/$(date -u +%Y%m%dT%H%M%SZ)-$$/codex"
mkdir -p "$OUT"

if [ -n "$SCHEMA" ]; then
  SCHEMA="$(abs "$SCHEMA")"; [ -f "$SCHEMA" ] || die "schema not found: $SCHEMA"
else
  SCHEMA="$OUT/schema.json"
  cat > "$SCHEMA" <<'JSON'
{
  "type": "object",
  "additionalProperties": false,
  "required": ["verdict", "summary", "findings", "next_steps"],
  "properties": {
    "verdict": {"type": "string", "enum": ["PASS", "FAIL"]},
    "summary": {"type": "string"},
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["severity", "file", "line", "title", "body"],
        "properties": {
          "severity": {"type": "string", "enum": ["critical", "high", "medium", "low"]},
          "file": {"type": "string"},
          "line": {"type": "integer"},
          "title": {"type": "string"},
          "body": {"type": "string"}
        }
      }
    },
    "next_steps": {"type": "array", "items": {"type": "string"}}
  }
}
JSON
fi

{
  echo "<task>"; cat "$BRIEF"; echo "</task>"
  echo "<structured_output_contract>"
  echo "Return only JSON matching the supplied output schema. verdict is PASS only when you found no defect worth blocking on; otherwise FAIL with one finding per defect (file and line where known, line 0 otherwise)."
  echo "</structured_output_contract>"
  echo "<grounding_rules>"
  echo "Do not modify files. Verify claims by running read-only commands and reading the code; do not guess. Report only what you checked."
  echo "</grounding_rules>"
} > "$OUT/brief.md"

# .hv/qa-runs is ours; everything else must be byte-identical before and after
porcelain() { git -C "$WORKTREE" status --porcelain -- . ':(exclude).hv/qa-runs' 2>/dev/null || true; }
BEFORE="$(porcelain)"

SB=(); [ -n "$SANDBOX" ] && SB=(-s "$SANDBOX")
echo "codex-verify: running (worktree=$WORKTREE sandbox=${SANDBOX:-default} timeout=${TIMEOUT}s)"
rc=0
( cd "$WORKTREE" && with_timeout "$TIMEOUT" codex exec ${SB[@]+"${SB[@]}"} -C "$WORKTREE" --ephemeral --color never \
    --output-schema "$SCHEMA" -o "$OUT/last.json" --json - \
    < "$OUT/brief.md" > "$OUT/events.jsonl" 2> "$OUT/stderr.txt" ) || rc=$?
AFTER="$(porcelain)"
echo "artifacts: $OUT"

# Python classifier: prints "<VERDICT>\t<reason>" on one line
RESULT="$(python3 - "$OUT" "$rc" "$([ "$BEFORE" = "$AFTER" ] && echo same || echo changed)" <<'PY'
import json, sys
from pathlib import Path
out, rc, tree = Path(sys.argv[1]), int(sys.argv[2]), sys.argv[3]
def done(v, why): print(f"{v}\t{why}"); raise SystemExit
stderr = (out / "stderr.txt").read_text(errors="replace") if (out / "stderr.txt").exists() else ""
completed, bwrap = False, "bwrap" in stderr.lower()
ev = out / "events.jsonl"
for line in (ev.read_text(errors="replace").splitlines() if ev.exists() else []):
    try: e = json.loads(line)
    except ValueError: continue
    t = e.get("type", "")
    if t == "turn.completed": completed = True
    # sandbox failures surface as error events or failed commands; plain item text
    # (file contents, agent prose) may legitimately mention bwrap, so it is not scanned
    item = e.get("item") or {}
    failed_cmd = item.get("type") == "command_execution" and item.get("exit_code") not in (0, None)
    if ("bwrap" in line.lower()) and (t in ("error", "turn.failed") or failed_cmd):
        bwrap = True
if bwrap: done("ERROR", "bwrap sandbox failure (run: hv-codex-verify --doctor)")
if rc == 124: done("ERROR", "codex timed out")
if rc != 0: done("ERROR", f"codex exited {rc}")
if not completed: done("ERROR", "no turn.completed event")
if tree != "same": done("ERROR", "worktree changed during the run (dirty-tree guard)")
try: d = json.loads((out / "last.json").read_text())
except (OSError, ValueError): done("ERROR", "last.json missing or unparsable")
if not isinstance(d, dict) or d.get("verdict") not in ("PASS", "FAIL"):
    done("ERROR", "last.json has no PASS/FAIL verdict")
done(d["verdict"], str(d.get("summary", "")).replace("\n", " ")[:300])
PY
)"
VERDICT="${RESULT%%$'\t'*}"; REASON="${RESULT#*$'\t'}"
echo "$REASON"
echo "$VERDICT"
case "$VERDICT" in PASS) exit 0 ;; FAIL) exit 1 ;; *) exit 2 ;; esac

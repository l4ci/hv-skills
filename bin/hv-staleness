#!/usr/bin/env bash
# List stale entries across MAP / KNOWLEDGE / TODO based on a days threshold.
# Lookup helper: exits 0 always for valid args; exits 1 only on unrecognized arguments (usage error).
# Usage: hv-staleness <kind> [--days N] [--today YYYY-MM-DD]
#   kind:    map | knowledge | todo
#   --days:  threshold; entries that are N or more days old are listed (default 90)
#   --today: override today (test hook); defaults to today's date
#   stdout:  one line per stale entry: "<name> <YYYY-MM-DD>"
#   exit:    0 always
set -euo pipefail
KIND="${1:?usage: hv-staleness <kind> [--days N] [--today YYYY-MM-DD]}"
shift
DAYS=90
TODAY=""
while [ $# -gt 0 ]; do
  case "$1" in
    --days) DAYS="$2"; shift 2 ;;
    --today) TODAY="$2"; shift 2 ;;
    *) echo "unknown arg: $1" >&2; exit 1 ;;
  esac
done
HERE="$(cd "$(dirname "$0")" && pwd)"
. "$HERE/hv-self-locate.sh"
hv_self_locate

PYTHONPATH="$HERE${PYTHONPATH:+:$PYTHONPATH}" python3 - "$KIND" "$DAYS" "$TODAY" <<'PY'
import datetime as dt
import sys
from pathlib import Path
from hvlib import iter_map_entries, iter_topics, git_mtime, iter_open_sections, parse_todo_fields, open_bullet_re

kind, days_s, today_s = sys.argv[1], sys.argv[2], sys.argv[3]
days = int(days_s)
today = dt.date.fromisoformat(today_s) if today_s else dt.date.today()


def parse_date(s: str) -> dt.date | None:
    try:
        return dt.date.fromisoformat(s.strip())
    except (ValueError, AttributeError):
        return None


def _git_mtime_date(p: Path) -> dt.date | None:
    s = git_mtime(p)
    return dt.date.fromisoformat(s) if s else None


def is_stale(d: dt.date | None) -> bool:
    if d is None:
        return False
    return (today - d).days >= days


def emit(name: str, d: dt.date | None) -> None:
    print(f"{name} {d.isoformat() if d else 'unknown'}")


if kind == "map":
    for name, fm, _body, path in iter_map_entries(".hv/map"):
        d = parse_date(fm.get("touched", "")) or _git_mtime_date(path)
        if is_stale(d):
            emit(name, d)
elif kind == "knowledge":
    p = Path(".hv/KNOWLEDGE.md")
    if not p.exists():
        sys.exit(0)
    # KNOWLEDGE has no per-topic timestamps yet; fall back to file mtime.
    d = _git_mtime_date(p)
    if is_stale(d):
        for topic, _body in iter_topics(p.read_text()):
            emit(topic, d)
elif kind == "todo":
    p = Path(".hv/TODO.md")
    if not p.exists():
        sys.exit(0)
    # Scan open backlog bullets via the canonical helpers — the prior inline
    # regex assumed `- [ID]` but the real shape is `- **[ID] [Tag] Title.** ...`.
    bullet_re = open_bullet_re()
    for _name, body in iter_open_sections(p.read_text()):
        for line in body.splitlines():
            line = line.strip()
            bm = bullet_re.match(line)
            if not bm:
                continue
            captured = parse_todo_fields(line).get("captured", "")
            if not captured:
                continue
            d = parse_date(captured)
            if is_stale(d):
                emit(bm.group("id"), d)
else:
    print(f"unknown kind: {kind}", file=sys.stderr)
    sys.exit(1)
PY

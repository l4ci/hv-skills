#!/usr/bin/env bash
# List all milestones from .hv/milestones/*.md as JSON.
# Each entry: { id, title, status, depends, ready }.
# `ready` = no dependency is unshipped (true for shipped/active too if deps OK).
# Usage: hv-vision-list
set -euo pipefail
HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
. "$HERE/hv-self-locate.sh"
hv_self_locate
RAW=$("$HERE/hv-fm-list" .hv/milestones id title status depends)
python3 - "$RAW" <<'PY'
import json, re, sys
from pathlib import Path
items = []
for fm in json.loads(sys.argv[1]):
    depends = fm.get("depends") or []
    if isinstance(depends, str):
        depends = re.findall(r"M\d+", depends)
    items.append({
        "id":      fm.get("id") or Path(fm["_path"]).stem,
        "title":   fm.get("title", ""),
        "status":  fm.get("status") or "planned",
        "depends": depends,
        "_path":   fm["_path"],
    })
shipped = {i["id"] for i in items if i["status"] == "shipped"}
for i in items:
    i["ready"] = all(d in shipped for d in i["depends"])
print(json.dumps(
    [{k: v for k, v in i.items() if not k.startswith("_")} for i in items],
    indent=2,
))
PY

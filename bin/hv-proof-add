#!/usr/bin/env bash
# Append one verification-proof row to the `## Proof` section of an item's detail file.
# Proof rows are facts (a check ran, it passed or failed); they are not acceptance —
# hv-complete is the acceptance write and refuses an item with no proof (see hv-proof-show).
# Creates .hv/<kind>/<ID>.md when missing. Idempotent: a row with the same check, result,
# sha and evidence (date ignored) is a silent no-op. Writes under the sidecar lock.
# Writer helper: exit 0 on write or idempotent no-op; exit 1 on usage error or unknown ID.
# Usage: hv-proof-add <ID> --check <name> --result PASS|FAIL --evidence <path-or-text> [--sha <commit>]
# Row format: - <date> · <check> · <PASS|FAIL> · <sha> · <evidence>
set -euo pipefail
. "$(dirname "${BASH_SOURCE[0]}")/hv-preamble.sh"
USAGE="usage: hv-proof-add <ID> --check <name> --result PASS|FAIL --evidence <path-or-text> [--sha <commit>]"
ID="${1:?$USAGE}"; shift
CHECK=""; RESULT=""; EVIDENCE=""; SHA=""
while [ $# -gt 0 ]; do
  [ $# -ge 2 ] || { echo "$USAGE" >&2; exit 1; }
  case "$1" in
    --check) CHECK="$2" ;;
    --result) RESULT="$2" ;;
    --evidence) EVIDENCE="$2" ;;
    --sha) SHA="$2" ;;
    *) echo "$USAGE" >&2; exit 1 ;;
  esac
  shift 2
done
[ -n "$CHECK" ] && [ -n "$EVIDENCE" ] || { echo "$USAGE" >&2; exit 1; }
case "$RESULT" in PASS|FAIL) ;; *) echo "error: --result must be PASS or FAIL" >&2; echo "$USAGE" >&2; exit 1 ;; esac
[ -n "$SHA" ] || SHA="$(git log -1 --format=%h 2>/dev/null || true)"
[ -n "$SHA" ] || SHA="-"
PYTHONPATH="$HERE${PYTHONPATH:+:$PYTHONPATH}" python3 - "$ID" "$CHECK" "$RESULT" "$SHA" "$EVIDENCE" "$(date +%Y-%m-%d)" <<'PY'
import os, re, sys
from pathlib import Path
from hvlib import find_origin_bullet, load_backlog_corpus, detail_dir_for_id, find_section, append_to_section
from hvlib_io import locked, write_text_atomic

iid, check, result, sha, evidence, date_s = sys.argv[1:7]
one = lambda s: " ".join(s.split())
check, sha, evidence = one(check), one(sha), one(evidence)

kind = detail_dir_for_id(iid)
if not kind:
    print(f"error: [{iid}] has no detail directory (expected B/F/T prefix)", file=sys.stderr)
    sys.exit(1)
found = find_origin_bullet(load_backlog_corpus("."), iid)
if found is None:
    print(f"error: [{iid}] not found in BACKLOG.md or ARCHIVE.md", file=sys.stderr)
    sys.exit(1)
title = found[1] or iid

path = Path(f".hv/{kind}/{iid}.md")
path.parent.mkdir(parents=True, exist_ok=True)
row = f"- {date_s} · {check} · {result} · {sha} · {evidence}"
key = row.split(" · ", 1)[1]  # everything after the date

with locked(path):
    content = path.read_text() if path.exists() else (
        f"# {iid}: {title}\n\n> Related TODO entry: `[{iid}]` in `.hv/BACKLOG.md`\n"
    )
    span = find_section(content, "Proof")
    if span is not None:
        for line in content[span[0]:span[1]].splitlines():
            if line.startswith("- ") and " · " in line and line.split(" · ", 1)[1] == key:
                sys.exit(0)
    write_text_atomic(path, append_to_section(content.rstrip("\n") + "\n", "Proof", row + "\n")
                      if span is not None else content.rstrip("\n") + f"\n\n## Proof\n\n{row}\n")
PY

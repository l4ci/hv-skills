#!/usr/bin/env bash
# Report how many commits and days have elapsed since the last release tag.
# Used by /hv-next and /hv-ship to decide whether to nudge the user toward /hv-release.
# Tool (lookup): exit 0 on all success paths; exit 1 only on broken state.
# Output (single-line JSON on stdout):
#   {"lastTag":"v1.16.0","commits":5,"days":1,"thresholdCommits":10,"thresholdDays":14,"shouldNudge":false,"reason":"","message":""}
# When shouldNudge is true, "message" carries the rendered phrasing the skills
# should print verbatim (plain text, no markdown decoration). When false, empty.
# Exits 0 on all success paths (including "no tag yet"); exits 1 only on broken state.
set -euo pipefail

# Resolve last tag (empty if no tags exist yet).
LAST_TAG="$(git describe --tags --abbrev=0 2>/dev/null || true)"

if [ -z "$LAST_TAG" ]; then
  COMMITS=0
  TAG_TS=0
else
  COMMITS="$(git rev-list "${LAST_TAG}..HEAD" --count)"
  TAG_TS="$(git log -1 --format=%ct "$LAST_TAG")"
fi

HERE="$(cd "$(dirname "$0")" && pwd)"
LAST_TAG="$LAST_TAG" COMMITS="$COMMITS" TAG_TS="$TAG_TS" PYTHONPATH="$HERE${PYTHONPATH:+:$PYTHONPATH}" python3 - <<'PY'
import json
import os
import time
from hvlib import load_config

last_tag = os.environ["LAST_TAG"]
commits = int(os.environ["COMMITS"])
tag_ts = int(os.environ["TAG_TS"])

# No tag → nothing to nudge about.
if not last_tag:
    print(json.dumps({
        "lastTag": "",
        "commits": 0,
        "days": 0,
        "thresholdCommits": 10,
        "thresholdDays": 14,
        "shouldNudge": False,
        "reason": "no-tag",
        "message": "",
    }))
    raise SystemExit(0)

# Read thresholds from .hv/config.json (project-relative); fall back to defaults if
# the file is missing or malformed. Honors .hv/config.local.json overrides.
threshold_commits = 10
threshold_days = 14
cfg = load_config()
rel = cfg.get("release", {})
if isinstance(rel.get("nudgeAfterCommits"), int):
    threshold_commits = rel["nudgeAfterCommits"]
if isinstance(rel.get("nudgeAfterDays"), int):
    threshold_days = rel["nudgeAfterDays"]

now = int(time.time())
days = max(0, (now - tag_ts) // 86400)

should_nudge = False
reason = ""
if commits > 0:
    hit_commits = commits >= threshold_commits
    hit_days = days >= threshold_days
    if hit_commits:
        should_nudge = True
        reason = "commits"
    elif hit_days:
        should_nudge = True
        reason = "days"

# Render the user-facing nudge phrasing once, here, so /hv-next and /hv-ship
# don't reconstruct identical strings independently. Plain text — no markdown
# decoration; skills can wrap/italicize if they want.
if not should_nudge:
    message = ""
elif reason == "commits":
    message = f"{commits} commits since {last_tag}; consider /hv-release."
elif reason == "days":
    message = f"{commits} commits and {int(days)} days since {last_tag}; consider /hv-release."
else:
    message = ""

print(json.dumps({
    "lastTag": last_tag,
    "commits": commits,
    "days": int(days),
    "thresholdCommits": threshold_commits,
    "thresholdDays": threshold_days,
    "shouldNudge": should_nudge,
    "reason": reason,
    "message": message,
}))
PY

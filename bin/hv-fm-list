#!/usr/bin/env bash
# Generic frontmatter-list helper. Glob <dir>/*.md, parse YAML-ish ---...---
# frontmatter, emit a JSON array of {field1, field2, ..., _path}.
# Tool: exit 0 on success, 1 on missing argv; pure read of frontmatter.
# Usage: hv-fm-list <dir> <field1> [<field2> ...]
# Files without frontmatter are skipped. Missing fields → "".
# Values from inline-list frontmatter (`depends: [a, b]`) emit as JSON arrays;
# scalar values stay strings.
set -euo pipefail
HERE="$(cd "$(dirname "$0")" && pwd)"
PYTHONPATH="$HERE${PYTHONPATH:+:$PYTHONPATH}"
DIR="${1:?usage: hv-fm-list <dir> <field1> [<field2> ...]}"
shift
if [ $# -eq 0 ]; then
  echo "usage: hv-fm-list <dir> <field1> [<field2> ...]" >&2
  exit 1
fi
PYTHONPATH="$PYTHONPATH" python3 - "$DIR" "$@" <<'PY'
import json, sys
from pathlib import Path
from hvlib import parse_frontmatter

dir_ = Path(sys.argv[1])
keys = sys.argv[2:]

items = []
if dir_.exists():
    for path in sorted(dir_.glob("*.md")):
        text = path.read_text()
        fm_dict, _body = parse_frontmatter(text)
        if not fm_dict:
            continue
        entry = {}
        for key in keys:
            val = fm_dict.get(key, "")
            entry[key] = val
        entry["_path"] = str(path)
        items.append(entry)

print(json.dumps(items, indent=2))
PY

#!/usr/bin/env bash
# Print matching ## Topic section(s) from .hv/KNOWLEDGE.md with tier-aware
# filtering. Hides `deprecated` bullets by default; suffixes ` (provisional)`
# onto bullets still on probation; emits `confirmed` bullets unchanged.
# Reads tier state from the F03 sidecar at .hv/knowledge-tier.json via
# `hv-knowledge-tier --list`. When the sidecar is missing or empty (older
# project, pre-F03 rollout), all bullets emit unfiltered.
#
# Under umbrella mode, when cwd is inside a registered sub-repo (or --repo
# <name> is given), performs a hybrid read: umbrella KNOWLEDGE.md first, then
# the sub-repo sidecar, each preceded by a `> from: <path>` provenance line.
#
# Lookup helper: always exits 0. A requested topic that matches no '## ' heading prints a warning to stderr (stdout stays empty for it); topics found but tier-filtered stay silent.
# Usage: hv-knowledge-query [--repo umbrella|<name>] [--include-deprecated] [--tier <T>] <topic>...
#   --repo <scope>        force scope: "umbrella" or a registered sub-repo name
#   --include-deprecated  emit deprecated bullets too (still suffixed)
#   --tier <T>            filter to only the named tier
#                         (provisional|confirmed|deprecated)
set -euo pipefail
. "$(dirname "${BASH_SOURCE[0]}")/hv-preamble.sh"

USAGE="usage: hv-knowledge-query [--repo umbrella|<name>] [--include-deprecated] [--tier <T>] <topic>..."

INCLUDE_DEPRECATED=0
TIER_FILTER=""
REPO_FLAG=""
TOPICS=()
while [[ $# -gt 0 ]]; do
  case "$1" in
    --repo)
      REPO_FLAG="${2:?$USAGE}"
      shift 2
      ;;
    --include-deprecated)
      INCLUDE_DEPRECATED=1
      shift
      ;;
    --tier)
      TIER_FILTER="${2:?--tier requires a value}"
      case "$TIER_FILTER" in
        provisional|confirmed|deprecated) ;;
        *) echo "error: --tier must be one of: provisional, confirmed, deprecated" >&2; exit 1 ;;
      esac
      shift 2
      ;;
    --help|-h)
      grep '^# ' "$0" | sed 's/^# //'
      exit 0
      ;;
    --)
      shift
      while [[ $# -gt 0 ]]; do TOPICS+=("$1"); shift; done
      ;;
    *)
      TOPICS+=("$1")
      shift
      ;;
  esac
done

[ "${#TOPICS[@]}" -ge 1 ] || exit 0

# Resolve scope: "umbrella" or a sub-repo name. Umbrella is the degenerate
# 1-element case of the hybrid file_pairs list; the Python block below
# branches on HV_SCOPE_MODE to preserve umbrella's doc-order outer loop
# (no `> from:` prefix) versus hybrid's argv-order outer loop (per-file
# `> from:` prefix). The bullet-filter logic itself is shared.
. "$HERE/hv-knowledge-scope.sh"
SCOPE="$(hv_resolve_knowledge_scope "$REPO_FLAG")"

if ! UMBRELLA_SIDECAR=$("$HERE/hv-knowledge-tier" --list 2>&1); then
  printf '%s\n' "$UMBRELLA_SIDECAR" >&2
  echo "error: hv-knowledge-query: umbrella tier sidecar read failed" >&2
  exit 1
fi
[ -z "$UMBRELLA_SIDECAR" ] && UMBRELLA_SIDECAR="[]"

if [ "$SCOPE" = "umbrella" ]; then
  SCOPE_MODE="umbrella"
  SUBREPO_FILE=""
  SUBREPO_SIDECAR=""
else
  SCOPE_MODE="hybrid"
  SUBREPO_FILE="$(hv_resolve_knowledge_path "$SCOPE")" || { rc=$?; echo "$SUBREPO_FILE" >&2; exit $rc; }
  if ! SUBREPO_SIDECAR=$("$HERE/hv-knowledge-tier" --list --repo "$SCOPE" 2>&1); then
    printf '%s\n' "$SUBREPO_SIDECAR" >&2
    echo "error: hv-knowledge-query: sub-repo tier sidecar read failed (--repo $SCOPE)" >&2
    exit 1
  fi
  [ -z "$SUBREPO_SIDECAR" ] && SUBREPO_SIDECAR="[]"
fi

export HV_SCOPE_MODE="$SCOPE_MODE"
export HV_UMBRELLA_SIDECAR="$UMBRELLA_SIDECAR"
export HV_SUBREPO_FILE="$SUBREPO_FILE"
export HV_SUBREPO_SIDECAR="$SUBREPO_SIDECAR"
export HV_INCLUDE_DEPRECATED="$INCLUDE_DEPRECATED"
export HV_TIER_FILTER="$TIER_FILTER"

PYTHONPATH="$HERE${PYTHONPATH:+:$PYTHONPATH}" python3 - "${TOPICS[@]}" <<'PY'
import json
import os
import re
import sys
from pathlib import Path
from hvlib import iter_topics

wanted_ordered = [t.strip().lower() for t in sys.argv[1:]]
if not wanted_ordered:
    sys.exit(0)
wanted_set = set(wanted_ordered)

orig_topics = sys.argv[1:]
matched_topics: set[str] = set()

scope_mode = os.environ.get("HV_SCOPE_MODE", "umbrella")
include_deprecated = os.environ.get("HV_INCLUDE_DEPRECATED", "0") == "1"
tier_filter = os.environ.get("HV_TIER_FILTER", "") or None

bullet_re = re.compile(
    r"^- \*\*(?P<title>[^*]+)\*\* — (?P<body>.*?)(?P<trail>\s*<!-- \d{4}-\d{2}-\d{2}\s*-->\s*)$"
)


def collect_bullets(body, name, tier_by_key):
    """Filter and annotate bullets from a topic body; return list of lines."""
    out_lines = []
    for line in body.splitlines():
        m = bullet_re.match(line.rstrip())
        if not m:
            out_lines.append(line)
            continue

        title = m.group("title").strip()
        tier = tier_by_key.get((name, title))

        if tier_filter is not None and tier != tier_filter:
            continue

        if tier == "deprecated" and not include_deprecated:
            continue

        if tier == "provisional":
            new_body = f"{m.group('body')} (provisional)"
            line = f"- **{title}** — {new_body}{m.group('trail')}"

        out_lines.append(line)
    return out_lines


def _parse_sidecar(raw):
    entries = []
    if raw:
        try:
            entries = json.loads(raw)
        except json.JSONDecodeError:
            pass
    if not isinstance(entries, list):
        entries = []
    return {
        (e["topic"], e["title"]): e["tier"]
        for e in entries
        if isinstance(e, dict) and "topic" in e and "title" in e and "tier" in e
    }


umbrella_tbk = _parse_sidecar(os.environ.get("HV_UMBRELLA_SIDECAR", ""))
parsed_pairs = [(".hv/KNOWLEDGE.md", umbrella_tbk, ".hv/KNOWLEDGE.md")]
subrepo_file = os.environ.get("HV_SUBREPO_FILE", "")
if scope_mode == "hybrid" and subrepo_file:
    subrepo_tbk = _parse_sidecar(os.environ.get("HV_SUBREPO_SIDECAR", ""))
    parsed_pairs.append((subrepo_file, subrepo_tbk, subrepo_file))

if scope_mode == "umbrella":
    # Umbrella path: single file pair, doc-order outer loop, no `> from:`.
    # Preserves pre-F21 byte-identical output.
    fp, tier_by_key, _label = parsed_pairs[0]
    path = Path(fp)
    if not path.exists():
        sys.exit(0)
    content = path.read_text()
    first_topic = True
    for name, body in iter_topics(content):
        if name.lower() not in wanted_set:
            continue
        matched_topics.add(name.lower())
        out_lines = collect_bullets(body, name, tier_by_key)
        if not first_topic:
            print()
        print(f"## {name}")
        print("\n".join(out_lines).rstrip())
        first_topic = False
else:
    # Hybrid path: argv-order outer loop, `> from:` per file with content.
    first_topic = True
    for wanted_lower in wanted_ordered:
        heading_printed = False
        for fp, tier_by_key, label in parsed_pairs:
            path = Path(fp)
            if not path.exists():
                continue
            content = path.read_text()
            for name, body in iter_topics(content):
                if name.lower() != wanted_lower:
                    continue
                matched_topics.add(name.lower())
                out_lines = collect_bullets(body, name, tier_by_key)
                if not out_lines:
                    break  # topic exists but all bullets filtered out for this file
                if not heading_printed:
                    if not first_topic:
                        print()
                    print(f"## {name}")
                    first_topic = False
                    heading_printed = True
                print(f"> from: {label}")
                print("\n".join(out_lines).rstrip())
                break  # each file has at most one section per topic name

seen_warn: set[str] = set()
for orig in orig_topics:
    key = orig.strip().lower()
    if key and key not in matched_topics and key not in seen_warn:
        seen_warn.add(key)
        sys.stderr.write(
            f"warning: hv-knowledge-query: no topic heading matches {orig!r} "
            f"— topic args must be the exact '## ' heading text\n"
        )
PY

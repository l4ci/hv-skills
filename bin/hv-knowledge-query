#!/usr/bin/env bash
# Print matching ## Topic section(s) from .hv/KNOWLEDGE.md with tier-aware
# filtering. Hides `deprecated` bullets by default; suffixes ` (provisional)`
# onto bullets still on probation; emits `confirmed` bullets unchanged.
# Reads tier state from the F03 sidecar at .hv/knowledge-tier.json via
# `hv-knowledge-tier --list`. When the sidecar is missing or empty (older
# project, pre-F03 rollout), all bullets emit unfiltered.
#
# Under umbrella mode, when cwd is inside a registered sub-repo (or --repo
# <name> is given), performs a hybrid read: umbrella KNOWLEDGE.md first, then
# the sub-repo sidecar, each preceded by a `> from: <path>` provenance line.
#
# Lookup helper: always exits 0; missing topics are silent.
# Usage: hv-knowledge-query [--repo umbrella|<name>] [--include-deprecated] [--tier <T>] <topic>...
#   --repo <scope>        force scope: "umbrella" or a registered sub-repo name
#   --include-deprecated  emit deprecated bullets too (still suffixed)
#   --tier <T>            filter to only the named tier
#                         (provisional|confirmed|deprecated)
set -euo pipefail
. "$(dirname "${BASH_SOURCE[0]}")/hv-preamble.sh"

INCLUDE_DEPRECATED=0
TIER_FILTER=""
REPO_FLAG=""
TOPICS=()
while [[ $# -gt 0 ]]; do
  case "$1" in
    --repo)
      REPO_FLAG="${2:?--repo requires a value (umbrella or a sub-repo name)}"
      shift 2
      ;;
    --include-deprecated)
      INCLUDE_DEPRECATED=1
      shift
      ;;
    --tier)
      TIER_FILTER="${2:?--tier requires a value}"
      case "$TIER_FILTER" in
        provisional|confirmed|deprecated) ;;
        *) echo "error: --tier must be one of: provisional, confirmed, deprecated" >&2; exit 1 ;;
      esac
      shift 2
      ;;
    --help|-h)
      grep '^# ' "$0" | sed 's/^# //'
      exit 0
      ;;
    --)
      shift
      while [[ $# -gt 0 ]]; do TOPICS+=("$1"); shift; done
      ;;
    *)
      TOPICS+=("$1")
      shift
      ;;
  esac
done

[ "${#TOPICS[@]}" -ge 1 ] || exit 0

# Resolve scope: "umbrella" or a sub-repo name.
. "$HERE/hv-knowledge-scope.sh"
SCOPE="$(hv_resolve_knowledge_scope "$REPO_FLAG")"

if [ "$SCOPE" = "umbrella" ]; then
  # ── Umbrella path: byte-identical to pre-F21 behavior ──────────────────────
  # Collect the sidecar state once; emit empty JSON when the helper / file
  # is missing so the Python below treats it as "no tier info, emit raw".
  SIDECAR_JSON=$("$HERE/hv-knowledge-tier" --list 2>/dev/null || echo "[]")
  [ -z "$SIDECAR_JSON" ] && SIDECAR_JSON="[]"

  export HV_SIDECAR_JSON="$SIDECAR_JSON"
  export HV_INCLUDE_DEPRECATED="$INCLUDE_DEPRECATED"
  export HV_TIER_FILTER="$TIER_FILTER"

  PYTHONPATH="$HERE${PYTHONPATH:+:$PYTHONPATH}" python3 - ".hv/KNOWLEDGE.md" "${TOPICS[@]}" <<'PY'
import json
import os
import re
import sys
from pathlib import Path
from hvlib import iter_topics

file_path = Path(sys.argv[1])
wanted = {t.strip().lower() for t in sys.argv[2:]}
if not wanted or not file_path.exists():
    sys.exit(0)

include_deprecated = os.environ.get("HV_INCLUDE_DEPRECATED", "0") == "1"
tier_filter = os.environ.get("HV_TIER_FILTER", "") or None

try:
    entries = json.loads(os.environ.get("HV_SIDECAR_JSON", "[]"))
except json.JSONDecodeError:
    entries = []
tier_by_key = {
    (e["topic"], e["title"]): e["tier"]
    for e in entries
    if isinstance(e, dict) and "topic" in e and "title" in e and "tier" in e
}

content = file_path.read_text()

bullet_re = re.compile(
    r"^- \*\*(?P<title>[^*]+)\*\* — (?P<body>.*?)(?P<trail>\s*<!-- \d{4}-\d{2}-\d{2}\s*-->\s*)$"
)

first = True
for name, body in iter_topics(content):
    if name.lower() not in wanted:
        continue

    out_lines = []
    for line in body.splitlines():
        m = bullet_re.match(line.rstrip())
        if not m:
            out_lines.append(line)
            continue

        title = m.group("title").strip()
        tier = tier_by_key.get((name, title))

        if tier_filter is not None and tier != tier_filter:
            continue

        if tier == "deprecated" and not include_deprecated:
            continue

        if tier == "provisional":
            new_body = f"{m.group('body')} (provisional)"
            line = f"- **{title}** — {new_body}{m.group('trail')}"

        out_lines.append(line)

    if not first:
        print()
    print(f"## {name}")
    print("\n".join(out_lines).rstrip())
    first = False
PY

else
  # ── Sub-repo hybrid path: umbrella file + sub-repo file, with > from: ───────
  # Resolve sub-repo file path via T1 resolver; guard ValueError → exit 1.
  SUBREPO_FILE=$(PYTHONPATH="$HERE${PYTHONPATH:+:$PYTHONPATH}" python3 -c \
    "from hvlib import resolve_knowledge_target; print(resolve_knowledge_target('$SCOPE'))" \
    2>&1) || { echo "error: $SUBREPO_FILE" >&2; exit 1; }

  # Collect sidecars for umbrella and sub-repo scopes separately.
  UMBRELLA_SIDECAR=$("$HERE/hv-knowledge-tier" --list 2>/dev/null || echo "[]")
  [ -z "$UMBRELLA_SIDECAR" ] && UMBRELLA_SIDECAR="[]"

  SUBREPO_SIDECAR=$("$HERE/hv-knowledge-tier" --list --repo "$SCOPE" 2>/dev/null || echo "[]")
  [ -z "$SUBREPO_SIDECAR" ] && SUBREPO_SIDECAR="[]"

  # Build a JSON array of [file_path, sidecar_entries, provenance_label] triples.
  # Python will iterate topics as outer loop, files as inner loop.
  FILE_PAIRS="$(python3 -c "
import json, sys
pairs = [
    ('.hv/KNOWLEDGE.md', json.loads(sys.argv[1]), '.hv/KNOWLEDGE.md'),
    (sys.argv[2],        json.loads(sys.argv[3]), sys.argv[2]),
]
print(json.dumps(pairs))
" "$UMBRELLA_SIDECAR" "$SUBREPO_FILE" "$SUBREPO_SIDECAR")"

  export HV_FILE_PAIRS="$FILE_PAIRS"
  export HV_INCLUDE_DEPRECATED="$INCLUDE_DEPRECATED"
  export HV_TIER_FILTER="$TIER_FILTER"

  PYTHONPATH="$HERE${PYTHONPATH:+:$PYTHONPATH}" python3 - "${TOPICS[@]}" <<'PY'
import json
import os
import re
import sys
from pathlib import Path
from hvlib import iter_topics

wanted_ordered = [t.strip().lower() for t in sys.argv[1:]]
if not wanted_ordered:
    sys.exit(0)

include_deprecated = os.environ.get("HV_INCLUDE_DEPRECATED", "0") == "1"
tier_filter = os.environ.get("HV_TIER_FILTER", "") or None

try:
    file_pairs = json.loads(os.environ.get("HV_FILE_PAIRS", "[]"))
except json.JSONDecodeError:
    file_pairs = []

bullet_re = re.compile(
    r"^- \*\*(?P<title>[^*]+)\*\* — (?P<body>.*?)(?P<trail>\s*<!-- \d{4}-\d{2}-\d{2}\s*-->\s*)$"
)


def collect_bullets(body, name, tier_by_key):
    """Filter and annotate bullets from a topic body; return list of lines."""
    out_lines = []
    for line in body.splitlines():
        m = bullet_re.match(line.rstrip())
        if not m:
            out_lines.append(line)
            continue

        title = m.group("title").strip()
        tier = tier_by_key.get((name, title))

        if tier_filter is not None and tier != tier_filter:
            continue

        if tier == "deprecated" and not include_deprecated:
            continue

        if tier == "provisional":
            new_body = f"{m.group('body')} (provisional)"
            line = f"- **{title}** — {new_body}{m.group('trail')}"

        out_lines.append(line)
    return out_lines


# Pre-build tier_by_key for each file pair.
parsed_pairs = []
for fp, entries, label in file_pairs:
    if not isinstance(entries, list):
        entries = []
    tbk = {
        (e["topic"], e["title"]): e["tier"]
        for e in entries
        if isinstance(e, dict) and "topic" in e and "title" in e and "tier" in e
    }
    parsed_pairs.append((fp, tbk, label))

# Outer loop: topics (in argv order).
first_topic = True
for wanted_lower in wanted_ordered:
    heading_printed = False
    for fp, tier_by_key, label in parsed_pairs:
        path = Path(fp)
        if not path.exists():
            continue
        content = path.read_text()
        for name, body in iter_topics(content):
            if name.lower() != wanted_lower:
                continue
            out_lines = collect_bullets(body, name, tier_by_key)
            if not out_lines:
                break  # topic exists but all bullets filtered out for this file
            if not heading_printed:
                if not first_topic:
                    print()
                print(f"## {name}")
                first_topic = False
                heading_printed = True
            print(f"> from: {label}")
            print("\n".join(out_lines).rstrip())
            break  # each file has at most one section per topic name
PY

fi

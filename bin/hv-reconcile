#!/usr/bin/env bash
# Validate .hv/status.json against git state. Auto-remove stale entries (branch gone).
# Emit JSON: { "cleaned": [...], "needsAction": [...], "todoDrift": [...] } so
# the agent can present clearly. In umbrella mode, entries with a non-null
# `repo` are scoped to <umbrella>/<repo>/. The `todoDrift` field is populated
# by hv-todo-drift — IDs whose tags appear in commit subjects but are still
# listed as open in TODO.md. Helper failure => todoDrift: [] (don't fail
# the whole reconcile). Entries where noBase:true indicate the umbrella cwd
# has no git repo; commitCount is 0 but is not meaningful for those entries.
# Usage: hv-reconcile
set -euo pipefail
HERE="$(cd "$(dirname "$0")" && pwd)"
UMBRELLA_ON=$("$HERE/hv-umbrella-on")
if [ "$UMBRELLA_ON" = "yes" ]; then
  # In umbrella mode, the umbrella tree may legitimately not be a git repo;
  # we don't compute commitCount for the umbrella cwd in that case.
  HV_BASE=""
else
  HV_BASE="$("$HERE/hv-base-branch")"
fi
export HV_BASE HERE UMBRELLA_ON
PYTHONPATH="$HERE${PYTHONPATH:+:$PYTHONPATH}" python3 - <<'PY'
import json, subprocess, os, sys
from pathlib import Path
from hvlib import load_json, dump_json_atomic, load_repos, active_items

HERE = os.environ["HERE"]
UMBRELLA_BASE = os.environ["HV_BASE"]
UMBRELLA_ON = os.environ["UMBRELLA_ON"]

def collect_todo_drift():
    try:
        r = subprocess.run([f"{HERE}/hv-todo-drift"], capture_output=True, text=True)
        if r.returncode != 0:
            return []
        return json.loads(r.stdout).get("drift", [])
    except (json.JSONDecodeError, OSError):
        return []

path = Path(".hv/status.json")
if not path.exists():
    print(json.dumps({"cleaned": [], "needsAction": [], "todoDrift": collect_todo_drift()}))
    sys.exit(0)

data = load_json(path, {"active": []})
active = data.get("active", [])

def git(*args, cwd=None):
    r = subprocess.run(["git", *args], capture_output=True, text=True, cwd=cwd)
    return r.stdout.strip(), r.returncode

REPOS = load_repos()
base_cache = {None: UMBRELLA_BASE}  # None key = umbrella cwd

cleaned, needs_action, still_active = [], [], []
for entry in active:
    branch = entry.get("branch")
    repo = entry.get("repo")
    if not branch:
        cleaned.append({"reason": "no_branch_field", "repo": repo, "entry": entry})
        continue

    git_cwd = None
    if repo:
        git_cwd = REPOS.get(repo)
        if git_cwd is None:
            cleaned.append({
                "branch": branch,
                "repo": repo,
                "reason": "repo_unregistered",
                "items": active_items(entry),
            })
            continue

    out, _ = git("branch", "--list", branch, cwd=git_cwd)
    if not out:
        cleaned.append({
            "branch": branch,
            "repo": repo,
            "reason": "branch_gone",
            "items": active_items(entry),
        })
        continue

    worktree = entry.get("worktree")
    worktree_missing = bool(worktree) and not os.path.isdir(worktree)
    if worktree_missing:
        entry = {**entry, "worktree": None}

    no_base = False
    if repo is None and UMBRELLA_ON == "yes" and not UMBRELLA_BASE:
        no_base = True
        commit_count = 0
    else:
        if repo not in base_cache:
            result = subprocess.run(
                [f"{HERE}/hv-base-branch"],
                capture_output=True, text=True, cwd=git_cwd,
            )
            base_cache[repo] = result.stdout.strip() if result.returncode == 0 else "main"
        base = base_cache[repo]
        commit_count = 0
        out, rc = git("rev-list", "--count", f"{base}..{branch}", cwd=git_cwd)
        if rc == 0 and out.isdigit():
            commit_count = int(out)

    needs_action.append({
        "branch": branch,
        "repo": repo,
        "items": active_items(entry),
        "worktree": entry.get("worktree"),
        "startedAt": entry.get("startedAt"),
        "hasCommits": commit_count > 0,
        "commitCount": commit_count,
        "worktreeMissing": worktree_missing,
        "noBase": no_base,
    })
    still_active.append(entry)

data["active"] = still_active
dump_json_atomic(path, data)
print(json.dumps({
    "cleaned": cleaned,
    "needsAction": needs_action,
    "todoDrift": collect_todo_drift(),
}, indent=2))
PY

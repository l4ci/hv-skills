#!/usr/bin/env bash
# Is the item specified well enough to start? Prints one reason per line for what is missing.
# Ready = acceptance criteria (a heading containing "Acceptance", or a `- [ ]` / `- [x]` checkbox line)
# in the issue body (file backend: the detail file) OR a design / plan note (file backend:
# .hv/designs/<ID>.md or .hv/plans/*-<ID>.md). Reasons: `no acceptance criteria in the issue body`,
# `no design or plan note`.
# Reader helper: exit 0 ready (prints nothing); exit 1 not ready, or on usage error, unknown item or
#   tracker failure (errors start `error:` on stderr); exit 2 backend unavailable; exit 3 tracker
#   unavailable; exit 4 rate-limited.
# Usage: hv-item-ready <ref>
set -euo pipefail
. "$(dirname "${BASH_SOURCE[0]}")/hv-preamble.sh"
REF="${1:?usage: hv-item-ready <ref>}"
[ $# -eq 1 ] || { echo "usage: hv-item-ready <ref>" >&2; exit 1; }
PYTHONPATH="$HERE${PYTHONPATH:+:$PYTHONPATH}" python3 - "$REF" <<'PY'
import sys
from hvlib import get_backend, BackendUnavailable, TrackerError, tracker_exit_code

def die(msg, code=1):
    sys.stderr.write(f"error: hv-item-ready: {msg}\n"); sys.exit(code)

try:
    reasons = get_backend().ready_reasons(sys.argv[1])
except BackendUnavailable as e:
    die(str(e), 2)
except TrackerError as e:
    die(e.message, tracker_exit_code(e))
except (LookupError, ValueError) as e:
    die(e.args[0])
for r in reasons:
    print(r)
sys.exit(1 if reasons else 0)
PY

#!/usr/bin/env bash
# Resolve a comma-separated Repos: list into a JSON array of {name, path}.
# Usage: hv-resolve-repos "<repos-csv>"
# Exits: 0 with JSON array on stdout, 1 if any name not registered (lists
#        missing names on stderr), 2 on usage error.
set -euo pipefail
CSV="${1?usage: hv-resolve-repos <repos-csv>}"
HERE="$(cd "$(dirname "$0")" && pwd)"
PYTHONPATH="$HERE${PYTHONPATH:+:$PYTHONPATH}" python3 - "$CSV" <<'PY'
import json, sys
from hvlib import load_repos, parse_repos_csv

names = parse_repos_csv(sys.argv[1])
repos = load_repos()
missing = [n for n in names if n not in repos]
if missing:
    sys.stderr.write(f"unregistered sub-repo(s): {', '.join(missing)}\n")
    sys.exit(1)
out = [{"name": n, "path": repos[n]} for n in names]
json.dump(out, sys.stdout)
sys.stdout.write("\n")
PY

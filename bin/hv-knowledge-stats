#!/usr/bin/env bash
# Print bullet count and byte size per topic in .hv/KNOWLEDGE.md as JSON.
# Lookup helper: exits 0 always; emits {"topics":[]} when KNOWLEDGE.md missing.
# Usage: hv-knowledge-stats
# Output: {"topics": [{"name": "Topic", "bullets": N, "bytes": N}, ...]}
# Silent-empty {"topics": []} when KNOWLEDGE.md is missing.
set -euo pipefail
HERE="$(cd "$(dirname "$0")" && pwd)"
. "$HERE/hv-self-locate.sh"
hv_self_locate
PYTHONPATH="$HERE${PYTHONPATH:+:$PYTHONPATH}" python3 - <<'PY'
import json
import re
from pathlib import Path
from hvlib import iter_topics

path = Path(".hv/KNOWLEDGE.md")
if not path.exists():
    print(json.dumps({"topics": []}, indent=2))
    raise SystemExit(0)

content = path.read_text()
topics = []
for name, body in iter_topics(content):
    bullets = len(re.findall(r"^- ", body, re.MULTILINE))
    nbytes = len(body.encode("utf-8"))
    topics.append({"name": name, "bullets": bullets, "bytes": nbytes})

print(json.dumps({"topics": topics}, indent=2))
PY

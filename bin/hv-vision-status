#!/usr/bin/env bash
# Change a milestone's status — updates both the frontmatter in
# .hv/milestones/MNN.md and the **Status:** line in .hv/MILESTONES.md.
# Writer helper: exit 0 on successful status update; exit 1 on unknown ID or invalid status.
# Usage: hv-vision-status <ID> <planned|active|shipped|archived>
set -euo pipefail
. "$(dirname "${BASH_SOURCE[0]}")/hv-preamble.sh"
. "$HERE/hv-types.sh"
ID="${1:?usage: hv-vision-status <ID> <planned|active|shipped|archived>}"
NEW_STATUS="${2:?usage: hv-vision-status <ID> <planned|active|shipped|archived>}"
if ! [[ "$NEW_STATUS" =~ ^($HV_MILESTONE_STATUSES)$ ]]; then
    echo "error: status must be one of: $HV_MILESTONE_STATUSES" >&2
    exit 1
fi
# Issue mode: swap the tracking issue's status label and open/close it with its native milestone.
if PYTHONPATH="$HERE${PYTHONPATH:+:$PYTHONPATH}" python3 -m hvlib_backend is-issues; then
  RC=0
  PYTHONPATH="$HERE${PYTHONPATH:+:$PYTHONPATH}" python3 - "$ID" "$NEW_STATUS" <<'PY' || RC=$?
import sys
from hvlib import get_backend, BackendUnavailable, TrackerError, tracker_exit_code

mid, status = sys.argv[1:3]
try:
    get_backend().milestone_status(mid, status)
except BackendUnavailable as e:
    sys.stderr.write(f"error: hv-vision-status: {e}\n"); sys.exit(2)
except TrackerError as e:
    sys.stderr.write(f"error: hv-vision-status: {e.message}\n"); sys.exit(tracker_exit_code(e))
except (LookupError, ValueError) as e:
    sys.stderr.write(f"error: hv-vision-status: {e.args[0]}\n"); sys.exit(1)
PY
  [ "$RC" -eq 0 ] || exit "$RC"
  "$HERE/hv-vision-index"
  exit 0
fi
PYTHONPATH="$HERE${PYTHONPATH:+:$PYTHONPATH}" python3 - "$ID" "$NEW_STATUS" <<'PY'
import sys
from pathlib import Path
from hvlib import write_text_atomic, update_frontmatter_field

mid, status = sys.argv[1], sys.argv[2]

detail = Path(f".hv/milestones/{mid}.md")
if not detail.exists():
    print(f"error: {detail} not found", file=sys.stderr)
    sys.exit(1)

content = detail.read_text()
new, found = update_frontmatter_field(content, "status", status)
if not found:
    print(f"error: status field not found in {detail}", file=sys.stderr)
    sys.exit(1)
write_text_atomic(detail, new)
# hv-vision-index regenerates MILESTONES.md; no need to pre-write it.
PY

# Regenerate CLAUDE.md vision block — status changes propagate atomically.
# Without this, the agent's next session reads a stale "active milestones" set.
"$HERE/hv-vision-index"

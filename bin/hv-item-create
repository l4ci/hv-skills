#!/usr/bin/env bash
# Capture one item in the configured backlog backend and print its ID.
# File backend: mints the ID (hv-next-id), appends the bullet (hv-append, Since: stamped),
#   and with --body-file writes .hv/<kind>/<ID>.md (`{ID}` tokens replaced) + a `Detail:` field.
# Issue backend: creates the issue (type/priority/size labels, fields block, native milestone);
#   the ID is the type letter + issue number, --body-file content follows --desc in the issue body.
# Writer helper: exit 0 and the ID on stdout; exit 1 on bad input (tag not valid for the kind,
#   unknown/empty field, missing --title, unreadable --body-file, missing BACKLOG.md or section,
#   milestone absent on the tracker, tracker failure); exit 3 tracker unavailable, 4 rate-limited.
# Usage: hv-item-create <bugs|features|tasks> --title T [--tag TAG] [--desc D] [--body-file F]
#                       [--field Name=Value]...
#   --tag    bugs P0..P3, features Major|Minor|Cosmetic, tasks none
#   --field  Related|Milestone|Repos|Subsystem|Captured (repeatable, value non-empty)
set -euo pipefail
. "$(dirname "${BASH_SOURCE[0]}")/hv-preamble.sh"
USAGE="usage: hv-item-create <bugs|features|tasks> --title T [--tag TAG] [--desc D] [--body-file F] [--field Name=Value]..."
KIND="${1:?$USAGE}"
shift
TITLE="" TAG="" DESC="" BODY_FILE=""
FIELDS=()
while [ $# -gt 0 ]; do
  case "$1" in
    --title) TITLE="${2:?$USAGE}"; shift 2 ;;
    --tag) TAG="${2:?$USAGE}"; shift 2 ;;
    --desc) DESC="${2:?$USAGE}"; shift 2 ;;
    --body-file) BODY_FILE="${2:?$USAGE}"; shift 2 ;;
    --field) FIELDS+=("${2:?$USAGE}"); shift 2 ;;
    *) echo "$USAGE" >&2; exit 1 ;;
  esac
done
[ -n "$TITLE" ] || { echo "error: hv-item-create: --title is required" >&2; exit 1; }
# The preamble cd'd to the project root; a relative --body-file is relative to the caller.
if [ -n "$BODY_FILE" ] && [[ "$BODY_FILE" != /* ]]; then BODY_FILE="${HV_ORIG_PWD:-$PWD}/$BODY_FILE"; fi
PYTHONPATH="$HERE${PYTHONPATH:+:$PYTHONPATH}" python3 - "$KIND" "$TITLE" "$TAG" "$DESC" "$BODY_FILE" "${FIELDS[@]+"${FIELDS[@]}"}" <<'PY'
import sys
from hvlib import get_backend, BackendUnavailable, TrackerError, tracker_exit_code

kind, title, tag, desc, body_file, *raw = sys.argv[1:]

def die(msg, code=1):
    sys.stderr.write(f"error: hv-item-create: {msg}\n"); sys.exit(code)

fields = {}
for kv in raw:
    name, sep, value = kv.partition("=")
    if not sep:
        die(f"--field expects Name=Value, got '{kv}'")
    fields[name] = value
body = None
if body_file:
    try:
        body = open(body_file, "rb").read()
    except OSError as e:
        die(f"cannot read --body-file: {e.strerror}: {body_file}")
try:
    print(get_backend().create(kind, title, tag, desc, fields, body))
except BackendUnavailable as e:
    die(str(e), 2)
except TrackerError as e:
    die(e.message, tracker_exit_code(e))
except FileNotFoundError as e:
    die(f"{e} not found")
except (LookupError, ValueError) as e:
    die(e.args[0])
PY

#!/usr/bin/env bash
# One-shot v3 → v4 codemod. Rewrites references to 8 commands cut by M01,
# migrates .hv/CONTEXT.md terms into .hv/KNOWLEDGE.md (## Glossary) via
# `hv-glossary-import`, and removes stale `.hv/bin/hv-context-*` files left
# by the cuts. `--dry-run` is default; `--apply` writes; `--verbose` adds
# per-file diffs. Idempotent — a clean second `--apply` rewrites zero files.
# Writer helper: exit 0 on success; exit 1 on safety-precondition refusal,
# 2 on usage error, 3 on missing companion helper.
#
# Usage:
#   hv-migrate v4 [--apply] [--verbose]
#   hv-migrate v4 --help
set -euo pipefail
. "$(dirname "${BASH_SOURCE[0]}")/hv-preamble.sh"

VERSION=""
APPLY="false"
VERBOSE="false"

while [ $# -gt 0 ]; do
  case "$1" in
    --apply)   APPLY="true"; shift ;;
    --verbose) VERBOSE="true"; shift ;;
    --dry-run) APPLY="false"; shift ;;   # explicit no-op for symmetry
    --help|-h)
      sed -n '2,12p' "$0" | sed 's/^# \{0,1\}//'
      exit 0 ;;
    -*) echo "error: unknown flag $1" >&2; exit 2 ;;
    *) [ -z "$VERSION" ] && VERSION="$1" || { echo "error: unexpected positional $1" >&2; exit 2; }; shift ;;
  esac
done

if [ -z "$VERSION" ]; then
  echo "error: version arg required (e.g., 'hv-migrate v4')" >&2
  exit 2
fi
if [ "$VERSION" != "v4" ]; then
  echo "error: only 'v4' supported at this hv-skills version (got '$VERSION')" >&2
  exit 2
fi

export _HV_MIGRATE_APPLY="$APPLY"
export _HV_MIGRATE_VERBOSE="$VERBOSE"
export _HV_MIGRATE_GLOSSARY_IMPORT="$HERE/hv-glossary-import"
export _HV_MIGRATE_RESOLVE_PLUGIN="$HERE/hv-resolve-plugin-root"
export _HV_MIGRATE_MANAGED_BLOCK_STRIP="$HERE/hv-managed-block-strip-deprecated"

PYTHONPATH="$HERE${PYTHONPATH:+:$PYTHONPATH}" python3 - <<'PY'
import datetime as dt
import json
import os
import re
import shutil
import subprocess
import sys
import tempfile
from pathlib import Path

from hvlib import iter_topics, load_repos, parse_term_entry, write_text_atomic

APPLY = os.environ["_HV_MIGRATE_APPLY"] == "true"
VERBOSE = os.environ["_HV_MIGRATE_VERBOSE"] == "true"
GLOSSARY_IMPORT = os.environ["_HV_MIGRATE_GLOSSARY_IMPORT"]
RESOLVE_PLUGIN = os.environ["_HV_MIGRATE_RESOLVE_PLUGIN"]
MANAGED_BLOCK_STRIP = os.environ["_HV_MIGRATE_MANAGED_BLOCK_STRIP"]

ROOT = Path.cwd()

# Eight rewrite rules from F19 detail. Word-boundary safe.
# Tuple: (pattern, replacement_or_None, description). None replacement = manual review.
REWRITE_RULES = [
    (re.compile(r"/hv-c\b"),       "/hv-capture",          "auto"),
    (re.compile(r"/hv-assume\b"),  "/hv-work --preview",   "auto"),
    (re.compile(r"/hv-rm\b"),      "/hv-capture --remove", "auto"),
    (re.compile(r"/hv-undo\b"),    "/hv-ship --undo",      "auto"),
    (re.compile(r"/hv-context\b"), "/hv-learn --term",     "auto"),
    (re.compile(r"/hv-docs\b"),    "/hv-ship --docs",      "auto"),
    (re.compile(r"/hv-issues\b"),  None, "ambiguous — could be --from-github or --from-gitlab"),
    (re.compile(r"/hv-map\b"),     None, "ambiguous — could be --init --map (first-run) or delete-the-line"),
]

# Scan scope per F19 design. Static paths + globs.
STATIC_PATHS = [
    Path(".hv/BACKLOG.md"),
    Path(".hv/MILESTONES.md"),
    Path(".hv/KNOWLEDGE.md"),
    Path(".hv/DECISIONS.md"),
    Path("CLAUDE.md"),
]
GLOB_DIRS = [
    (".hv/plans",     "*.md"),
    (".hv/designs",   "*.md"),
    (".hv/handoffs",  "*.md"),  # design name
    (".hv/handoff",   "*.md"),  # actual dir name (singular, used by hv-pause)
    (".hv/qa",        "*.md"),
    (".hv/milestones","*.md"),
]

CONTEXT_PATH = Path(".hv/CONTEXT.md")
REPOS_PATH   = Path(".hv/repos.json")
CONFIG_PATH  = Path(".hv/config.json")

# .hv/bin/ files orphaned by the F18 fold.
REMOVED_BINARIES = [
    "hv-context-add",
    "hv-context-index",
    "hv-context-map",
    "hv-context-query",
]


def die(msg: str, code: int = 1) -> None:
    print(f"error: {msg}", file=sys.stderr)
    sys.exit(code)


def check_safety_preconditions() -> None:
    # (b) running inside an existing backup directory
    cwd = str(ROOT.resolve())
    if "/.hv/migrate-backup/" in cwd or cwd.endswith("/.hv/migrate-backup"):
        die("refusing: cwd is inside .hv/migrate-backup/. Run from project root.", 1)

    # (a) working tree has uncommitted changes outside .hv/
    try:
        r = subprocess.run(
            ["git", "status", "--porcelain"],
            capture_output=True, text=True, check=True,
        )
    except (subprocess.CalledProcessError, FileNotFoundError):
        die("refusing: not inside a git repo (or git unavailable).", 1)
    dirty_outside_hv = []
    for line in r.stdout.splitlines():
        # porcelain format: "XY path" (XY two chars, then space)
        if len(line) < 4:
            continue
        path = line[3:].strip()
        # Rename lines look like "R  old -> new"; check the destination.
        if " -> " in path:
            path = path.split(" -> ", 1)[1]
        if path.startswith(".hv/"):
            continue
        dirty_outside_hv.append(path)
    if dirty_outside_hv:
        die(
            "refusing: uncommitted changes outside .hv/:\n  " +
            "\n  ".join(dirty_outside_hv) +
            "\nCommit or stash these before running /hv-migrate v4.",
            1,
        )

    # (c) .hv/config.json version present and >= 3.0
    if not CONFIG_PATH.exists():
        die("refusing: .hv/config.json missing — run /hv-init first.", 1)
    try:
        cfg = json.loads(CONFIG_PATH.read_text())
    except json.JSONDecodeError as e:
        die(f"refusing: .hv/config.json is not valid JSON ({e}).", 1)
    # Nested-first read with legacy top-level fallback.
    # /hv-init writes hvSkills.version (canonical v4 location); v3 projects
    # stamped the top-level "version" key. Tolerate both so fresh v4 inits
    # (hvSkills.version only) don't dead-end here.
    version = cfg.get("hvSkills", {}).get("version", "") or cfg.get("version", "")
    if not version:
        die("refusing: .hv/config.json has no 'version' field — run /hv-init.", 1)
    major = version.split(".", 1)[0]
    try:
        if int(major) < 3:
            die(
                f"refusing: project hv-skills version is {version} (pre-3.0). "
                "Bring it current with /hv-init before /hv-migrate v4.",
                1,
            )
    except ValueError:
        die(f"refusing: .hv/config.json version '{version}' is not parseable.", 1)

    # (d) umbrella project — defer to F21. Canonical detection: load_repos()
    # returns a non-empty dict only when sub-repos are registered. The bootstrap
    # default ({"repos":[]}) yields {} → not umbrella.
    if REPOS_PATH.exists() and load_repos(str(REPOS_PATH)):
        die(
            "refusing: umbrella project detected (.hv/repos.json carries sub-repos). "
            "Umbrella support for /hv-migrate is deferred to F21.",
            1,
        )


def check_glossary_import_present() -> None:
    """Verify bin/hv-glossary-import exists — required for CONTEXT.md migration."""
    gi = Path(GLOSSARY_IMPORT)
    if not gi.exists():
        die(
            "refusing: bin/hv-glossary-import not found — reinstall hv-skills to pick "
            "up the split helper (the batch path was previously hv-glossary-write --batch).",
            3,
        )


def iter_scan_targets():
    """Yield every existing file in the scan scope."""
    seen = set()
    for p in STATIC_PATHS:
        if p.exists() and str(p) not in seen:
            seen.add(str(p))
            yield p
    for d, pat in GLOB_DIRS:
        base = Path(d)
        if not base.is_dir():
            continue
        for f in sorted(base.glob(pat)):
            if str(f) not in seen:
                seen.add(str(f))
                yield f


def _compute_skip_mask(text: str) -> list[tuple[int, int]]:
    """Return (start, end) byte ranges in `text` where rewrites must NOT apply.
    Covers fenced code blocks, inline code spans, and helper-path tokens like
    `hv-map-query` or `.hv/bin/hv-foo` — anything that's a literal helper
    name (multi-segment kebab containing hv-) rather than a slash-command
    usage. The mask is a guard against false-positive rewrites inside code spans."""
    masks: list[tuple[int, int]] = []
    # Fenced code blocks: ```...```  (DOTALL so they span lines)
    for m in re.finditer(r"```.*?```", text, re.DOTALL):
        masks.append((m.start(), m.end()))
    # Inline code spans: `...`  (no newlines inside)
    for m in re.finditer(r"`[^`\n]+`", text):
        masks.append((m.start(), m.end()))
    # Helper-path tokens: multi-segment names like `hv-map-query` or paths
    # like `.hv/bin/hv-foo`. The regex requires `hv-` followed by two or more
    # word-char segments separated by hyphens, optionally prefixed by a path.
    # This catches substring false-matches on multi-segment helper names like
    # `hv-map-query` while leaving bare slash-commands like `/hv-context`
    # untouched (only one segment).
    for m in re.finditer(r"(?:[\w./]+/)?\bhv-\w+(?:-\w+)+", text):
        masks.append((m.start(), m.end()))
    return masks


def _overlaps_any(start: int, end: int, masks: list[tuple[int, int]]) -> bool:
    """True if [start, end) overlaps any mask range."""
    return any(not (end <= s or e <= start) for s, e in masks)


def rewrite_text(text: str, file_repr: str):
    """Apply all 8 rules to `text`. Return (new_text, count, manual_reviews).

    Skip matches inside fenced/inline code spans and inside helper-path
    tokens. This prevents corrupting self-documenting mentions in
    BACKLOG/KNOWLEDGE entries and substring false-matches like `/hv-map\b`
    hitting inside `hv-map-query`.

    `manual_reviews` is a list of "file:line: rule — reason" strings.
    """
    masks = _compute_skip_mask(text)
    # Build (line_no, line_start_byte) index so we can map any byte offset
    # back to a 1-based line number for the manual_review output.
    line_starts: list[int] = [0]
    for i, ch in enumerate(text):
        if ch == "\n":
            line_starts.append(i + 1)

    def byte_to_lineno(offset: int) -> int:
        # Binary search for the largest line_starts entry <= offset.
        lo, hi = 0, len(line_starts)
        while lo < hi:
            mid = (lo + hi) // 2
            if line_starts[mid] <= offset:
                lo = mid + 1
            else:
                hi = mid
        return lo  # 1-based: line_starts[0] = 0 maps to line 1

    # First pass: collect manual-review locations BEFORE rewriting so line
    # numbers reflect input. Skip matches that fall inside the mask.
    manual: list[str] = []
    for pattern, repl, desc in REWRITE_RULES:
        if repl is not None:
            continue
        for m in pattern.finditer(text):
            if _overlaps_any(m.start(), m.end(), masks):
                continue
            lineno = byte_to_lineno(m.start())
            manual.append(f"{file_repr}:{lineno}: {pattern.pattern[1:]} — {desc}")

    # Second pass: apply auto rewrites, skipping masked matches. We process
    # each rule by walking matches and substituting only the unmasked ones,
    # rebuilding the text in one pass per rule. Mask offsets stay valid
    # within a single rule's pass because we recompute the mask after each
    # rule (substitutions can shift byte positions).
    new_text = text
    auto_count = 0
    for pattern, repl, desc in REWRITE_RULES:
        if repl is None:
            continue
        # Recompute mask against the current text — earlier rules may have
        # shifted offsets. This is O(rules × text-size), but rules count is
        # small and text size is bounded by the scan scope.
        rule_masks = _compute_skip_mask(new_text)
        out: list[str] = []
        last = 0
        n_subs = 0
        for m in pattern.finditer(new_text):
            if _overlaps_any(m.start(), m.end(), rule_masks):
                # Leave the original match in place.
                continue
            out.append(new_text[last:m.start()])
            out.append(repl)
            last = m.end()
            n_subs += 1
        out.append(new_text[last:])
        new_text = "".join(out)
        auto_count += n_subs
    return new_text, auto_count, manual


def unified_diff(old: str, new: str, label: str) -> str:
    import difflib
    return "".join(difflib.unified_diff(
        old.splitlines(keepends=True),
        new.splitlines(keepends=True),
        fromfile=label,
        tofile=label + " (rewritten)",
    ))


def plan_context_migration():
    """Inspect .hv/CONTEXT.md. Return dict describing what migration would do.

    Result shape:
      {"action": "none"|"delete"|"migrate", "terms": [...], "tsv": str|None,
       "msg": str}
    """
    if not CONTEXT_PATH.exists():
        return {"action": "none", "terms": [], "tsv": None, "msg": "no CONTEXT.md"}
    content = CONTEXT_PATH.read_text()
    terms = []
    for name, body in iter_topics(content):
        entry = parse_term_entry(body)
        if entry["definition"]:
            terms.append({
                "term": name,
                "def":  entry["definition"],
                "aliases": entry["aliases"],
                "nots":    entry["nots"],
            })
    if not terms:
        return {
            "action": "delete",
            "terms": [],
            "tsv": None,
            "msg": "placeholder only — file will be removed (no terms to migrate)",
        }
    # Build TSV manifest. Definitions may span multiple lines; flatten to single line
    # (hv-glossary-write batch mode is line-oriented; definitions wrap is fine).
    rows = ["# auto-generated by /hv-migrate v4 from .hv/CONTEXT.md"]
    for t in terms:
        def_flat = " ".join(t["def"].split())
        rows.append("\t".join([
            t["term"],
            def_flat,
            ", ".join(t["aliases"]),
            ", ".join(t["nots"]),
        ]))
    return {
        "action": "migrate",
        "terms": terms,
        "tsv": "\n".join(rows) + "\n",
        "msg": f"will migrate {len(terms)} term(s) to .hv/KNOWLEDGE.md (Glossary)",
    }


def apply_context_migration(plan, backup_root: Path) -> None:
    if plan["action"] == "none":
        return
    # Always back up first.
    dest = backup_root / "CONTEXT.md"
    dest.parent.mkdir(parents=True, exist_ok=True)
    shutil.copy2(CONTEXT_PATH, dest)
    if plan["action"] == "migrate":
        with tempfile.NamedTemporaryFile("w", suffix=".tsv", delete=False) as f:
            f.write(plan["tsv"])
            manifest = f.name
        try:
            r = subprocess.run(
                [GLOSSARY_IMPORT, manifest],
                capture_output=True, text=True,
            )
            if r.returncode != 0:
                die(
                    f"CONTEXT migration failed (hv-glossary-import exit {r.returncode}):\n"
                    f"{r.stderr}\n"
                    f"CONTEXT.md backed up at {dest}; not deleted. Resolve the conflict and re-run.",
                    3,
                )
        finally:
            Path(manifest).unlink(missing_ok=True)
    CONTEXT_PATH.unlink()


def resolve_installed_version() -> str:
    """Return the installed plugin's version from .claude-plugin/plugin.json,
    or empty string if it can't be resolved. Never raises."""
    try:
        r = subprocess.run(
            [RESOLVE_PLUGIN, "--root-only"],
            capture_output=True, text=True, check=False,
        )
        root = r.stdout.strip()
        if not root:
            return ""
        plugin_json = Path(root) / ".claude-plugin" / "plugin.json"
        if not plugin_json.exists():
            return ""
        return json.loads(plugin_json.read_text()).get("version", "") or ""
    except Exception:
        return ""


def stamp_version(new_version: str) -> bool:
    """Write hvSkills.version = new_version into .hv/config.json, preserving
    every other key. Drops the legacy top-level "version" field if present —
    v4 housekeeping; the nested location is canonical going forward.

    Returns True when the file changed (caller can print a bump line), False
    when the stamp is already canonical (nested matches new_version AND no
    legacy top-level key remains) — keeps idempotent re-runs silent.
    Silent no-op when new_version is empty (resolver couldn't find the plugin)."""
    if not new_version:
        return False
    cfg = json.loads(CONFIG_PATH.read_text())
    current = cfg.get("hvSkills", {}).get("version", "")
    legacy_present = "version" in cfg
    if current == new_version and not legacy_present:
        return False
    cfg.setdefault("hvSkills", {})["version"] = new_version
    cfg.pop("version", None)
    write_text_atomic(CONFIG_PATH, json.dumps(cfg, indent=2) + "\n")
    return True


def plan_removed_binaries():
    paths = []
    for name in REMOVED_BINARIES:
        p = Path(".hv/bin") / name
        if p.exists():
            paths.append(p)
    return paths


def apply_removed_binaries(paths, backup_root: Path) -> None:
    for p in paths:
        dest = backup_root / "bin" / p.name
        dest.parent.mkdir(parents=True, exist_ok=True)
        shutil.copy2(p, dest)
        p.unlink()


def main():
    check_safety_preconditions()
    check_glossary_import_present()

    rewrites = []          # list of {path, original, new, count}
    manual_review = []      # flat list of strings

    for path in iter_scan_targets():
        try:
            original = path.read_text()
        except UnicodeDecodeError:
            continue
        new_text, count, reviews = rewrite_text(original, str(path))
        manual_review.extend(reviews)
        if count > 0:
            rewrites.append({
                "path": path,
                "original": original,
                "new": new_text,
                "count": count,
            })

    ctx_plan = plan_context_migration()
    bin_plan = plan_removed_binaries()

    nothing_to_do = (
        not rewrites
        and ctx_plan["action"] == "none"
        and not bin_plan
    )

    # Always print summary; verbose adds per-file diffs.
    mode = "apply" if APPLY else "dry-run"
    print(f"/hv-migrate v4 ({mode})")
    print()

    files_touched = len(rewrites)
    refs_rewritten = sum(r["count"] for r in rewrites)
    print(f"  files scanned:      {sum(1 for _ in iter_scan_targets())}")
    print(f"  files rewritten:    {files_touched}")
    print(f"  references rewritten: {refs_rewritten}")
    print(f"  manual review:      {len(manual_review)}")
    print(f"  CONTEXT.md:         {ctx_plan['msg']}")
    print(f"  removed binaries:   {len(bin_plan)}")
    print()

    if VERBOSE and rewrites:
        print("— per-file diffs —")
        for r in rewrites:
            print(unified_diff(r["original"], r["new"], str(r["path"])))
        print()

    if rewrites:
        print("— rewrites —")
        for r in rewrites:
            print(f"  {r['path']}  ({r['count']} reference(s))")
        print()

    if manual_review:
        print("— manual review —")
        for m in manual_review:
            print(f"  {m}")
        print()

    if bin_plan:
        print("— removed binaries —")
        for p in bin_plan:
            print(f"  {p}")
        print()

    if nothing_to_do:
        print("noop: project is already on v4 (no rewrites, no CONTEXT.md, no stale bins).")
        # Even when no rewrites happened, --apply still bumps the version
        # stamp so hv-preflight reflects post-migration state. Without this the
        # user runs a clean --apply that "did nothing" yet preflight keeps
        # nagging.
        if APPLY:
            new_version = resolve_installed_version()
            if new_version and stamp_version(new_version):
                print(f"version stamp bumped to {new_version}")
        sys.exit(0)

    if not APPLY:
        print("Run with --apply to write the changes above.")
        sys.exit(0)

    # APPLY path — back up first, then write.
    ts = dt.datetime.now().strftime("%Y%m%dT%H%M%S")
    backup_root = Path(".hv/migrate-backup") / ts
    backup_root.mkdir(parents=True, exist_ok=True)

    for r in rewrites:
        backup_dest = backup_root / r["path"]
        backup_dest.parent.mkdir(parents=True, exist_ok=True)
        shutil.copy2(r["path"], backup_dest)
        write_text_atomic(r["path"], r["new"])

    if ctx_plan["action"] != "none":
        apply_context_migration(ctx_plan, backup_root)

    if bin_plan:
        apply_removed_binaries(bin_plan, backup_root)

    # Strip orphan managed blocks (e.g., the v3 `<!-- hv-context-* -->`
    # block left after /hv-context was cut). Silent on success; warns to
    # stderr if the helper isn't present so the migration doesn't fail on
    # partial v4 installs.
    try:
        subprocess.run(
            [MANAGED_BLOCK_STRIP],
            check=False, capture_output=True, text=True,
        )
    except FileNotFoundError:
        print(
            "warn: hv-managed-block-strip-deprecated not found — orphan v3 managed "
            "blocks in CLAUDE.md may need manual cleanup.",
            file=sys.stderr,
        )

    # Stamp hvSkills.version so hv-preflight stops nagging. stamp_version
    # returns False when the stamp is already canonical, keeping idempotent
    # re-runs free of noise.
    new_version = resolve_installed_version()
    if new_version and stamp_version(new_version):
        print(f"version stamp bumped to {new_version}")

    print(f"applied. backup at: {backup_root}")


if __name__ == "__main__":
    main()
PY

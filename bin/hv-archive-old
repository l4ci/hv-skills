#!/usr/bin/env bash
# Move items from ## Completed in .hv/TODO.md to .hv/ARCHIVE.md if older than THRESHOLD days (default 5).
# Usage: hv-archive-old [threshold-days]
# Outputs: number of items moved (silent if 0)
set -euo pipefail
HERE="$(cd "$(dirname "$0")" && pwd)"
. "$HERE/hv-self-locate.sh"
hv_self_locate
THRESHOLD="${1:-5}"
PYTHONPATH="$HERE${PYTHONPATH:+:$PYTHONPATH}" python3 - "$THRESHOLD" <<'PY'
import re, sys
from datetime import date, timedelta
from pathlib import Path
from hvlib import find_section, write_text_atomic
threshold = int(sys.argv[1])
cutoff = date.today() - timedelta(days=threshold)

todo = Path(".hv/TODO.md")
if not todo.exists():
    sys.exit(0)
content = todo.read_text()

span = find_section(content, "Completed")
if span is None:
    sys.exit(0)
start, end = span
section = content[start:end]

# Match only the canonical completed shape produced by hv-complete:
#   - ~~**[ID] …**~~ Done YYYY-MM-DD [`hash`]
# Prefix char class [BFTM] mirrors hv-types.sh; update both if types change.
pattern = re.compile(
    r"^(- ~~\*\*\[[BFTM]\d+\].*\*\*~~\s+Done\s+(\d{4})-(\d{2})-(\d{2})\s+\[`[^`]+`\])$",
    re.MULTILINE,
)
old_lines, kept_lines = [], []
for line in section.splitlines():
    mm = pattern.match(line)
    if mm:
        y, mo, d = int(mm.group(2)), int(mm.group(3)), int(mm.group(4))
        done_date = date(y, mo, d)
        if done_date < cutoff:
            old_lines.append(line)
            continue
    kept_lines.append(line)

if old_lines:
    # Rebuild TODO.md
    new_section = "\n".join(kept_lines)
    if not new_section.startswith("\n"):
        new_section = "\n" + new_section
    write_text_atomic(todo, content[:start] + new_section + content[end:])

    # Append to ARCHIVE.md
    archive = Path(".hv/ARCHIVE.md")
    header = "# Archive\n\nCompleted items older than the active window.\n\n"
    existing = archive.read_text() if archive.exists() else header
    write_text_atomic(archive, existing.rstrip() + "\n" + "\n".join(old_lines) + "\n")

print(len(old_lines))
PY

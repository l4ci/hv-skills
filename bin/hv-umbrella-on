#!/usr/bin/env bash
# Print "yes" if umbrella mode is enabled in .hv/config.json, "no" otherwise.
# Reads cwd-relative by default; optional <dir> arg for callers that already
# know the umbrella root (e.g. hv-spike-add captures UMBRELLA_CWD before any
# cd and passes it).
#
# Usage: hv-umbrella-on [<dir>]
#   stdout: "yes" or "no"
#   exit:   always 0 (errors silently treated as "no")
set -euo pipefail
DIR="${1:-.}"
HERE="$(cd "$(dirname "$0")" && pwd)"
PYTHONPATH="$HERE${PYTHONPATH:+:$PYTHONPATH}" python3 - "$DIR" <<'PY'
import sys
from pathlib import Path
from hvlib import load_json
cfg_path = Path(sys.argv[1]) / ".hv" / "config.json"
cfg = load_json(cfg_path, {})
print("yes" if cfg.get("umbrella", {}).get("enabled") else "no")
PY

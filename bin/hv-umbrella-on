#!/usr/bin/env bash
# Print "yes" if umbrella mode is in effect, "no" otherwise.
# Lookup helper: always exits 0 (errors treated as "no").
# Returns "yes" iff .hv/repos.json registers >=1 sub-repo (data is truth;
# the config flag is informational, not gating). Reads cwd-relative by
# default; optional <dir> arg for callers that already know the umbrella
# root (e.g. hv-spike-add captures UMBRELLA_CWD before any cd and passes it).
#
# Usage: hv-umbrella-on [<dir>]
#   stdout: "yes" or "no"
#   exit:   always 0 (errors silently treated as "no")
set -euo pipefail
DIR="${1:-.}"
HERE="$(cd "$(dirname "$0")" && pwd)"
PYTHONPATH="$HERE${PYTHONPATH:+:$PYTHONPATH}" python3 - "$DIR" <<'PY'
import sys
from pathlib import Path
from hvlib import load_repos
repos_path = Path(sys.argv[1]) / ".hv" / "repos.json"
repos = load_repos(repos_path) if repos_path.exists() else {}
print("yes" if repos else "no")
PY

#!/usr/bin/env bash
# Print milestone IDs that the given TODO items are tagged with,
# one per line, unique and numerically sorted. Scans only open sections
# (## Bugs, ## Features, ## Tasks) — completed/archived items don't surface.
# Lookup helper: always exits 0 when ≥1 args are given. Unknown IDs and
# untagged items are silent skips, not errors.
# Usage: hv-find-milestone-for-items <ID> [<ID>...]
set -euo pipefail
. "$(dirname "${BASH_SOURCE[0]}")/hv-preamble.sh"
. "$HERE/hv-types.sh"
if [ "$#" -lt 1 ]; then
  echo "usage: hv-find-milestone-for-items <ID> [<ID>...]" >&2
  exit 1
fi
PYTHONPATH="$HERE${PYTHONPATH:+:$PYTHONPATH}" python3 - "$@" <<'PY'
import sys
from pathlib import Path
from hvlib import (iter_open_bullets, parse_milestones, get_backend, BackendUnavailable,
                   TrackerError, tracker_exit_code)

ids_wanted = set(sys.argv[1:])
try:
    backend = get_backend()
    content = backend.backlog_markdown()
except BackendUnavailable as e:
    sys.stderr.write(f"error: hv-find-milestone-for-items: {e}\n"); sys.exit(2)
except ValueError as e:
    sys.stderr.write(f"error: hv-find-milestone-for-items: {e}\n"); sys.exit(1)
except TrackerError as e:
    sys.stderr.write(f"error: hv-find-milestone-for-items: {e.message}\n"); sys.exit(tracker_exit_code(e))
if content is None:
    raise SystemExit(0)
milestones = set()
for iid, line, fields, _section in iter_open_bullets(content):
    if iid not in ids_wanted:
        continue
    val = fields["milestone"]
    if not val:
        continue
    for mid in parse_milestones(val):
        milestones.add(mid)
for mid in sorted(milestones, key=lambda s: int(s[1:])):
    print(mid)
PY

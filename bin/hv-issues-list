#!/usr/bin/env bash
# List open issues from the target provider (GitHub via `gh`, GitLab via `glab`),
# normalized into a uniform JSON array.
#
# Lookup helper — exit 0 with [] when no issues or provider is unknown.
# Exit 1 with stderr when the matching CLI is missing or unauthed (precondition
# failure, NOT "empty result"). This disambiguates: empty answer ≠ broken setup.
#
# Usage: hv-issues-list [--repo <name>] [--mine] [--label <name>] [--limit <N>]
#   --repo  <name>  Umbrella mode: resolve <name> via hv-resolve-repo-path and
#                   run from that sub-repo directory.
#   --mine          Only issues authored by the authenticated user
#                   (--author @me on gh; --author @me on recent glab).
#   --label <name>  Filter by label.
#   --limit <N>     Max issues to fetch (default 30).
#   stdout: JSON array — [{number, title, body, labels, url, author}, ...]
#   exit:   0 on success (even empty), 1 on precondition failure
set -euo pipefail

. "$(dirname "${BASH_SOURCE[0]}")/hv-preamble.sh"

# shellcheck source=hv-issues-common.sh
. "$HERE/hv-issues-common.sh"

# ---------------------------------------------------------------------------
# Parse flags
# ---------------------------------------------------------------------------
LABEL=""
LIMIT=30
MINE=""

hv_issues_parse_repo_flag "$@"

while [[ $# -gt 0 ]]; do
  case "$1" in
    --repo)
      shift 2
      ;;
    --mine)
      MINE=1
      shift
      ;;
    --label)
      LABEL="${2:?--label requires a name argument}"
      shift 2
      ;;
    --limit)
      LIMIT="${2:?--limit requires a numeric argument}"
      shift 2
      ;;
    *)
      shift
      ;;
  esac
done

# ---------------------------------------------------------------------------
# Resolve sub-repo path (if --repo given)
# ---------------------------------------------------------------------------
hv_issues_resolve_repo_path

# ---------------------------------------------------------------------------
# Detect provider
# ---------------------------------------------------------------------------
hv_issues_detect_provider

# ---------------------------------------------------------------------------
# Branch on provider
# ---------------------------------------------------------------------------
case "$PROVIDER" in
  github)
    if ! command -v gh >/dev/null 2>&1 || ! gh auth status >/dev/null 2>&1; then
      echo "error: gh not installed or not authenticated" >&2
      exit 1
    fi

    RAW="$(
      if [ -n "$REPO_PATH" ]; then
        (
          cd "$REPO_PATH"
          gh issue list \
            --state open \
            --json number,title,body,labels,url,author \
            --limit "$LIMIT" \
            ${MINE:+--author "@me"} \
            ${LABEL:+--label "$LABEL"}
        )
      else
        gh issue list \
          --state open \
          --json number,title,body,labels,url,author \
          --limit "$LIMIT" \
          ${MINE:+--author "@me"} \
          ${LABEL:+--label "$LABEL"}
      fi
    )"

    echo "$RAW" | jq 'map({
      number,
      title,
      body,
      labels: [.labels[].name],
      url,
      author: .author.login
    })'
    ;;

  gitlab)
    if ! command -v glab >/dev/null 2>&1 || ! glab auth status >/dev/null 2>&1; then
      echo "error: glab not installed or not authenticated" >&2
      exit 1
    fi

    RAW="$(
      if [ -n "$REPO_PATH" ]; then
        (
          cd "$REPO_PATH"
          glab issue list \
            --opened \
            --output json \
            --per-page "$LIMIT" \
            ${MINE:+--author "@me"} \
            ${LABEL:+--label "$LABEL"}
        )
      else
        glab issue list \
          --opened \
          --output json \
          --per-page "$LIMIT" \
          ${MINE:+--author "@me"} \
          ${LABEL:+--label "$LABEL"}
      fi
    )"

    echo "$RAW" | jq 'map({
      number: .iid,
      title,
      body: .description,
      labels: (.labels // []),
      url: .web_url,
      author: .author.username
    })'
    ;;

  unknown)
    echo "[]"
    ;;
esac

exit 0

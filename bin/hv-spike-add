#!/usr/bin/env bash
# Start a spike — creates branch spike/<name> and .hv/spikes/<name>.md.
# Does NOT switch to the branch; the calling skill drives the UX.
# Usage: hv-spike-add [--repo <name>] <name> "<question>"
# Prints the branch name on stdout.
#
# Umbrella mode: when --repo <name> is set, the spike branch is created in
# the resolved sub-repo's git history (via cd into that sub-repo) while the
# spike file stays at the umbrella's .hv/spikes/<name>.md (umbrella-flat per
# M02 acceptance) and gains a `repo: <name>` frontmatter line.
set -euo pipefail

REPO=""
if [ "${1:-}" = "--repo" ]; then
  REPO="${2:?usage: hv-spike-add [--repo <name>] <name> <question>}"
  shift 2
fi

NAME="${1:?usage: hv-spike-add [--repo <name>] <name> <question>}"
QUESTION="${2:?usage: hv-spike-add [--repo <name>] <name> <question>}"

# Capture BIN_DIR + umbrella cwd BEFORE any cd — sibling-helper paths and
# the spike-file write must resolve against the umbrella, not the sub-repo.
# Route through hv-resolve-umbrella (→ hv-walk-up) so a single canonical
# entry point owns "find the umbrella" — falls back to physical pwd when
# the resolver can't locate a `.hv/` (no umbrella tree, or the resolver
# detected a masking sub-repo).
BIN_DIR="$(cd "$(dirname "$0")" && pwd)"
UMBRELLA_CWD="$("$BIN_DIR/hv-resolve-umbrella" 2>/dev/null || pwd -P)"

if ! [[ "$NAME" =~ ^[a-z0-9][a-z0-9-]*$ ]]; then
  echo "error: name must be lowercase alphanumeric + dashes, got '$NAME'" >&2
  exit 1
fi

BRANCH="spike/$NAME"
SPIKE_FILE=".hv/spikes/$NAME.md"

# Validate spike-file path BEFORE any cd — it lives at the umbrella root.
if [ -e "$SPIKE_FILE" ]; then
  echo "error: $SPIKE_FILE already exists" >&2
  exit 1
fi

if [ -n "$REPO" ]; then
  REPO_PATH=$("$BIN_DIR/hv-resolve-repo-path" "$REPO")
  (
    cd "$REPO_PATH"
    if ! git rev-parse --git-dir >/dev/null 2>&1; then
      echo "error: $REPO_PATH is not a git repository" >&2
      exit 1
    fi
    if git rev-parse --verify "$BRANCH" >/dev/null 2>&1; then
      echo "error: branch $BRANCH already exists in $REPO" >&2
      exit 1
    fi
    git branch "$BRANCH"
  )
else
  if ! git rev-parse --git-dir >/dev/null 2>&1; then
    # Umbrella cwd? Give a friendly pointer instead of a bare git error.
    UMBRELLA_ON="$("$BIN_DIR/hv-umbrella-on" "$UMBRELLA_CWD")"
    if [ "$UMBRELLA_ON" = "yes" ]; then
      NAMES="$(PYTHONPATH="$BIN_DIR${PYTHONPATH:+:$PYTHONPATH}" python3 - <<'PY'
from hvlib import load_repos
print(" ".join(load_repos().keys()))
PY
)"
      echo "error: hv-spike-add from the umbrella root requires --repo <name>" >&2
      if [ -n "$NAMES" ]; then
        echo "  registered sub-repos: $NAMES" >&2
      fi
      exit 1
    fi
    echo "error: not a git repository" >&2
    exit 1
  fi
  if git rev-parse --verify "$BRANCH" >/dev/null 2>&1; then
    echo "error: branch $BRANCH already exists" >&2
    exit 1
  fi
  git branch "$BRANCH"
fi

# Spike file write happens at the umbrella cwd (we never cd'd in the parent
# shell — git ops above ran in a subshell). Pass REPO through so the
# heredoc can emit the optional `repo:` frontmatter line.
cd "$UMBRELLA_CWD"
PYTHONPATH="$BIN_DIR${PYTHONPATH:+:$PYTHONPATH}" python3 - "$NAME" "$QUESTION" "$BRANCH" "$REPO" <<'PY'
import sys
from datetime import date
from pathlib import Path
from hvlib import write_text_atomic

name, question, branch, repo = sys.argv[1], sys.argv[2], sys.argv[3], sys.argv[4]

spikes_dir = Path(".hv/spikes")
spikes_dir.mkdir(parents=True, exist_ok=True)

spike_path = spikes_dir / f"{name}.md"

repo_line = f"repo: {repo}\n" if repo else ""

write_text_atomic(spike_path,
    f"""---
name: {name}
branch: {branch}
{repo_line}status: open
created: {date.today().isoformat()}
---

# spike/{name}

## Question

{question}

## What was tried

_(commands run, files touched on the spike branch — fill in as you go)_

## Findings

_(3–5 bullets — what you learned)_

## Decision

_(viable / not viable / depends-on-X)_

## Recommended approach

_(if viable, the shape of the real implementation — write only at /hv-spike done)_
"""
)
PY

echo "$BRANCH"

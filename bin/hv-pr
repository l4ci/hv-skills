#!/usr/bin/env bash
# Push a branch and open a GitHub PR via gh. Cleans up any worktree first.
# Reads PR body from stdin.
# Usage: echo "body" | hv-pr [--repo <name>] <branch> <title>
# Prints: the PR URL.
set -euo pipefail

REPO=""
if [ "${1:-}" = "--repo" ]; then
  REPO="${2:?usage: hv-pr [--repo <name>] <branch> <title>  (body on stdin)}"
  shift 2
fi

BRANCH="${1:?usage: hv-pr [--repo <name>] <branch> <title>  (body on stdin)}"
TITLE="${2:?usage: hv-pr [--repo <name>] <branch> <title>  (body on stdin)}"
BODY=$(cat)
if [ -z "$BODY" ]; then
  echo "error: hv-pr expects PR body on stdin" >&2
  exit 1
fi

BIN_DIR="$(cd "$(dirname "$0")" && pwd)"

resolve_repo_path() {
  local name="$1"
  PYTHONPATH="$BIN_DIR${PYTHONPATH:+:$PYTHONPATH}" python3 - "$name" <<'PY'
import sys
from hvlib import load_repos
name = sys.argv[1]
repos = load_repos()
if not repos:
    sys.stderr.write("error: --repo requires .hv/repos.json with at least one entry — run /hv-init from the umbrella root\n")
    sys.exit(1)
p = repos.get(name)
if not p:
    sys.stderr.write(f"error: --repo {name} not found in .hv/repos.json\n")
    sys.exit(1)
print(p)
PY
}

if [ -n "$REPO" ]; then
  REPO_PATH=$(resolve_repo_path "$REPO")
  cd "$REPO_PATH"
  "$BIN_DIR/hv-worktree-clear" --repo "$REPO" "$BRANCH"
else
  "$BIN_DIR/hv-worktree-clear" "$BRANCH"
fi

git push -u origin "$BRANCH"
gh pr create --title "$TITLE" --body "$BODY"

#!/usr/bin/env bash
# Push a branch and open a GitHub PR via gh. Cleans up any worktree first.
# Reads PR body from stdin.
# Usage: echo "body" | hv-pr [--repo <name>] <branch> <title>
# Prints: the PR URL.
set -euo pipefail

REPO=""
if [ "${1:-}" = "--repo" ]; then
  REPO="${2:?usage: hv-pr [--repo <name>] <branch> <title>  (body on stdin)}"
  shift 2
fi

BRANCH="${1:?usage: hv-pr [--repo <name>] <branch> <title>  (body on stdin)}"
TITLE="${2:?usage: hv-pr [--repo <name>] <branch> <title>  (body on stdin)}"
BODY=$(cat)
if [ -z "$BODY" ]; then
  echo "error: hv-pr expects PR body on stdin" >&2
  exit 1
fi

BIN_DIR="$(cd "$(dirname "$0")" && pwd)"

if [ -z "$REPO" ]; then
  "$BIN_DIR/hv-require-git-context" "hv-pr" --repo-flag-supported
fi

if [ -n "$REPO" ]; then
  REPO_PATH=$("$BIN_DIR/hv-resolve-repo-path" "$REPO")
  cd "$REPO_PATH"
  "$BIN_DIR/hv-worktree-clear" --repo "$REPO" "$BRANCH"
else
  "$BIN_DIR/hv-worktree-clear" "$BRANCH"
fi

git push -u origin "$BRANCH"
gh pr create --title "$TITLE" --body "$BODY"

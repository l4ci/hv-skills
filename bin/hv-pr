#!/usr/bin/env bash
# Push a branch and open a GitHub PR (gh) or GitLab MR (glab). Cleans up any worktree first.
# Reads PR body from stdin.
# Provider: issues.provider when github|gitlab, else hv-issues-provider; unknown falls back to github.
#   GitLab opens `glab mr create --source-branch <branch> --target-branch <hv-base-branch> --yes`.
# --closes <ID[,ID...]>: in issue mode (backlog.backend "issues") appends one `Closes #<n>` line per
#   item to the body; an unknown item fails before anything is pushed. File mode accepts and ignores it.
# Tool: exit 0 on successful PR creation; exit 1 on missing body, unknown --closes item or CLI error;
#   exit 3 tracker unavailable; exit 4 rate-limited (from hv-tracker-call).
# Usage: echo "body" | hv-pr [--repo <name>] [--closes <ID[,ID...]>] <branch> <title>
# Prints: the PR/MR URL.
set -euo pipefail

BIN_DIR="$(cd "$(dirname "$0")" && pwd)"
. "$BIN_DIR/hv-repo-flag.sh"

USAGE="usage: hv-pr [--repo <name>] [--closes <ID[,ID...]>] <branch> <title>  (body on stdin)"
REPO=""
CLOSES=""
while [ $# -gt 0 ]; do
  case "$1" in
    --repo) REPO="${2:?usage: hv-pr [--repo <name>] [--closes <ID[,ID...]>] <branch> <title>  (body on stdin)}"; shift 2 ;;
    --closes) CLOSES="${2:?$USAGE}"; shift 2 ;;
    *) break ;;
  esac
done

BRANCH="${1:?$USAGE}"
TITLE="${2:?$USAGE}"
BODY=$(cat)
if [ -z "$BODY" ]; then
  echo "error: hv-pr expects PR body on stdin" >&2
  exit 1
fi

hv_repo_flag_prepare "$BIN_DIR" "hv-pr" "$BRANCH"

# Provider (and, in issue mode, the Closes lines) are resolved before the push so a bad --closes ID
# fails with nothing pushed. The subshell sources the preamble so config is found from any subdir.
RESOLVED=$(CLOSES="$CLOSES" BIN_DIR="$BIN_DIR" bash -c '
  . "$BIN_DIR/hv-preamble.sh"
  PYTHONPATH="$HERE${PYTHONPATH:+:$PYTHONPATH}" python3 - <<"PY"
import os, subprocess, sys
from hvlib import load_config, config_value, get_backend, IssueBackend, resolve_item_ref

provider = config_value(load_config(), "issues.provider")
if provider not in ("github", "gitlab"):
    cwd = os.environ.get("HV_ORIG_PWD") or None
    r = subprocess.run([os.path.join(os.environ["BIN_DIR"], "hv-issues-provider")], capture_output=True, text=True, cwd=cwd)
    provider = r.stdout.strip()
print(provider if provider in ("github", "gitlab") else "github")
ids = [x.strip() for x in os.environ["CLOSES"].split(",") if x.strip()]
if ids:
    try:
        backend = get_backend()
    except ValueError:
        backend = None
    if isinstance(backend, IssueBackend):
        for ref in ids:
            try:
                canon = backend.canonical_id(ref)
            except Exception as e:
                sys.stderr.write("error: hv-pr: %s\n" % e); sys.exit(1)
            if canon is None:
                sys.stderr.write("error: hv-pr: --closes %s: no such item in the issue tracker\n" % ref); sys.exit(1)
            print("Closes #%d" % resolve_item_ref(canon)[0])
PY
') || exit 1
PROVIDER="${RESOLVED%%$'\n'*}"
CLOSES_LINES=""
[ "$RESOLVED" = "$PROVIDER" ] || CLOSES_LINES="${RESOLVED#*$'\n'}"
if [ -n "$CLOSES_LINES" ]; then
  BODY="$BODY"$'\n\n'"$CLOSES_LINES"
fi

git push -u origin "$BRANCH"
if [ "$PROVIDER" = "gitlab" ]; then
  BASE=$("$BIN_DIR/hv-base-branch")
  "$BIN_DIR/hv-tracker-call" --provider gitlab -- mr create --title "$TITLE" --description "$BODY" \
    --source-branch "$BRANCH" --target-branch "$BASE" --yes
else
  printf '%s' "$BODY" | "$BIN_DIR/hv-tracker-call" --provider github -- pr create --title "$TITLE" --body-file -
fi

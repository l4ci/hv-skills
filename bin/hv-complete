#!/usr/bin/env bash
# Move item to ## Completed with strikethrough and metadata.
# Idempotent: silent no-op if the ID is already completed.
# Errors only if the ID is not present at all (typo guard).
# Side effect: on the active→completed transition, bumps
# counters.json#since_refactor.{features,bugs} unless the resolved commit's
# subject starts with `refactor:` (those don't count toward refactor pressure).
# Writer helper: exit 0 on successful write OR idempotent no-op; exit 1 if ID is not present at all.
# Closure reason: --reason done|handed-off|blocked|dropped (default done) and
# an optional --note <text>. The Done marker gains ` (<reason>[: <note>])` only
# when the reason is not done; the default output is byte-identical.
# Usage: hv-complete <ID> [commit-hash] [--reason done|handed-off|blocked|dropped] [--note <text>]
set -euo pipefail
. "$(dirname "${BASH_SOURCE[0]}")/hv-preamble.sh"
USAGE="usage: hv-complete <ID> [commit-hash] [--reason done|handed-off|blocked|dropped] [--note <text>]"
REASON="done"
NOTE=""
POS=()
while [ $# -gt 0 ]; do
  case "$1" in
    --reason) [ $# -ge 2 ] || { echo "$USAGE" >&2; exit 1; }; REASON="$2"; shift 2 ;;
    --note)   [ $# -ge 2 ] || { echo "$USAGE" >&2; exit 1; }; NOTE="$2"; shift 2 ;;
    *) POS+=("$1"); shift ;;
  esac
done
case "$REASON" in
  done|handed-off|blocked|dropped) ;;
  *) echo "error: invalid --reason '$REASON'" >&2; echo "$USAGE" >&2; exit 1 ;;
esac
NOTE="$(printf '%s' "$NOTE" | tr '\n' ' ')"
[ "${#POS[@]}" -ge 1 ] && [ "${#POS[@]}" -le 2 ] || { echo "$USAGE" >&2; exit 1; }
ID="${POS[0]}"
HASH="${POS[1]:-$(git log --oneline -1 --format='%h' 2>/dev/null || true)}"
if [ -z "$HASH" ]; then
  echo "error: hv-complete needs a commit hash — pass one as arg2 or run from a repo with a commit history" >&2
  exit 1
fi
DATE=$(date +%Y-%m-%d)
PYTHONPATH="$HERE${PYTHONPATH:+:$PYTHONPATH}" python3 - "$ID" "$HASH" "$DATE" "$REASON" "$NOTE" <<'PY'
import re, subprocess, sys
from hvlib import find_section, write_text_atomic, update_json, format_done_line, parse_done_line, detail_dir_for_id, COUNTABLE_TYPES
id_s, hash_s, date_s, reason_s, note_s = sys.argv[1:6]
path = ".hv/BACKLOG.md"
with open(path) as f: content = f.read()

active = re.compile(r"^- \*\*\[" + re.escape(id_s) + r"\].*$", re.MULTILINE)
completed = re.compile(r"^- ~~\*\*\[" + re.escape(id_s) + r"\].*~~\s+Done\s+\d{4}-\d{2}-\d{2}", re.MULTILINE)

m = active.search(content)
if not m:
    # Already completed → silent no-op (idempotent; do not re-bump counter).
    if completed.search(content):
        sys.exit(0)
    # Nowhere to be found → typo guard.
    print(f"error: [{id_s}] not found", file=sys.stderr)
    sys.exit(1)

line = m.group(0)
content = content[:m.start()] + content[m.end()+1:]
done = format_done_line(line, date_s, hash_s, reason_s, note_s)
span = find_section(content, "Completed")
if span is None:
    content = content.rstrip("\n") + "\n\n## Completed\n\n" + done + "\n"
else:
    start, end = span
    content = content[:end].rstrip("\n") + "\n" + done + "\n" + content[end:]
write_text_atomic(path, content)

# Bump since_refactor counter unless this is a refactor: commit.
# Recognises all Conventional Commits refactor forms: plain, scoped,
# breaking-change, and scoped+breaking-change (refactor(scope)!:).
# Non-countable types (e.g. Tasks) don't carry a counter; skip the bump.
# counters.json keys are the detail-dir names ("bugs"/"features").
kind_key = detail_dir_for_id(id_s) if id_s[:1] in COUNTABLE_TYPES else None
if kind_key:
    subj = subprocess.run(["git", "log", "-1", "--format=%s", hash_s],
                          capture_output=True, text=True)
    if not (subj.returncode == 0 and re.match(r"^refactor(\(.+?\))?!?:", subj.stdout)):
        def bump(d):
            sr = d.setdefault("since_refactor", {"features": 0, "bugs": 0})
            sr[kind_key] = sr.get(kind_key, 0) + 1
        update_json(".hv/counters.json", {}, bump)
PY

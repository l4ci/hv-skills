#!/usr/bin/env bash
# Move item to ## Completed with strikethrough and metadata.
# Idempotent: silent no-op if the ID is already completed.
# Errors only if the ID is not present at all (typo guard).
# Side effect: on the active→completed transition, bumps
# counters.json#since_refactor.{features,bugs} unless the resolved commit's
# subject starts with `refactor:` (those don't count toward refactor pressure).
# Writer helper: exit 0 on successful write OR idempotent no-op; exit 1 if ID is not present at all.
# Closure reason: --reason done|handed-off|blocked|dropped (default done) and
# an optional --note <text>. The Done marker gains ` (<reason>[: <note>])` only
# when the reason is not done; the default output is byte-identical.
# Proof gate: a `done` close needs at least one row in the item's `## Proof` section
# (hv-proof-add / hv-proof-show); otherwise exit 3. --no-proof overrides. Other reasons
# (handed-off, blocked, dropped) have nothing to prove and skip the gate.
# Issue mode (backlog.backend "issues"): done closes the issue as completed with a "Done in `<hash>`"
# comment; dropped / handed-off close it as not planned with a "Closed: <reason>" comment; blocked keeps
# it open with the blocked label and a comment. Closing clears the in-progress / needs-review /
# changes-requested / blocked labels. Already closed (or already blocked) is a silent no-op.
# Tracker failures: exit 1, or 3 unavailable / 4 rate-limited.
# Usage: hv-complete <ID> [commit-hash] [--reason done|handed-off|blocked|dropped] [--note <text>] [--no-proof]
set -euo pipefail
. "$(dirname "${BASH_SOURCE[0]}")/hv-preamble.sh"
USAGE="usage: hv-complete <ID> [commit-hash] [--reason done|handed-off|blocked|dropped] [--note <text>] [--no-proof]"
REASON="done"
NOTE=""
NO_PROOF=""
POS=()
while [ $# -gt 0 ]; do
  case "$1" in
    --reason) [ $# -ge 2 ] || { echo "$USAGE" >&2; exit 1; }; REASON="$2"; shift 2 ;;
    --note)   [ $# -ge 2 ] || { echo "$USAGE" >&2; exit 1; }; NOTE="$2"; shift 2 ;;
    --no-proof) NO_PROOF=1; shift ;;
    *) POS+=("$1"); shift ;;
  esac
done
case "$REASON" in
  done|handed-off|blocked|dropped) ;;
  *) echo "error: invalid --reason '$REASON'" >&2; echo "$USAGE" >&2; exit 1 ;;
esac
NOTE="$(printf '%s' "$NOTE" | tr '\n' ' ')"
[ "${#POS[@]}" -ge 1 ] && [ "${#POS[@]}" -le 2 ] || { echo "$USAGE" >&2; exit 1; }
ID="${POS[0]}"
HASH="${POS[1]:-$(git log --oneline -1 --format='%h' 2>/dev/null || true)}"
if [ -z "$HASH" ]; then
  echo "error: hv-complete needs a commit hash — pass one as arg2 or run from a repo with a commit history" >&2
  exit 1
fi
DATE=$(date +%Y-%m-%d)
HV_PROOF_SHOW="$HERE/hv-proof-show" HV_NO_PROOF="$NO_PROOF" PYTHONPATH="$HERE${PYTHONPATH:+:$PYTHONPATH}" python3 - "$ID" "$HASH" "$DATE" "$REASON" "$NOTE" <<'PY'
import os, sys
from hvlib import get_backend, BackendUnavailable, ProofMissing, TrackerError, tracker_exit_code
id_s, hash_s, date_s, reason_s, note_s = sys.argv[1:6]
try:
    backend = get_backend()
except BackendUnavailable as e:
    sys.stderr.write(f"error: hv-complete: {e}\n"); sys.exit(2)
except ValueError as e:
    sys.stderr.write(f"error: hv-complete: {e}\n"); sys.exit(1)
proof_show = None if os.environ.get("HV_NO_PROOF") else os.environ["HV_PROOF_SHOW"]
try:
    # Already completed -> silent no-op (idempotent; the counter is not re-bumped).
    backend.complete(id_s, hash_s, date_s, reason_s, note_s, proof_show)
except BackendUnavailable as e:
    sys.stderr.write(f"error: hv-complete: {e}\n"); sys.exit(2)
except LookupError as e:
    print(f"error: {e.args[0]}", file=sys.stderr); sys.exit(1)
except TrackerError as e:
    sys.stderr.write(f"error: hv-complete: {e.message}\n"); sys.exit(tracker_exit_code(e))
except ProofMissing as e:
    print(f"error: {e.args[0]}", file=sys.stderr); sys.exit(3)
PY

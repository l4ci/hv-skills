#!/usr/bin/env bash
# Build a PR body for a branch: "## Summary" (commit subjects) and
# "## Items resolved" (IDs with titles pulled from TODO.md / ARCHIVE.md).
# Skips merge commits. Caller appends "## Test plan".
# Usage: hv-ship-body <branch>
# Prints: markdown body on stdout.
set -euo pipefail
HERE="$(cd "$(dirname "$0")" && pwd)"
# Route umbrella discovery through hv-resolve-umbrella (mirrors hv-review-scope)
# so TODO/ARCHIVE reads find the umbrella root, not a sub-repo cwd.
UMBRELLA_CWD="$("$HERE/hv-resolve-umbrella" 2>/dev/null || pwd -P)"
. "$HERE/hv-types.sh"
BRANCH="${1:?usage: hv-ship-body <branch>}"

"$HERE/hv-require-git-context" "hv-ship-body"

BASE=$("$HERE/hv-base-branch")

git rev-parse --verify "$BRANCH" >/dev/null 2>&1 || {
  echo "error: branch '$BRANCH' not found" >&2
  exit 1
}

export HV_BRANCH="$BRANCH" HV_BASE="$BASE"
HV_SUBJECTS=$(git log --no-merges --format='%s' "$BASE..$BRANCH")
HV_BODIES=$(git log --no-merges --format='%B' "$BASE..$BRANCH")
export HV_SUBJECTS HV_BODIES

export PYTHONPATH="$HERE"
export UMBRELLA_CWD
python3 - <<'PY'
import os, re, sys
from hvlib import find_origin_bullet, load_backlog_corpus, find_item_ids

branch = os.environ["HV_BRANCH"]
subjects = [l for l in os.environ["HV_SUBJECTS"].splitlines() if l.strip()]
full = os.environ["HV_BODIES"]

if not subjects:
    print(f"error: no commits between base and {branch}", file=sys.stderr)
    sys.exit(1)

print("## Summary")
print()
for line in subjects:
    print(f"- {line.strip()}")
print()

ordered = find_item_ids(full, os.environ["HV_ITEM_TYPES"])

if not ordered:
    sys.exit(0)

umbrella = os.environ.get("UMBRELLA_CWD", ".")
corpus = load_backlog_corpus(umbrella)

bullets = {iid: find_origin_bullet(corpus, iid) for iid in ordered}

print("## Items resolved")
print()
for iid in ordered:
    result = bullets[iid]
    title = result[1] if result else None
    print(f"- [{iid}] {title}" if title else f"- [{iid}]")
print()

gh_re = re.compile(r"GH:\s*#(\d+)")
gh_seen, gh_ordered = set(), []
for iid in ordered:
    result = bullets[iid]
    if not result:
        continue
    line = result[0]
    for match in gh_re.finditer(line):
        num = match.group(1)
        if num not in gh_seen:
            gh_seen.add(num)
            gh_ordered.append(num)

if gh_ordered:
    for num in gh_ordered:
        print(f"Closes #{num}")
    print()
PY

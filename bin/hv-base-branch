#!/usr/bin/env bash
# Print the resolved base branch (main, master, trunk, or origin/HEAD).
# Resolve helper: exits 1 with stderr if no base branch can be resolved or cwd lacks git.
# Respects git.baseBranch in .hv/config.json when set.
# Usage: hv-base-branch
# Exits 1 with a stderr message if none can be resolved or cwd lacks git.
set -euo pipefail
HERE="$(cd "$(dirname "$0")" && pwd)"

# Guard runs against user's actual cwd — must precede any cd.
"$HERE/hv-require-git-context" "hv-base-branch"

# hv-resolve-umbrella walks from cwd via `pwd -P`, so it correctly anchors on
# the user's working directory rather than the helper's install dir, and
# additionally detects masked sub-repo .hv/ shadows in umbrella mode. Falsy on
# miss (exit 1) or masking (exit 2) → CONFIGURED stays empty → fall through.
UMBRELLA=$("$HERE/hv-resolve-umbrella" 2>/dev/null || true)
CONFIGURED=""
if [ -n "$UMBRELLA" ]; then
  CONFIGURED=$(PYTHONPATH="$HERE${PYTHONPATH:+:$PYTHONPATH}" python3 - "$UMBRELLA" <<'PY'
import sys
from pathlib import Path
from hvlib import load_config
cfg_path = Path(sys.argv[1]) / ".hv" / "config.json"
cfg = load_config(cfg_path)
print(cfg.get("git", {}).get("baseBranch", ""))
PY
  )
fi

if [ -n "$CONFIGURED" ] && git rev-parse --verify "$CONFIGURED" >/dev/null 2>&1; then
  echo "$CONFIGURED"
  exit 0
fi
for candidate in main master trunk; do
  if git rev-parse --verify "$candidate" >/dev/null 2>&1; then
    echo "$candidate"
    exit 0
  fi
done
REMOTE_HEAD=$(git symbolic-ref refs/remotes/origin/HEAD 2>/dev/null || true)
if [ -n "$REMOTE_HEAD" ]; then
  echo "${REMOTE_HEAD#refs/remotes/origin/}"
  exit 0
fi
echo "error: could not determine base branch (tried main, master, trunk, origin/HEAD)" >&2
exit 1

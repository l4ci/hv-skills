#!/usr/bin/env bash
# Print the resolved base branch (main, master, trunk, or origin/HEAD).
# Respects git.baseBranch in .hv/config.json when set.
# Usage: hv-base-branch
# Exits 1 with a stderr message if none can be resolved.
set -euo pipefail
HERE="$(cd "$(dirname "$0")" && pwd)"
CONFIGURED=$(PYTHONPATH="$HERE${PYTHONPATH:+:$PYTHONPATH}" python3 -c "
import os
from pathlib import Path
from hvlib import load_json

d = Path.cwd().resolve()
while True:
    cfg_path = d / '.hv' / 'config.json'
    if cfg_path.exists():
        cfg = load_json(cfg_path, {})
        print(cfg.get('git', {}).get('baseBranch', ''))
        break
    if d == d.parent:
        # reached fs root, no config found
        print('')
        break
    d = d.parent
" 2>/dev/null || true)
if [ -n "$CONFIGURED" ] && git rev-parse --verify "$CONFIGURED" >/dev/null 2>&1; then
  echo "$CONFIGURED"
  exit 0
fi
for candidate in main master trunk; do
  if git rev-parse --verify "$candidate" >/dev/null 2>&1; then
    echo "$candidate"
    exit 0
  fi
done
REMOTE_HEAD=$(git symbolic-ref refs/remotes/origin/HEAD 2>/dev/null || true)
if [ -n "$REMOTE_HEAD" ]; then
  echo "${REMOTE_HEAD#refs/remotes/origin/}"
  exit 0
fi
echo "error: could not determine base branch (tried main, master, trunk, origin/HEAD)" >&2
exit 1

#!/usr/bin/env bash
# Print the resolved base branch (main, master, trunk, or origin/HEAD).
# Respects git.baseBranch in .hv/config.json when set.
# Usage: hv-base-branch
# Exits 1 with a stderr message if none can be resolved or cwd lacks git.
set -euo pipefail
HERE="$(cd "$(dirname "$0")" && pwd)"

# Guard runs against user's actual cwd — must precede any cd.
"$HERE/hv-require-git-context" "hv-base-branch"

# Walk up from cwd (NOT from helper location) to find the umbrella config.
# hv-self-locate.sh walks up from the helper's install dir, which finds the
# wrong .hv/ when the helper runs from canonical source bin/ next to the
# project's own .hv/. The user's cwd is the authoritative anchor here.
CONFIGURED=$(PYTHONPATH="$HERE${PYTHONPATH:+:$PYTHONPATH}" python3 - <<'PY'
from pathlib import Path
from hvlib import load_json
d = Path.cwd().resolve()
while True:
    cfg_path = d / ".hv" / "config.json"
    if cfg_path.exists():
        cfg = load_json(cfg_path, {})
        print(cfg.get("git", {}).get("baseBranch", ""))
        break
    if d == d.parent:
        print("")
        break
    d = d.parent
PY
)

if [ -n "$CONFIGURED" ] && git rev-parse --verify "$CONFIGURED" >/dev/null 2>&1; then
  echo "$CONFIGURED"
  exit 0
fi
for candidate in main master trunk; do
  if git rev-parse --verify "$candidate" >/dev/null 2>&1; then
    echo "$candidate"
    exit 0
  fi
done
REMOTE_HEAD=$(git symbolic-ref refs/remotes/origin/HEAD 2>/dev/null || true)
if [ -n "$REMOTE_HEAD" ]; then
  echo "${REMOTE_HEAD#refs/remotes/origin/}"
  exit 0
fi
echo "error: could not determine base branch (tried main, master, trunk, origin/HEAD)" >&2
exit 1

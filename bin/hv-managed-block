#!/usr/bin/env bash
# Regenerate a managed <!-- hv-<key>-start -->...<!-- hv-<key>-end --> block in CLAUDE.md.
# Atomic-merge helper: regenerates a named managed block in CLAUDE.md; exit 0 on success, 1 on unknown key.
# Usage: hv-managed-block <key>                        # flat list of ## headings from registered source
#        hv-managed-block <key> --body-stdin           # caller-rendered body via stdin
#        hv-managed-block --strip-deprecated           # remove blocks for v3-cut keys (B09)
# Keys: knowledge | decisions | vision | map | qa (vision, map, qa are body-stdin only).
# Prints: created | updated | appended (regenerator modes); stripped: <key> (strip mode).
set -euo pipefail

# Strip-deprecated mode: remove managed blocks for v3 keys that no v4
# helper regenerates (B09 defect 1). Runs before any positional parsing
# so the bare flag invocation doesn't trip the usage check below.
if [ "${1:-}" = "--strip-deprecated" ]; then
  . "$(dirname "${BASH_SOURCE[0]}")/hv-preamble.sh"
  PYTHONPATH="$HERE${PYTHONPATH:+:$PYTHONPATH}" python3 - <<'PY'
import re
from pathlib import Path
from hvlib import write_text_atomic

# Hardcoded list of managed-block keys that previous hv-skills versions
# wrote to CLAUDE.md but no v4 helper regenerates. Add new entries here
# when future cuts orphan a managed block.
DEPRECATED_KEYS = ["context"]

claude = Path("CLAUDE.md")
if not claude.exists():
    raise SystemExit(0)

content = claude.read_text()
new_content = content
for key in DEPRECATED_KEYS:
    # Match both canonical `hv-<key>-start/-end` and legacy `hv:<key>:start/:end`.
    pattern = re.compile(
        rf"<!-- hv(?:-{re.escape(key)}-start|:{re.escape(key)}:start) -->"
        rf".*?"
        rf"<!-- hv(?:-{re.escape(key)}-end|:{re.escape(key)}:end) -->\n?",
        re.DOTALL,
    )
    new_content, n = pattern.subn("", new_content)
    if n:
        print(f"stripped: {key}")

if new_content != content:
    # Collapse any 3+ consecutive blank lines left behind by the strip down
    # to exactly two blank lines, keeping the surrounding doc readable.
    new_content = re.sub(r"\n{3,}", "\n\n", new_content)
    write_text_atomic(str(claude), new_content)
PY
  exit 0
fi

KEY="${1:?usage: hv-managed-block <key> [--body-stdin]   |   hv-managed-block --strip-deprecated}"
MODE="${2:-}"
. "$(dirname "${BASH_SOURCE[0]}")/hv-preamble.sh"

if [ "$MODE" = "--body-stdin" ]; then
  _BODY_TMP=$(mktemp)
  trap 'rm -f "$_BODY_TMP"' EXIT
  cat > "$_BODY_TMP"
  PYTHONPATH="$HERE${PYTHONPATH:+:$PYTHONPATH}" python3 - "$KEY" "$_BODY_TMP" <<'PY'
import sys
from pathlib import Path
from hvlib import upsert_block

key = sys.argv[1]
body = Path(sys.argv[2]).read_text().rstrip("\n")

block = f"<!-- hv-{key}-start -->\n{body}\n<!-- hv-{key}-end -->"

status = upsert_block(Path("CLAUDE.md"), key, block)
print(status)
PY
else
  PYTHONPATH="$HERE${PYTHONPATH:+:$PYTHONPATH}" python3 - "$KEY" <<'PY'
import sys
from pathlib import Path
from hvlib import iter_topics, upsert_block

REGISTRY = {
    "knowledge": {
        "source":  ".hv/KNOWLEDGE.md",
        "heading": "## Project Knowledge",
        "intro":   "Durable learnings live in `.hv/KNOWLEDGE.md`. Consult it when work touches these topics:",
        "empty":   "- _(no topics yet — run `/hv-learn` to capture learnings)_",
        "legacy_marker": "knowledge",
    },
    "decisions": {
        "source":  ".hv/DECISIONS.md",
        "heading": "## Project Decisions",
        "intro":   "Hard boundaries live in `.hv/DECISIONS.md`. Consult them before acting on work that touches these topics:",
        "empty":   "- _(no decisions yet — run `/hv-decide` to capture a hard boundary)_",
    },
}

key = sys.argv[1]
if key not in REGISTRY:
    print(f"error: unknown key '{key}' (known: {', '.join(REGISTRY)})", file=sys.stderr)
    sys.exit(1)

cfg = REGISTRY[key]
source = Path(cfg["source"])
topics = []
if source.exists():
    for name, _body in iter_topics(source.read_text()):
        topics.append(name)

body = "\n".join(f"- {t}" for t in topics) if topics else cfg["empty"]

block = (
    f"<!-- hv-{key}-start -->\n"
    f"{cfg['heading']}\n\n"
    f"{cfg['intro']}\n\n"
    f"{body}\n\n"
    f"<!-- hv-{key}-end -->"
)

status = upsert_block(Path("CLAUDE.md"), key, block, legacy_marker=cfg.get("legacy_marker"))
print(status)
PY
fi

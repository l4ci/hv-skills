#!/usr/bin/env bash
# Remove a design file.
# Writer helper: exit 0 on successful removal; exit 1 when design ID not found.
# Usage: hv-design-rm <ID>     (e.g. hv-design-rm F58)
set -euo pipefail
. "$(dirname "${BASH_SOURCE[0]}")/hv-preamble.sh"
. "$HERE/hv-artifact-rm.sh"
ID="${1:?usage: hv-design-rm <ID>}"
# Issue mode: the design is a note on the item's issue.
if PYTHONPATH="$HERE${PYTHONPATH:+:$PYTHONPATH}" python3 -m hvlib_backend is-issues; then
PYTHONPATH="$HERE${PYTHONPATH:+:$PYTHONPATH}" python3 - "$ID" <<'PY'
import sys
from hvlib import get_backend, BackendUnavailable, TrackerError, tracker_exit_code

ref = sys.argv[1]
try:
    backend = get_backend()
    if not backend.note_rm(ref, "design"):
        print("error: design note for %s not found" % ref, file=sys.stderr); sys.exit(1)
except BackendUnavailable as e:
    print(f"error: hv-design-rm: {e}", file=sys.stderr); sys.exit(2)
except TrackerError as e:
    print(f"error: hv-design-rm: {e.message}", file=sys.stderr); sys.exit(tracker_exit_code(e))
except LookupError as e:
    print(f"error: hv-design-rm: {e.args[0]}", file=sys.stderr); sys.exit(1)
PY
  exit $?
fi
hv_artifact_rm design "$ID" .hv/designs

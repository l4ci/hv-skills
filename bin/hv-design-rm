#!/usr/bin/env bash
# Remove a design file.
# Writer helper: exit 0 on successful removal; exit 1 when design ID not found.
# Usage: hv-design-rm <ID>     (e.g. hv-design-rm F58)
set -euo pipefail
. "$(dirname "${BASH_SOURCE[0]}")/hv-preamble.sh"
. "$HERE/hv-artifact-rm.sh"
ID="${1:?usage: hv-design-rm <ID>}"
hv_artifact_rm design "$ID" .hv/designs

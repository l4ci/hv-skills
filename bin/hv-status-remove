#!/usr/bin/env bash
# Remove an active entry from .hv/status.json by branch (and optional repo),
# and sweep the matching .hv/handoff/<branch>[@<repo>].md note so a stale handoff
# from /hv-pause doesn't outlive the branch it was written against.
# Writer helper: exit 0 always; no-op if entry absent.
# Usage: hv-status-remove [--repo <name>] <branch>
#   --repo  Match only entries tagged with this sub-repo. Without --repo, only legacy
#          entries (repo: null/missing) are removed; umbrella entries are preserved.
set -euo pipefail
HERE="$(cd "$(dirname "$0")" && pwd)"
. "$HERE/hv-self-locate.sh"
hv_self_locate
REPO=""
if [ "${1:-}" = "--repo" ]; then REPO="${2:?usage: hv-status-remove [--repo <name>] <branch>}"; shift 2; fi
BRANCH="${1:?usage: hv-status-remove [--repo <name>] <branch>}"
PYTHONPATH="$HERE${PYTHONPATH:+:$PYTHONPATH}" python3 - "$BRANCH" "$REPO" <<'PY'
import sys
from pathlib import Path
from hvlib import load_json, dump_json_atomic
branch, repo = sys.argv[1], sys.argv[2]
path = Path(".hv/status.json")
if not path.exists():
    sys.exit(0)
data = load_json(path, {"active": []})
before = data.get("active", [])
after = [e for e in before if not (e.get("branch") == branch and (e.get("repo") or None) == (repo or None))]
if before == after:
    sys.exit(0)
data["active"] = after
dump_json_atomic(path, data)
PY
# Sweep matching handoff note. Path encoding mirrors hv-pause:
#   --repo set      → .hv/handoff/<branch>@<repo>.md   (umbrella keying)
#   --repo unset    → .hv/handoff/<branch>.md          (single-repo / legacy)
# `rm -f` is silent on missing files, so the sweep is a no-op when no handoff was paused.
if [ -n "$REPO" ]; then
  HANDOFF=".hv/handoff/${BRANCH}@${REPO}.md"
else
  HANDOFF=".hv/handoff/${BRANCH}.md"
fi
rm -f "$HANDOFF"

#!/usr/bin/env bash
# Slot reset guard for /hv-work worker slots: refuse to reuse a slot that still
# holds work, otherwise cut a fresh per-task branch from the cycle branch.
#
# A slot outlives a task. hv-worker-dispatch recreates the SESSION per task,
# but the worktree persists, so without this the next task inherits the last
# one's leftovers and hv-worker-gate only reports it later as STALE. The guard
# refuses (exit 3) when the slot's worktree has
#   - uncommitted changes (`git status --porcelain`, untracked files included), or
#   - commits that never reached the base (`git cherry <base> HEAD` shows `+`).
# Otherwise it moves the worktree onto a fresh branch cut from the current tip
# of slot.base and records that branch in .hv/workers.json, where
# hv-worker-gate reads it.
#
# The base is the slot's cycle branch, not origin/main: a cycle branch is local
# and is where hv-worker-gate lands finished work. `git cherry` compares by
# patch, so a rebased or cherry-picked merge counts as merged; a squash merge
# does not and is refused — land it by hand or `hv-worker-pool reap --slot`.
#
# Branch name: hv-worker/<slot>-<task> for a task, hv-worker/<slot> without one.
# (Not hv-worker/<slot>/<task>: git cannot hold both refs.) The previous
# per-task branch is deleted once the guard has proved it merged.
#
# Tool: exit 0 on a clean (or reset) slot; exit 2 on usage error;
#       exit 3 when the slot holds work or git fails.
#
# Usage:
#   hv-worker-reset --slot <name> [--task <id>] [--check-only]
set -euo pipefail
. "$(dirname "${BASH_SOURCE[0]}")/hv-preamble.sh"

USAGE="usage: hv-worker-reset --slot <name> [--task <id>] [--check-only]"

SLOT=""
TASK=""
CHECK_ONLY=0

while [ $# -gt 0 ]; do
  case "$1" in
    --slot)       SLOT="${2:?$USAGE}"; shift 2 ;;
    --task)       TASK="${2:?$USAGE}"; shift 2 ;;
    --check-only) CHECK_ONLY=1; shift ;;
    --)           shift; break ;;
    -*)           echo "error: unknown flag $1" >&2; exit 2 ;;
    *)            echo "error: unexpected positional $1" >&2; exit 2 ;;
  esac
done

[ -n "$SLOT" ] || { echo "$USAGE" >&2; exit 2; }

REGISTRY=".hv/workers.json"
[ -f "$REGISTRY" ] || { echo "error: no worker pool — run hv-worker-pool init first" >&2; exit 3; }

SLOT_INFO="$(PYTHONPATH="$HERE${PYTHONPATH:+:$PYTHONPATH}" python3 - "$REGISTRY" "$SLOT" <<'PY'
import sys
from pathlib import Path
from hvlib import load_json
data = load_json(Path(sys.argv[1]), {"slots": []})
slot = next((s for s in data.get("slots", []) if s.get("name") == sys.argv[2]), None)
if slot is None:
    raise SystemExit(1)
print("\t".join([slot.get("worktree") or "-", slot.get("base") or "-", slot.get("branch") or "-"]))
PY
)" || { echo "error: slot '$SLOT' is not in the pool" >&2; exit 3; }

IFS="$(printf '\t')" read -r WORKTREE BASE OLD_BRANCH <<EOF
$SLOT_INFO
EOF
[ "$BASE" = "-" ] && BASE=""
[ "$OLD_BRANCH" = "-" ] && OLD_BRANCH=""

[ -d "$WORKTREE" ] || { echo "error: slot '$SLOT' worktree missing: $WORKTREE" >&2; exit 3; }
[ -n "$BASE" ] && git rev-parse --verify --quiet "$BASE^{commit}" >/dev/null || {
  echo "error: slot '$SLOT' base '$BASE' does not exist" >&2; exit 3; }

DIRTY="$(git -C "$WORKTREE" status --porcelain)"
if [ -n "$DIRTY" ]; then
  echo "REFUSED $SLOT — uncommitted changes in $WORKTREE:" >&2
  printf '%s\n' "$DIRTY" | sed 's/^/  /' >&2
  echo "Commit or discard them (or hv-worker-pool reap --slot $SLOT) before reusing the slot." >&2
  exit 3
fi

UNMERGED="$(git -C "$WORKTREE" cherry "$BASE" HEAD | sed -n 's/^+ //p')"
if [ -n "$UNMERGED" ]; then
  echo "REFUSED $SLOT — $(printf '%s\n' "$UNMERGED" | wc -l | tr -d ' ') commit(s) not on $BASE:" >&2
  printf '%s\n' "$UNMERGED" | while read -r sha; do
    git -C "$WORKTREE" log -1 --format='  %h %s' "$sha" >&2
  done
  echo "Gate and merge them (hv-worker-gate), or hv-worker-pool reap --slot $SLOT, before reusing the slot." >&2
  exit 3
fi

[ "$CHECK_ONLY" -eq 0 ] || exit 0

if [ -n "$TASK" ]; then
  NEW_BRANCH="hv-worker/$SLOT-$(printf '%s' "$TASK" | tr '[:upper:]' '[:lower:]' | tr -c 'a-z0-9._\n-' '-')"
else
  NEW_BRANCH="hv-worker/$SLOT"
fi

git -C "$WORKTREE" switch -q -C "$NEW_BRANCH" "$BASE" || {
  echo "error: could not cut $NEW_BRANCH from $BASE in $WORKTREE" >&2; exit 3; }

# The old per-task branch was proved merged above; drop it so they don't pile up.
case "$OLD_BRANCH" in
  hv-worker/*) [ "$OLD_BRANCH" = "$NEW_BRANCH" ] || git branch -D "$OLD_BRANCH" >/dev/null 2>&1 || true ;;
esac

PYTHONPATH="$HERE${PYTHONPATH:+:$PYTHONPATH}" python3 - "$REGISTRY" "$SLOT" "$NEW_BRANCH" <<'PY'
import sys
from pathlib import Path
from hvlib import update_json
path, name, branch = sys.argv[1:4]
def mutator(data):
    for s in data.get("slots", []):
        if s.get("name") == name:
            s["branch"] = branch
update_json(Path(path), {"slots": []}, mutator)
PY
echo "reset: $SLOT on $NEW_BRANCH at $(git rev-parse --short "$BASE")"

#!/usr/bin/env bash
# Restore a Done line from BACKLOG.md ## Completed (or .hv/ARCHIVE.md) back
# to its active type section. Inverse of hv-complete.
# Idempotent: silent no-op if the ID is already active in BACKLOG.md.
# Side effect: on the completed→active transition, decrements
# counters.json#since_refactor.{features,bugs} unless the resolved commit's
# subject starts with `refactor:` (those didn't count toward refactor pressure).
# Writer helper: exit 0 on successful restore OR idempotent no-op; exit 1 if ID is not present in BACKLOG.md (Completed) or ARCHIVE.md.
# Usage: hv-uncomplete <ID>
set -euo pipefail
. "$(dirname "${BASH_SOURCE[0]}")/hv-preamble.sh"
ID="${1:?usage: hv-uncomplete <ID>}"
PYTHONPATH="$HERE${PYTHONPATH:+:$PYTHONPATH}" python3 - "$ID" <<'PY'
import sys
from hvlib import get_backend, BackendUnavailable
id_s = sys.argv[1]
try:
    backend = get_backend()
except BackendUnavailable as e:
    sys.stderr.write(f"error: hv-uncomplete: {e}\n"); sys.exit(2)
except ValueError as e:
    sys.stderr.write(f"error: hv-uncomplete: {e}\n"); sys.exit(1)
try:
    if backend.uncomplete(id_s) == "active":
        print(f"noop: [{id_s}] already active in BACKLOG.md", file=sys.stderr)
except (FileNotFoundError, LookupError, ValueError) as e:
    msg = f"{e.args[0]} not found" if isinstance(e, FileNotFoundError) else e.args[0]
    print(f"error: {msg}", file=sys.stderr); sys.exit(1)
PY

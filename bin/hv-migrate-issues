#!/usr/bin/env bash
# Move a file-backend project's open backlog onto the configured issue tracker.
# Drives IssueBackend directly, whatever backlog.backend says (provider: issues.provider / auto).
# Scope: open Bugs/Features/Tasks of .hv/BACKLOG.md become issues (type/priority/size labels, native
#   milestone, fields block, detail file as body); planned/active milestones (.hv/milestones/MNN.md)
#   become a native milestone + tracking issue with the same MNN and status. Completed items, ARCHIVE.md
#   and shipped/archived milestones stay in the files.
# Phases: (1) milestones, (2) items, (3) once every item and milestone exists: proof/design/plan notes,
#   slice plans (plan:SNN on the tracking issue), milestone plan bodies and Related fields, with old item
#   IDs rewritten to the new ones (exact ID tokens only; slice plans only `[ID]`, their task labels are T1...).
# Map: .hv/issue-map.json (tracked) {"<oldID>": {"id","number","url","done":[steps]}, "M07": {...}}, written after
#   every successful write. Old IDs are NOT resolved through it by other helpers. Re-run resumes from it;
#   a finished migration re-run makes no tracker calls and no file writes.
# Pacing: issues.bulkPaceMs (default 1000) between writes. A rate limit (4) stops the run with the map saved.
# --dry-run (default) prints every planned operation and the would-be map, makes no tracker call, writes nothing.
# --apply does the work; when everything is migrated it prepends a frozen banner to .hv/BACKLOG.md (once) and
#   prints the one-line config flip. It never changes backlog.backend.
# Writer helper: exit 0 on success; exit 1 on usage error, missing .hv/BACKLOG.md, umbrella mode (migrate each
#   sub-repo separately) or tracker failure; exit 3 tracker unavailable; exit 4 rate-limited (re-run to continue).
# Usage: hv-migrate-issues [--dry-run|--apply] [--limit N]
#   --limit N   create at most N items this run (the map lets the next run continue)
set -euo pipefail
. "$(dirname "${BASH_SOURCE[0]}")/hv-preamble.sh"
USAGE="usage: hv-migrate-issues [--dry-run|--apply] [--limit N]"
MODE="dry" LIMIT=""
while [ $# -gt 0 ]; do
  case "$1" in
    --dry-run) MODE=dry; shift ;;
    --apply) MODE=apply; shift ;;
    --limit) LIMIT="${2:?$USAGE}"; shift 2 ;;
    *) echo "$USAGE" >&2; exit 1 ;;
  esac
done
case "$LIMIT" in ""|*[!0-9]*) [ -z "$LIMIT" ] || { echo "error: hv-migrate-issues: --limit takes a number" >&2; exit 1; } ;; esac
PYTHONPATH="$HERE${PYTHONPATH:+:$PYTHONPATH}" python3 - "$MODE" "$LIMIT" <<'PY'
import json, re, sys, time
from datetime import date
from pathlib import Path
from hvlib import (IssueBackend, TrackerError, tracker_exit_code, tracker_label, config_value, load_config,
                   load_repos, iter_open_bullets, open_bullet_re, detail_dir_for_id, parse_frontmatter,
                   find_section, dump_json_atomic, load_json, write_text_atomic, ITEM_TYPES)

mode, limit_s = sys.argv[1:3]
apply = mode == "apply"
limit = int(limit_s) if limit_s else None
HV = Path(".hv")
MAP = HV / "issue-map.json"
BACKLOG = HV / "BACKLOG.md"

def die(msg, code=1):
    sys.stderr.write(f"error: hv-migrate-issues: {msg}\n"); sys.exit(code)

def warn(msg):
    sys.stderr.write(f"warning: hv-migrate-issues: {msg}\n")

if not BACKLOG.is_file():
    die(f"{BACKLOG} not found (nothing to migrate)")
if load_repos():
    die("umbrella mode: migrate each sub-repo separately (run hv-migrate-issues inside each sub-repo)")

cfg = load_config()
backend = IssueBackend(cfg)
pace = max(0, int(config_value(cfg, "issues.bulkPaceMs") or 0)) / 1000.0

def read(path):
    try:
        return path.read_text()
    except OSError:
        return None

# ---------------------------------------------------------------- planning
SECTION_KIND = {"Bugs": "bugs", "Features": "features", "Tasks": "tasks"}
KIND_TAGS = {"bugs": ("P0", "P1", "P2", "P3"), "features": ("Major", "Minor", "Cosmetic"), "tasks": ()}
FIELD_NAMES = ("Detail", "Related", "Milestone", "Repos", "Subsystem", "Captured", "Since")
FIELD_CUT = re.compile(r"\s(?:%s):" % "|".join(FIELD_NAMES))
items = []
for iid, line, fields, section in iter_open_bullets(BACKLOG.read_text()):
    kind = SECTION_KIND.get(section)
    m = open_bullet_re().match(line)
    if not kind or not m:
        continue
    tag = m.group("tag") or ""
    if tag and tag not in KIND_TAGS[kind]:
        warn(f"{iid}: tag [{tag}] is not valid for {kind}; dropped")
        tag = ""
    rest = m.group("rest")
    cut = FIELD_CUT.search(rest)
    desc = (rest[:cut.start()] if cut else rest).strip()
    f = {}
    for name in ("Related", "Repos", "Subsystem", "Captured"):
        v = fields.get(name.lower(), "").strip().rstrip(".").strip()
        if v:
            f[name] = v
    ms = re.match(r"M\d+", fields.get("milestone", "").strip())
    detail = read(HV / detail_dir_for_id(iid) / f"{iid}.md")
    proof = None
    if detail is not None:
        hm = re.search(r"^## Proof\s*$", detail, re.MULTILINE)
        span = find_section(detail, "Proof")
        if hm and span:
            proof = detail[hm.start():span[1]].strip()
            detail = (detail[:hm.start()] + detail[span[1]:]).strip("\n")
    plan = None
    for p in sorted((HV / "plans").glob(f"M*-{iid}.md")):
        if re.fullmatch(rf"M\d+-{iid}\.md", p.name):
            plan = read(p); break
    items.append({"id": iid, "kind": kind, "title": m.group("title").strip().rstrip(".").strip(),
                  "tag": tag, "desc": desc, "fields": f, "milestone": ms.group(0) if ms else "",
                  "body": detail.strip("\n") if detail and detail.strip() else None, "proof": proof,
                  "design": read(HV / "designs" / f"{iid}.md"), "plan": plan})

milestones = []
for p in sorted((HV / "milestones").glob("M*.md")):
    text = read(p) or ""
    fm, body = parse_frontmatter(text)
    mid = fm.get("id") or p.stem
    status = fm.get("status", "")
    if status not in ("planned", "active"):
        continue
    title = fm.get("title") or ""
    if not title:
        hm = re.search(r"^# M\d+\s*[—–-]\s*(.+)$", body, re.MULTILINE)
        title = hm.group(1).strip() if hm else mid
    gm = re.search(r"^## Goal\s*\n+(.+?)(?:\n\s*\n|\Z)", body, re.MULTILINE | re.DOTALL)
    summary = " ".join(gm.group(1).split()) if gm else title
    slices = []
    for sp in sorted((HV / "plans").glob(f"{mid}-S*.md")):
        sm = re.fullmatch(rf"{mid}-(S\d+)\.md", sp.name)
        if sm:
            slices.append((sm.group(1), read(sp) or ""))
    milestones.append({"id": mid, "title": title, "summary": summary, "status": status, "text": text,
                       "depends": re.findall(r"M\d+", str(fm.get("depends", ""))), "slices": slices})
migrating_ms = {m["id"] for m in milestones}

# ---------------------------------------------------------------- map
imap = load_json(str(MAP), {}) if MAP.exists() else {}
if not isinstance(imap, dict):
    die(f"{MAP} is not a JSON object")

def save_map():
    dump_json_atomic(MAP, imap)

TOKEN = re.compile(rf"(?<![\w/-])([{ITEM_TYPES}]\d+)(?!\w)(?!\.md)")
BRACKETED = re.compile(rf"\[([{ITEM_TYPES}]\d+)\]")

def new_ids():
    return {old: e["id"] for old, e in imap.items() if re.fullmatch(rf"[{ITEM_TYPES}]\d+", old)}

def rewrite(text, bracketed_only=False):
    ids = new_ids()
    if bracketed_only:
        return BRACKETED.sub(lambda m: "[" + ids.get(m.group(1), m.group(1)) + "]", text)
    return TOKEN.sub(lambda m: ids.get(m.group(1), m.group(1)), text)

# ---------------------------------------------------------------- operations
done_ops = 0
def op(desc, fn=None):
    """Print (dry) or run (apply, paced) one planned operation; returns fn's result."""
    global done_ops
    if not apply:
        print(desc)
        return None
    if done_ops and pace:
        time.sleep(pace)
    done_ops += 1
    print(desc, flush=True)
    return fn()

def step_done(old, step):
    e = imap.setdefault(old, {})
    e.setdefault("done", [])
    if step not in e["done"]:
        e["done"].append(step)
    save_map()

def has_step(old, step):
    return step in imap.get(old, {}).get("done", [])

def label_names(it):
    labels = [tracker_label(cfg, {"bugs": "types.bug", "features": "types.feature", "tasks": "types.task"}[it["kind"]])]
    if it["tag"] and it["kind"] == "bugs":
        labels.append(tracker_label(cfg, "priorityPrefix") + it["tag"][1:])
    elif it["tag"]:
        labels.append(tracker_label(cfg, "sizePrefix") + it["tag"])
    return labels

class Stop(Exception):
    pass

pending_items = 0
created_items = 0
milestone_cache = {}

def milestone_available(mid):
    if mid in imap or mid in migrating_ms:
        return True
    if not apply:
        return False
    if mid not in milestone_cache:
        milestone_cache[mid] = backend.adapter.find_milestone(mid) is not None
    return milestone_cache[mid]

def run():
    global pending_items, created_items
    # --- phase 1: milestones
    for m in milestones:
        mid = m["id"]
        if mid not in imap:
            def create_ms(m=m, mid=mid):
                backend.milestone_add(m["title"], m["summary"], m["depends"], mid=mid)
                issue = backend.tracker_issue(mid)
                imap[mid] = {"id": mid, "number": issue["number"], "url": issue["url"], "done": []}
                save_map()
            op(f"create milestone {mid} ({m['status']})", create_ms)
            if not apply:
                imap[mid] = {"id": mid, "number": "?", "url": "", "done": []}
        if m["status"] != "planned" and not has_step(mid, "status"):
            op(f"set milestone {mid} status {m['status']}",
               lambda mid=mid, m=m: (backend.milestone_status(mid, m["status"]), step_done(mid, "status")))
            if not apply:
                step_done_dry(mid, "status")
    # --- phase 2: items
    for it in items:
        old = it["id"]
        if old in imap:
            print(f"skip {old} (already migrated as {imap[old]['id']})")
            continue
        if limit is not None and created_items >= limit:
            pending_items += 1
            continue
        fields = dict(it["fields"])
        ms = it["milestone"]
        note = ""
        if ms:
            if milestone_available(ms):
                fields["Milestone"] = ms
                note = f" milestone {ms}"
            else:
                warn(f"{old}: milestone {ms} is not on the tracker (shipped/archived milestones are not migrated); Milestone field dropped")
        labels = ", ".join(label_names(it))
        def create_item(it=it, old=old, fields=fields):
            nid = backend.create(it["kind"], it["title"], it["tag"], it["desc"], fields,
                                 it["body"].encode() if it["body"] else None)
            n = int(nid[1:])
            url = backend.adapter.get(n)["url"]
            imap[old] = {"id": nid, "number": n, "url": url, "done": []}
            save_map()
        op(f'create issue {old} → {it["kind"][:-1]} "{it["title"]}" [{labels}]{note}', create_item)
        created_items += 1
        if not apply:
            imap[old] = {"id": f"{old[0]}?", "number": "?", "url": "", "done": []}
    if pending_items:
        return False
    # --- phase 3: notes, plans, Related (every id is in the map now)
    for it in items:
        old, nid = it["id"], imap[it["id"]]["id"]
        for kind, text in (("proof", it["proof"]), ("design", it["design"]), ("plan", it["plan"])):
            if text and text.strip() and not has_step(old, kind):
                body = text if kind == "proof" else rewrite(text)
                op(f"note {kind} on {old}",
                   lambda nid=nid, kind=kind, body=body, old=old: (backend.note_put(nid, kind, body), step_done(old, kind)))
                if not apply:
                    step_done_dry(old, kind)
        rel = it["fields"].get("Related", "")
        if rel and not has_step(old, "related"):
            new_rel = rewrite(rel)
            ids = [t for t in TOKEN.findall(rel) if t in imap]
            if new_rel != rel or not apply and ids:
                shown = ", ".join(f"{t} → {imap[t]['id'] if apply else '#?'}" for t in ids)
                op(f"rewrite Related on {old}: {shown}",
                   lambda nid=nid, new_rel=new_rel, old=old: (backend.set_field(nid, "related", new_rel), step_done(old, "related")))
                if not apply:
                    step_done_dry(old, "related")
            elif apply:
                step_done(old, "related")
    for m in milestones:
        mid = m["id"]
        if not has_step(mid, "body"):
            op(f"set plan body of milestone {mid}",
               lambda mid=mid, m=m: (put_milestone(mid, m), step_done(mid, "body")))
            if not apply:
                step_done_dry(mid, "body")
        for unit, text in m["slices"]:
            step = f"plan:{unit}"
            if text.strip() and not has_step(mid, step):
                op(f"note {step} on {mid}",
                   lambda mid=mid, unit=unit, text=text, step=step: (
                       backend.slice_put(mid, unit, rewrite(text, bracketed_only=True)), step_done(mid, step)))
                if not apply:
                    step_done_dry(mid, step)
    return True

def put_milestone(mid, m):
    try:
        backend.milestone_put(mid, rewrite(m["text"]))
    except ValueError as e:
        warn(f"{mid}: plan body not copied ({e})")

def step_done_dry(old, step):
    e = imap.setdefault(old, {})
    e.setdefault("done", []).append(step)

# ---------------------------------------------------------------- run
BANNER_PREFIX = "> Frozen:"
exit_code = 0
complete = False
try:
    complete = run()
except TrackerError as e:
    exit_code = tracker_exit_code(e)
    sys.stderr.write(f"error: hv-migrate-issues: {e.message}\n")
    if exit_code == 4:
        migrated = sum(1 for it in items if it["id"] in imap and imap[it["id"]].get("id"))
        print(f"rate limited: {migrated} of {len(items)} items migrated; the map is saved in {MAP}")
        print("re-run to continue")
    else:
        print(f"stopped on a tracker error; the map is saved in {MAP}; fix the cause and re-run to continue")

if not apply:
    print("would-be map:")
    shown = {k: {"id": v["id"], "number": v["number"], "url": v["url"]} for k, v in imap.items()
             if k in {i["id"] for i in items} | migrating_ms}
    print(json.dumps(shown, indent=2))
    sys.exit(0)
if exit_code:
    sys.exit(exit_code)
if not complete:
    print(f"{pending_items} items remaining; notes, plans and Related rewrites run once every item exists. re-run to continue")
    sys.exit(0)
text = BACKLOG.read_text()
if not text.lstrip().startswith(BANNER_PREFIX):
    banner = (f"{BANNER_PREFIX} this backlog moved to the issue tracker on {date.today().isoformat()} "
              f"(see .hv/issue-map.json). Edit issues, not this file.")
    write_text_atomic(BACKLOG, banner + "\n\n" + text)
    print("froze .hv/BACKLOG.md")
print("Next: /hv-config backlog.backend=issues")
PY

#!/usr/bin/env bash
# Verify .hv/ is initialized and helpers are present.
# Tool: exit 0 fully initialized; exit 2 uninitialized; exit 3 partial install.
# Exit 0: fully initialized  |  Exit 2: uninitialized  |  Exit 3: partial install
# Typical caller: `.hv/bin/hv-preflight || invoke hv-init via Skill tool`.
# Compares against the upstream plugin bin/ when running from .hv/bin/ to catch
# missing helpers; falls back to self-compare when upstream can't be resolved.
set -euo pipefail

HV=".hv"
SRC_BIN="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

if [ ! -d "$HV" ]; then
  echo "uninitialized: .hv/ directory missing" >&2
  exit 2
fi

for f in DECISIONS.md TODO.md KNOWLEDGE.md MILESTONES.md counters.json config.json status.json; do
  if [ ! -f "$HV/$f" ]; then
    echo "uninitialized: $HV/$f missing" >&2
    exit 2
  fi
done

# Umbrella consistency check.
#
# Truth source for "is this an umbrella?" is .hv/repos.json (>=1 registered
# repo) — see hv-umbrella-on. The config flag (umbrella.enabled) is
# informational; we still flag the misconfig where the flag is set but the
# data is missing or empty (that's an unfinished /hv-init).
#
# Cases:
#   flag=true,  data missing/empty → exit 2 (config says umbrella, finish init)
#   data present (any flag value)  → silent pass (data is umbrella regardless)
#   flag=false, data absent        → silent pass (single-repo, skip)
FLAG_ON=$(PYTHONPATH="$SRC_BIN${PYTHONPATH:+:$PYTHONPATH}" python3 -c "
from hvlib import load_json
cfg = load_json('$HV/config.json', {})
print('1' if cfg.get('umbrella', {}).get('enabled') else '0')
")
UMBRELLA_ON=$("$SRC_BIN/hv-umbrella-on")
if [ "$FLAG_ON" = "1" ] && [ "$UMBRELLA_ON" != "yes" ]; then
  if [ ! -f "$HV/repos.json" ]; then
    echo "uninitialized: umbrella.enabled is true but $HV/repos.json missing — re-run /hv-init from the umbrella root" >&2
  else
    echo "uninitialized: $HV/repos.json is empty or malformed — re-run /hv-init from the umbrella root" >&2
  fi
  exit 2
fi

# Resolve upstream plugin bin/. SRC_BIN points at the script's own dir, which
# is .hv/bin/ (the runtime mirror) when invoked via the documented path; we
# want the *upstream* plugin to compare against. Canonical resolver lives in
# bin/hv-resolve-plugin-root → hvlib.resolve_plugin_root and covers the full
# walk: HV_INSTALL_ROOT, CLAUDE_PLUGIN_ROOT, ~/.claude/plugins/*/hv-skills,
# plugin cache, ~/.agents/skills. Lookup helper, always exits 0; empty
# output means nothing found and we fall back to SRC_BIN.
UPSTREAM_BIN="$("$SRC_BIN/hv-resolve-plugin-root" --bin 2>/dev/null || true)"

# Pick the comparison source. Prefer upstream when it differs from SRC_BIN —
# that's the case where SRC_BIN is .hv/bin/ (runtime mirror) and we need to
# compare against the canonical plugin source. When upstream resolves to the
# same path (e.g., running hv-preflight directly from bin/ during development)
# or when upstream can't be resolved, fall back to SRC_BIN — current behavior.
COMPARE_BIN="$SRC_BIN"
if [ -n "$UPSTREAM_BIN" ] && [ "$UPSTREAM_BIN" != "$SRC_BIN" ]; then
  COMPARE_BIN="$UPSTREAM_BIN"
fi

# Auto-discover helpers from the comparison bin/ directory. Strips the bin/
# prefix and skips hv-preflight itself — preflight verifies every other helper,
# not itself. Source +x bit decides the check mode: executables need -x in
# .hv/bin/, libraries (e.g. hv-types.sh) only need -f.
missing=()
for src in "$COMPARE_BIN"/hv-*; do
  [ -e "$src" ] || continue
  name="${src##*/}"
  [ "$name" = "hv-preflight" ] && continue
  if [ -x "$src" ]; then
    [ -x "$HV/bin/$name" ] || missing+=("$name")
  else
    [ -f "$HV/bin/$name" ] || missing+=("$name")
  fi
done
[ -f "$HV/bin/hvlib.py" ] || missing+=("hvlib.py")
if [ ${#missing[@]} -gt 0 ]; then
  printf 'stale: missing helpers: %s\n' "${missing[*]}" >&2
  exit 3
fi

# Informational drift nudge; never blocks. Stderr keeps callers using
# command-substitution from accidentally consuming the line.
if [ -x "$COMPARE_BIN/hv-version-check" ]; then
  drift=$("$COMPARE_BIN/hv-version-check" 2>/dev/null || true)
  [ -n "$drift" ] && echo "$drift" >&2
fi

exit 0

#!/usr/bin/env bash
# Verify .hv/ is initialized and helpers are present.
# Exit 0: fully initialized  |  Exit 2: uninitialized  |  Exit 3: partial install
# Typical caller: `.hv/bin/hv-preflight || invoke hv-init via Skill tool`.
set -euo pipefail

HV=".hv"

if [ ! -d "$HV" ]; then
  echo "uninitialized: .hv/ directory missing" >&2
  exit 2
fi

for f in DECISIONS.md TODO.md KNOWLEDGE.md MILESTONES.md counters.json config.json status.json; do
  if [ ! -f "$HV/$f" ]; then
    echo "uninitialized: $HV/$f missing" >&2
    exit 2
  fi
done

UMBRELLA_ON=$(python3 -c "
import json
try:
    cfg = json.loads(open('.hv/config.json').read())
    print('1' if cfg.get('umbrella', {}).get('enabled') else '0')
except Exception:
    print('0')
")
if [ "$UMBRELLA_ON" = "1" ]; then
  if [ ! -f "$HV/repos.json" ]; then
    echo "uninitialized: umbrella.enabled is true but $HV/repos.json missing — re-run /hv-init from the umbrella root" >&2
    exit 2
  fi
  REPOS_OK=$(python3 -c "
import json
try:
    data = json.loads(open('.hv/repos.json').read())
    repos = data.get('repos', []) or []
    print('1' if any(e.get('name') and e.get('path') for e in repos) else '0')
except Exception:
    print('0')
")
  if [ "$REPOS_OK" != "1" ]; then
    echo "uninitialized: $HV/repos.json is empty or malformed — re-run /hv-init from the umbrella root" >&2
    exit 2
  fi
fi

# Auto-discover helpers from the source bin/ directory (the one currently being
# checked, alongside this script). Strips the bin/ prefix and skips hv-preflight
# itself — preflight verifies every other helper, not itself. Source +x bit
# decides the check mode: executables need -x in .hv/bin/, libraries (e.g.
# hv-types.sh) only need -f.
SRC_BIN="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
missing=()
for src in "$SRC_BIN"/hv-*; do
  [ -e "$src" ] || continue
  name="${src##*/}"
  [ "$name" = "hv-preflight" ] && continue
  if [ -x "$src" ]; then
    [ -x "$HV/bin/$name" ] || missing+=("$name")
  else
    [ -f "$HV/bin/$name" ] || missing+=("$name")
  fi
done
[ -f "$HV/bin/hvlib.py" ] || missing+=("hvlib.py")
if [ ${#missing[@]} -gt 0 ]; then
  printf 'stale: missing helpers: %s\n' "${missing[*]}" >&2
  exit 3
fi

exit 0

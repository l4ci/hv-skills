#!/usr/bin/env bash
# Add or update a single term entry in the ## Glossary topic of .hv/KNOWLEDGE.md.
# Writer helper: exit 0 on successful write; exit 2 on usage error, 3 on alias collision.
#
# Usage: hv-glossary-write <term> --def <text> [--alias <a>,...] [--not <n>,...] [--touch]
#                          [--repo umbrella|<name>]
#
# For atomic multi-term import use `hv-glossary-import <manifest>` — the batch
# path was split out so its validator and this single-write path can evolve
# independently.
#
# Entry format inside the target `## Glossary`:
#   - **<term>** — <definition>
#     - **Aliases:** X, Y    (or _none_ if empty)
#     - **Not:** Z           (line omitted when empty)
#     <!-- YYYY-MM-DD -->
#
# Definition rules:
#   - new term  → insert nested-bullet alphabetically; today's date stamp
#   - existing  → replace definition; union aliases; union nots; date stamp
#                 preserved unless --touch; --not "" clears the Not list
#
# Refuses (exit 3) when an alias would collide with another term's alias in the
# same Glossary topic (cross-term uniqueness).
#
# Regenerates the CLAUDE.md hv-knowledge block on success (Glossary surfaces
# as a topic name through hv-managed-block knowledge — terms themselves are not listed).
set -euo pipefail

USAGE="usage: hv-glossary-write <term> --def <text> [--alias …] [--not …] [--touch] [--repo umbrella|<name>]"

TERM=""
DEF=""
ALIASES_RAW=""
NOTS_RAW=""
TOUCH="false"
NOTS_PROVIDED="false"
REPO_FLAG=""

while [ $# -gt 0 ]; do
  case "$1" in
    --def)   DEF="$2"; shift 2 ;;
    --alias) ALIASES_RAW="$2"; shift 2 ;;
    --not)   NOTS_RAW="$2"; NOTS_PROVIDED="true"; shift 2 ;;
    --touch) TOUCH="true"; shift ;;
    --repo)  REPO_FLAG="${2:?$USAGE}"; shift 2 ;;
    --batch) echo "error: --batch was split out — call hv-glossary-import <manifest> directly" >&2; exit 2 ;;
    --) shift; break ;;
    -*) echo "error: unknown flag $1" >&2; exit 2 ;;
    *) [ -z "$TERM" ] && TERM="$1" || { echo "error: unexpected positional $1" >&2; exit 2; }; shift ;;
  esac
done

. "$(dirname "${BASH_SOURCE[0]}")/hv-preamble.sh"
. "$HERE/hv-knowledge-scope.sh"
SCOPE="$(hv_resolve_knowledge_scope "$REPO_FLAG")"

TARGET="$(hv_resolve_knowledge_path "$SCOPE")" || exit $?

[ -f "$TARGET" ] || { echo "error: $TARGET missing — run /hv-init first" >&2; exit 2; }

[ -n "$TERM" ] || { echo "$USAGE" >&2; exit 2; }
[ -n "$DEF" ]  || { echo "error: --def is required" >&2; exit 2; }

PYTHONPATH="$HERE${PYTHONPATH:+:$PYTHONPATH}" python3 - "$TERM" "$DEF" "$ALIASES_RAW" "$NOTS_RAW" "$NOTS_PROVIDED" "$TOUCH" "$TARGET" <<'PY'
import datetime as dt
import sys
from pathlib import Path
from hvlib import (
    check_alias_collisions, find_section, merge_into_by_key,
    parse_glossary_entries, render_glossary_body, replace_section,
    split_csv_list, write_text_atomic,
)

term, definition, aliases_raw, nots_raw, nots_provided, touch_flag, target = sys.argv[1:]
target_path = Path(target)
nots_provided = (nots_provided == "true")
touch = (touch_flag == "true")

text = target_path.read_text()
span = find_section(text, "Glossary")
if span is None:
    print(f"error: ## Glossary topic missing from {target} — run /hv-init or add the heading manually", file=sys.stderr)
    sys.exit(2)
start, end = span
entries, leading = parse_glossary_entries(text[start:end])

candidate = {
    "name": term,
    "definition": definition,
    "aliases": split_csv_list(aliases_raw),
    "nots": split_csv_list(nots_raw),
}

conflicts = check_alias_collisions(entries, [candidate])
if conflicts:
    import re
    m = re.search(r"alias '([^']+)' on '[^']+' collides with existing term '([^']+)'", conflicts[0])
    if m:
        print(
            f"error: alias '{m.group(1)}' is already an alias of term "
            f"'{m.group(2)}' — refuse to write",
            file=sys.stderr,
        )
    else:
        print(f"error: {conflicts[0]}", file=sys.stderr)
    sys.exit(3)

today = dt.date.today().isoformat()
by_key = {e["name"].lower(): e for e in entries}
by_key = merge_into_by_key(by_key, [candidate], today, touch=touch, nots_provided=nots_provided)

new_body = render_glossary_body(by_key, leading, today)
new_text = replace_section(text, "Glossary", new_body)
write_text_atomic(target_path, new_text)
new_name = by_key[term.lower()]["name"]
print(f"wrote: Glossary/{new_name}", file=sys.stderr)
PY

# Regenerate the hv-knowledge CLAUDE.md managed block so the topic list
# stays current (Glossary surfaces automatically since it's just a topic).
"$HERE/hv-managed-block" knowledge --repo "$SCOPE" >/dev/null

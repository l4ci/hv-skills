#!/usr/bin/env bash
# List spikes from .hv/spikes/*.md as JSON.
# Each entry: { name, branch, status, created, branchExists }.
# Usage: hv-spike-list
set -euo pipefail
HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
RAW=$("$HERE/hv-fm-list" .hv/spikes name branch status created)
python3 - "$RAW" <<'PY'
import json, subprocess, sys
from pathlib import Path

def existing_spike_branches():
    try:
        out = subprocess.check_output(
            ["git", "for-each-ref", "--format=%(refname:short)", "refs/heads/spike/"],
            text=True,
        )
        return set(line.strip() for line in out.splitlines() if line.strip())
    except (subprocess.CalledProcessError, FileNotFoundError):
        return set()

existing = existing_spike_branches()
items = []
for fm in json.loads(sys.argv[1]):
    stem = Path(fm["_path"]).stem
    branch = fm.get("branch") or f"spike/{stem}"
    items.append({
        "name":        fm.get("name") or stem,
        "branch":      branch,
        "status":      fm.get("status") or "open",
        "created":     fm.get("created", ""),
        "branchExists": branch in existing,
    })
print(json.dumps(items, indent=2))
PY

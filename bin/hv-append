#!/usr/bin/env bash
# Append entry to a section in .hv/TODO.md.
# Usage: hv-append "## Bugs" "- **[B07] [P1] Title.** Desc."
set -euo pipefail
HERE="$(cd "$(dirname "$0")" && pwd)"
. "$HERE/hv-self-locate.sh"
hv_self_locate
SECTION="${1:?usage: hv-append <section> <entry>}"
ENTRY="${2:?usage: hv-append <section> <entry>}"
PYTHONPATH="$HERE${PYTHONPATH:+:$PYTHONPATH}" python3 - "$SECTION" "$ENTRY" <<'PY'
import sys
from hvlib import find_section, write_text_atomic
sec, entry, path = sys.argv[1], sys.argv[2], ".hv/TODO.md"
name = sec[3:] if sec.startswith("## ") else sec
content = open(path).read()
span = find_section(content, name)
if span is None:
    print(f"error: section '{sec}' not found", file=sys.stderr); sys.exit(1)
start, end = span
tail = "\n" + content[end:] if content[end:] else ""
content = content[:end].rstrip("\n") + "\n" + entry + "\n" + tail
write_text_atomic(path, content)
PY

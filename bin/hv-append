#!/usr/bin/env bash
# Append entry to a section in .hv/BACKLOG.md.
# Auto-stamps `Since: <short-hash>` (HEAD at capture time) on bullets that
# don't already carry the field, when invoked inside a git repo with at
# least one commit. The Since anchor lets hv-todo-drift ignore commits
# older than capture (prevents ID-reuse false-positives across machine syncs).
# Writer helper: exit 0 on successful append, 1 on missing section or missing argv.
# Usage: hv-append "## Bugs" "- **[B07] [P1] Title.** Desc."
set -euo pipefail
. "$(dirname "${BASH_SOURCE[0]}")/hv-preamble.sh"
SECTION="${1:?usage: hv-append <section> <entry>}"
ENTRY="${2:?usage: hv-append <section> <entry>}"

# Auto-stamp Since: <short-hash> when entry is a bullet without it AND HEAD exists.
if [[ "$ENTRY" == "- "* ]] && [[ "$ENTRY" != *"Since:"* ]]; then
  if SINCE_HASH="$(git rev-parse --short HEAD 2>/dev/null)" && [ -n "$SINCE_HASH" ]; then
    ENTRY="$ENTRY Since: $SINCE_HASH"
  fi
fi

PYTHONPATH="$HERE${PYTHONPATH:+:$PYTHONPATH}" python3 - "$SECTION" "$ENTRY" <<'PY'
import sys
from hvlib import get_backend, BackendUnavailable
sec, entry = sys.argv[1], sys.argv[2]
try:
    backend = get_backend()
except BackendUnavailable as e:
    sys.stderr.write(f"error: hv-append: {e}\n"); sys.exit(2)
except ValueError as e:
    sys.stderr.write(f"error: hv-append: {e}\n"); sys.exit(1)
try:
    backend.append(sec, entry)
except LookupError as e:
    print(f"error: {e.args[0]}", file=sys.stderr); sys.exit(1)
PY

#!/usr/bin/env bash
# Detect BACKLOG.md drift from commit history. Walk `git log` per registered
# sub-repo (or current cwd in single-repo mode), extract [B##]/[F##]/[T##]
# tags from commit subjects, and flag IDs that appear in commits but are
# still listed as open in .hv/BACKLOG.md.
# Lookup helper: always exits 0; emits {"drift":[]} when no drift.
#
# Per-ID `Since:` anchor: when an open bullet carries `Since: <short-hash>`,
# only commits reachable from `<since>..HEAD` (per repo) can flag that ID
# as drift. Commits older than the anchor are skipped — prevents
# false-positives when IDs get reused across machine syncs. Items without
# `Since:` fall back to full-log behavior (backwards-compatible for legacy
# entries written before the anchor existed).
#
# Output: JSON to stdout — { "drift": [ { "id": "B07",
#   "commits": [ { "repo": "<name-or-empty>", "hash": "abc1234", "subject": "..." }, ... ] }, ... ],
#   "symbol_drift": [ { "id": "B07", "symbols": [...], "files": [...] }, ... ] }
# Empty arrays if no drift. Silent on missing BACKLOG.md (exit 0, empty drift).
#
# `symbol_drift` — a higher-precision, advisory signal for items that were
# silently shipped by a refactor commit that did NOT carry the `[ID]` tag (so
# commit-subject `drift` misses them). Only Since-anchored open items are
# considered: distinctive code symbols (backtick spans, CamelCase, snake_case,
# hv-* helpers, paths) are extracted from the item's TITLE + DESCRIPTION, then
# checked with `git grep` at HEAD vs the item's `Since:` commit. A symbol is
# evidence iff it is present at HEAD but absent at the capture commit — i.e. it
# entered the tree AFTER capture. Advisory only: it never auto-completes; the
# orchestrator should git-grep/log the symbols before implementing.
# Usage: hv-todo-drift
set -euo pipefail
. "$(dirname "${BASH_SOURCE[0]}")/hv-preamble.sh"
. "$HERE/hv-types.sh"
export HERE
PYTHONPATH="$HERE${PYTHONPATH:+:$PYTHONPATH}" python3 - <<'PY'
import json, os, re, subprocess, sys
from pathlib import Path
from hvlib import (
    iter_open_sections,
    load_repos,
    open_bullet_re,
    find_item_ids,
    parse_todo_fields,
)

todo_path = Path(".hv/BACKLOG.md")
if not todo_path.exists():
    print(json.dumps({"drift": []}))
    sys.exit(0)

content = todo_path.read_text()

cls = os.environ["HV_ITEM_TYPES"]

# Collect IDs that are still OPEN — bullets under ## Bugs / ## Features /
# ## Tasks that match `- **[ID] ...` (no leading `~~` strikethrough). Items
# under ## Completed are excluded by section selection. Also harvest each
# open bullet's `Since:` anchor (empty when not present).
open_ids: set[str] = set()
since_by_id: dict[str, str] = {}
bullet_text_by_id: dict[str, str] = {}
bullet = open_bullet_re()
for _name, body in iter_open_sections(content):
    for m in bullet.finditer(body):
        iid = m.group("id")
        open_ids.add(iid)
        bullet_text_by_id[iid] = m.group(0)
        fields = parse_todo_fields(m.group(0))
        since = fields.get("since", "").strip()
        if since:
            since_by_id[iid] = since

if not open_ids:
    print(json.dumps({"drift": []}))
    sys.exit(0)

# Determine repo set: registered sub-repos in umbrella mode, else cwd-only.
repos = load_repos()
if repos:
    targets = list(repos.items())  # [(name, abs-path), ...]
else:
    targets = [("", None)]  # single-repo mode — git -C None == default cwd


def reachable_set(since: str, cwd) -> set[str] | None:
    """Set of full-hash commits in `<since>..HEAD` for `cwd`.
    Returns None when `since` doesn't resolve to a commit in this repo —
    caller treats that as "anchor unknown here, skip all matches"."""
    cmd = ["git"]
    if cwd is not None:
        cmd += ["-C", cwd]
    verify = subprocess.run(
        cmd + ["cat-file", "-e", f"{since}^{{commit}}"],
        capture_output=True, text=True,
    )
    if verify.returncode != 0:
        return None
    r = subprocess.run(
        cmd + ["rev-list", f"{since}..HEAD"],
        capture_output=True, text=True,
    )
    if r.returncode != 0:
        return None
    return {h for h in r.stdout.split() if h}


# id -> list of commits in walk order (newest first from git log; we reverse later)
hits: dict[str, list[dict]] = {}

for name, path in targets:
    # Pre-compute the reachable set per unique Since anchor in this repo,
    # so each anchor's `rev-list` call runs at most once per repo.
    reach_cache: dict[str, set[str] | None] = {}
    for iid, anchor in since_by_id.items():
        if anchor not in reach_cache:
            reach_cache[anchor] = reachable_set(anchor, path)

    cmd = ["git"]
    if path is not None:
        cmd += ["-C", path]
    cmd += ["log", "--pretty=%H%x09%s"]
    r = subprocess.run(cmd, capture_output=True, text=True)
    if r.returncode != 0:
        continue
    for line in r.stdout.splitlines():
        if "\t" not in line:
            continue
        full_hash, subject = line.split("\t", 1)
        ids_in_subject = set(find_item_ids(subject, cls))
        for iid in ids_in_subject:
            if iid not in open_ids:
                continue
            anchor = since_by_id.get(iid)
            if anchor:
                reach = reach_cache.get(anchor)
                if reach is None or full_hash not in reach:
                    continue  # commit predates the anchor (or anchor unknown here)
            hits.setdefault(iid, []).append({
                "repo": name,
                "hash": full_hash[:7],
                "subject": subject,
            })

# Build sorted output: IDs ascending, commits chronological (oldest first).
drift = []
for iid in sorted(hits.keys()):
    drift.append({"id": iid, "commits": list(reversed(hits[iid]))})


# ---------------------------------------------------------------------------
# Symbol drift — advisory "shipped after capture" signal (Since-anchored only).
# ---------------------------------------------------------------------------

# Trailing-metadata marker: truncate the bullet here so symbol extraction sees
# only TITLE + DESCRIPTION, never field values (a `Detail:` path would match
# grep at HEAD and false-positive every Since-anchored item).
_META_MARKER = re.compile(
    r"\s+(?:Detail|Related|Milestone|Repos|Subsystem|Since|Captured|GH|GL):"
)
# Distinctive code-like token patterns (avoid plain English).
_CAMEL = re.compile(r"\b[A-Z][a-z0-9]+(?:[A-Z][a-z0-9]+)+\b")
_SNAKE = re.compile(r"\b[a-z][a-z0-9]*(?:_[a-z0-9]+)+\b")
_HVKEBAB = re.compile(r"\bhv-[a-z0-9-]+\b")
_PATH = re.compile(r"\b[\w.-]*/[\w./-]+\b")
_FILEEXT = re.compile(r"\b[\w-]+\.[a-z]{1,4}\b")
_BACKTICK = re.compile(r"`([^`]+)`")


def extract_symbols(bullet: str, iid: str) -> list[str]:
    """Distinctive code symbols from a bullet's title+desc (metadata stripped)."""
    # Strip leading `- **[ID] [tag] ` prefix and the surrounding `**`, then
    # truncate at the earliest trailing-metadata marker.
    text = bullet
    cut = _META_MARKER.search(text)
    if cut:
        text = text[: cut.start()]
    text = text.replace("**", " ")
    text = re.sub(r"^\s*-\s*", "", text)
    text = re.sub(r"\[[A-Za-z]\d+\]", " ", text)  # drop `[ID]` tags
    text = re.sub(r"\[[^\]]+\]", " ", text)        # drop `[tag]` brackets

    candidates: list[str] = []
    for inner in _BACKTICK.findall(bullet[: cut.start()] if cut else bullet):
        candidates.append(inner)
    for pat in (_CAMEL, _SNAKE, _HVKEBAB, _PATH, _FILEEXT):
        candidates.extend(pat.findall(text))

    seen: set[str] = set()
    out: list[str] = []
    for raw in candidates:
        sym = raw.strip().strip("`").strip(".,;:()[]{}\"'")
        if len(sym) <= 3:
            continue
        if sym == iid or sym.lstrip("[").rstrip("]") == iid:
            continue
        if sym in seen:
            continue
        seen.add(sym)
        out.append(sym)
        if len(out) >= 8:
            break
    return out


def grep_found(symbol: str, treeish: str, path):
    """git grep for a literal symbol at `treeish`. Return the list of matching
    file paths (treeish prefix stripped) — empty list when no match. Return
    None when the grep errored (e.g. treeish doesn't resolve) so the caller
    skips this (symbol, repo) rather than false-positive.

    `.hv/` is excluded from the pathspec so the backlog's own description text
    (which names the symbol) is never counted as the symbol being shipped."""
    cmd = ["git"]
    if path is not None:
        cmd += ["-C", path]
    cmd += ["grep", "-I", "-l", "-F", "-e", symbol, treeish,
            "--", ".", ":(exclude).hv/**"]
    r = subprocess.run(cmd, capture_output=True, text=True)
    if r.returncode == 1:
        return []
    if r.returncode != 0:
        return None
    files = []
    for raw in r.stdout.splitlines():
        raw = raw.strip()
        if not raw:
            continue
        # `git grep <treeish>` prefixes each path with `<treeish>:`.
        files.append(raw.split(":", 1)[1] if ":" in raw else raw)
    return files


symbol_hits: dict[str, dict] = {}  # iid -> {"symbols": set, "files": list}
for iid in sorted(since_by_id.keys()):
    if iid not in bullet_text_by_id:
        continue
    anchor = since_by_id[iid]
    symbols = extract_symbols(bullet_text_by_id[iid], iid)
    if not symbols:
        continue
    matched_symbols: list[str] = []
    matched_files: list[str] = []
    for sym in symbols:
        for name, path in targets:
            now = grep_found(sym, "HEAD", path)
            if not now:  # None (skip) or [] (not present at HEAD)
                continue
            then = grep_found(sym, anchor, path)
            if then is None:  # anchor doesn't resolve here — can't compare
                continue
            if then:  # present at capture too — not drift evidence
                continue
            if sym not in matched_symbols:
                matched_symbols.append(sym)
            for f in now:
                if f and f not in matched_files:
                    matched_files.append(f)
    if matched_symbols:
        symbol_hits[iid] = {
            "symbols": matched_symbols,
            "files": matched_files[:5],
        }

symbol_drift = []
for iid in sorted(symbol_hits.keys()):
    symbol_drift.append({
        "id": iid,
        "symbols": symbol_hits[iid]["symbols"],
        "files": symbol_hits[iid]["files"],
    })

print(json.dumps({"drift": drift, "symbol_drift": symbol_drift}, indent=2))
PY

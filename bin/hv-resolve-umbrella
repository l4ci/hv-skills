#!/usr/bin/env bash
# Walk up from cwd to find umbrella .hv/; detect masking by stray .hv/ inside a registered sub-repo.
# Resolve helper (thin wrapper via hv-walk-up): exits 1 when no umbrella .hv/ is found; exits 2 on masking.
# Usage: hv-resolve-umbrella
# Exit codes: 0 found, 1 not found, 2 masking detected
#
# Delegates to bin/hv-walk-up --detect-masking. Kept as a separate helper
# for backwards compatibility — callers refer to hv-resolve-umbrella by name
# across the codebase. The actual walk-up + masking algorithm lives in
# hv-walk-up; this helper is a thin wrapper that pins the --detect-masking
# behavior for umbrella-resolution use cases.
set -euo pipefail
HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
exec "$HERE/hv-walk-up" --detect-masking

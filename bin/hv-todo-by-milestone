#!/usr/bin/env bash
# Print IDs of TODO items tagged with a given milestone, one per line.
# Lookup helper: always exits 0; empty stdout when no items match.
# Scans `## Bugs`, `## Features`, `## Tasks` (skips `## Completed`).
# Items list multiple milestones via `Milestone: M01, M03`.
# Usage: hv-todo-by-milestone <MID>
set -euo pipefail
HERE="$(cd "$(dirname "$0")" && pwd)"
. "$HERE/hv-types.sh"
. "$HERE/hv-self-locate.sh"
hv_self_locate
MID="${1:?usage: hv-todo-by-milestone <MID>}"
PYTHONPATH="$HERE${PYTHONPATH:+:$PYTHONPATH}" python3 - "$MID" <<'PY'
import sys
from pathlib import Path
from hvlib import iter_open_sections, parse_todo_fields, open_bullet_re, parse_milestones

mid = sys.argv[1]
todo = Path(".hv/TODO.md")
if not todo.exists():
    raise SystemExit(0)
content = todo.read_text()

_open_re = open_bullet_re()
body = "".join(b for _name, b in iter_open_sections(content))
for line in body.splitlines():
    line = line.strip()
    idm = _open_re.match(line)
    if not idm:
        continue
    milestone_val = parse_todo_fields(line)["milestone"]
    if not milestone_val:
        continue
    milestones = parse_milestones(milestone_val)
    if mid in milestones:
        print(idm.group("id"))
PY

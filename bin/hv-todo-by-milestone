#!/usr/bin/env bash
# Print IDs of TODO items tagged with a given milestone, one per line.
# Scans `## Bugs`, `## Features`, `## Tasks` (skips `## Completed`).
# Items list multiple milestones via `Milestone: M01, M03`.
# Usage: hv-todo-by-milestone <MID>
set -euo pipefail
HERE="$(cd "$(dirname "$0")" && pwd)"
. "$HERE/hv-types.sh"
MID="${1:?usage: hv-todo-by-milestone <MID>}"
PYTHONPATH="$HERE${PYTHONPATH:+:$PYTHONPATH}" python3 - "$MID" <<'PY'
import os, re, sys
from pathlib import Path
from hvlib import section, parse_todo_fields

mid = sys.argv[1]
todo = Path(".hv/TODO.md")
if not todo.exists():
    raise SystemExit(0)
content = todo.read_text()

body = section(content, "Bugs") + section(content, "Features") + section(content, "Tasks")
for line in body.splitlines():
    line = line.strip()
    if not line.startswith("- **["):
        continue
    idm = re.match(rf"- \*\*\[([{os.environ['HV_ITEM_TYPES']}]\d+)\]", line)
    if not idm:
        continue
    milestone_val = parse_todo_fields(line)["milestone"]
    if not milestone_val:
        continue
    milestones = [m.strip() for m in re.findall(r"M\d+", milestone_val)]
    if mid in milestones:
        print(idm.group(1))
PY

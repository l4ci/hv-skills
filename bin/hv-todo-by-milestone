#!/usr/bin/env bash
# Print IDs of TODO items tagged with a given milestone, one per line.
# Lookup helper: always exits 0; empty stdout when no items match.
# Scans `## Bugs`, `## Features`, `## Tasks` (skips `## Completed`).
# Items list multiple milestones via `Milestone: M01, M03`.
# Usage: hv-todo-by-milestone <MID>
set -euo pipefail
. "$(dirname "${BASH_SOURCE[0]}")/hv-preamble.sh"
. "$HERE/hv-types.sh"
MID="${1:?usage: hv-todo-by-milestone <MID>}"
PYTHONPATH="$HERE${PYTHONPATH:+:$PYTHONPATH}" python3 - "$MID" <<'PY'
import sys
from pathlib import Path
from hvlib import iter_open_bullets, parse_milestones

mid = sys.argv[1]
todo = Path(".hv/BACKLOG.md")
if not todo.exists():
    raise SystemExit(0)
content = todo.read_text()

for iid, line, fields, _section in iter_open_bullets(content):
    milestone_val = fields["milestone"]
    if not milestone_val:
        continue
    milestones = parse_milestones(milestone_val)
    if mid in milestones:
        print(iid)
PY

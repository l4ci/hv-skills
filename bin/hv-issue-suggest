#!/usr/bin/env bash
# Suggest filing a hv-skills GitHub issue from a captured learning.
# Reads body from stdin; required --title; optional --upstream-repo override.
# When `gh` is available and authed, files the issue and prints
# {"url": "...", "number": N} on stdout (exit 0). Otherwise prints a
# manual-fallback URL + title + body to stdout (exit 1).
# Tool: exit 0 when gh files the issue; exit 1 on gh unavailable/unauthed.
#
# Usage:
#   printf '%s' "$BODY" | hv-issue-suggest --title "Title" [--upstream-repo owner/repo]
#
# Repo defaults to l4ci/hv-skills; override via $HV_UPSTREAM_REPO env var
# or --upstream-repo flag (flag wins).
set -euo pipefail
HERE="$(cd "$(dirname "$0")" && pwd)"
. "$HERE/hv-self-locate.sh"
hv_self_locate

REPO="${HV_UPSTREAM_REPO:-l4ci/hv-skills}"
TITLE=""
while [ $# -gt 0 ]; do
  case "$1" in
    --title)
      TITLE="${2:?--title requires a value}"
      shift 2
      ;;
    --upstream-repo)
      REPO="${2:?--upstream-repo requires a value}"
      shift 2
      ;;
    *)
      echo "error: unknown arg: $1" >&2
      echo "usage: hv-issue-suggest --title <T> [--upstream-repo owner/repo] < body" >&2
      exit 2
      ;;
  esac
done

if [ -z "$TITLE" ]; then
  echo "error: --title is required" >&2
  echo "usage: hv-issue-suggest --title <T> [--upstream-repo owner/repo] < body" >&2
  exit 2
fi

BODY="$(cat)"

if ! command -v gh >/dev/null 2>&1 || ! gh auth status >/dev/null 2>&1; then
  cat <<EOF
gh not available — file manually at:
  https://github.com/$REPO/issues/new

Title: $TITLE

Body:
$BODY
EOF
  exit 1
fi

URL=$(printf '%s' "$BODY" | gh issue create -R "$REPO" -t "$TITLE" -F -)
NUMBER="${URL##*/}"
printf '{"url": "%s", "number": %s}\n' "$URL" "$NUMBER"

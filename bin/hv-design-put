#!/usr/bin/env bash
# Replace the text of an existing design with a prepared body, so a skill can draft locally and publish.
# File mode: overwrites .hv/designs/<ID>.md (must exist: create it with hv-design-add first).
# Issue mode: upserts the item's `design` note on its issue (must exist likewise).
# Writer helper: exit 0 on success; exit 1 on usage error, unreadable body or missing target;
#   exit 2 backend unavailable; exit 3 tracker unavailable; exit 4 rate-limited.
# Usage: hv-design-put <ID> --body-file F|-
#   --body-file -   read the text from stdin (only then)
set -euo pipefail
. "$(dirname "${BASH_SOURCE[0]}")/hv-preamble.sh"
USAGE="usage: hv-design-put <ID> --body-file F|-"
REF="${1:?$USAGE}"
shift
BODY_FILE=""
while [ $# -gt 0 ]; do
  case "$1" in
    --body-file) BODY_FILE="${2:?$USAGE}"; shift 2 ;;
    *) echo "$USAGE" >&2; exit 1 ;;
  esac
done
[ -n "$BODY_FILE" ] || { echo "$USAGE" >&2; exit 1; }
# The preamble cd'd to the project root; a relative --body-file is relative to the caller.
if [ "$BODY_FILE" != "-" ] && [[ "$BODY_FILE" != /* ]]; then BODY_FILE="${HV_ORIG_PWD:-$PWD}/$BODY_FILE"; fi
# python reads its script from stdin (heredoc), so a piped body is staged in a temp file first.
if [ "$BODY_FILE" = "-" ]; then
  STAGED="$(mktemp)"; trap 'rm -f "$STAGED"' EXIT
  cat > "$STAGED"; BODY_FILE="$STAGED"
fi
PYTHONPATH="$HERE${PYTHONPATH:+:$PYTHONPATH}" python3 - "$REF" "$BODY_FILE" <<'PY'
import re, sys
from pathlib import Path
from hvlib import write_text_atomic, get_backend, IssueBackend, BackendUnavailable, TrackerError, tracker_exit_code

ref, body_file = sys.argv[1:3]

def die(msg, code=1):
    sys.stderr.write(f"error: hv-design-put: {msg}\n"); sys.exit(code)

if not re.fullmatch(r"[BFT]\d+", ref):
    die(f"ID must match [BFT]\\d+, got {ref!r}")
try:
    text = open(body_file, "rb").read().decode(errors="replace")
except OSError as e:
    die(f"cannot read --body-file: {e.strerror}: {body_file}")
try:
    backend = get_backend()
except ValueError:
    backend = None  # file mode never depended on config
try:
    if isinstance(backend, IssueBackend):
        if backend.note_get(ref, "design") is None:
            die(f"design note for {ref} not found (create it with hv-design-add)")
        backend.note_put(ref, "design", text)
    else:
        path = Path(f".hv/designs/{ref}.md")
        if not path.exists():
            die(f"{path} not found (create it with hv-design-add)")
        write_text_atomic(path, text)
except BackendUnavailable as e:
    die(str(e), 2)
except TrackerError as e:
    die(e.message, tracker_exit_code(e))
except LookupError as e:
    die(e.args[0])
PY

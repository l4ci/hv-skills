#!/usr/bin/env bash
# Register one status entry per (branch, repo) for a multi-repo /hv-work wave.
# Usage: hv-status-add-multi [--if-absent] --branch <name> --items <ids-csv> --repos <repos-csv> [--worktrees <paths-csv>]
#   --worktrees  Optional. Comma-separated paths paired by index with --repos.
#                If given, length MUST equal --repos length.
# Exits: 0 on success, 1 on usage/length mismatch, propagates errors from
#        hv-resolve-repos and hv-status-add.
set -euo pipefail
IF_ABSENT=""
BRANCH=""
ITEMS=""
REPOS=""
WORKTREES=""
while :; do
  case "${1:-}" in
    --if-absent) IF_ABSENT="--if-absent"; shift ;;
    --branch) BRANCH="${2:?}"; shift 2 ;;
    --items) ITEMS="${2:?}"; shift 2 ;;
    --repos) REPOS="${2:?}"; shift 2 ;;
    --worktrees) WORKTREES="${2:?}"; shift 2 ;;
    *) break ;;
  esac
done
[ -n "$BRANCH" ] && [ -n "$ITEMS" ] && [ -n "$REPOS" ] || {
  echo "usage: hv-status-add-multi [--if-absent] --branch <name> --items <ids-csv> --repos <repos-csv> [--worktrees <paths-csv>]" >&2
  exit 1
}
HERE="$(cd "$(dirname "$0")" && pwd)"
export HERE

# Validate names before doing anything else.
"$HERE/hv-resolve-repos" "$REPOS" >/dev/null || exit $?

PYTHONPATH="$HERE${PYTHONPATH:+:$PYTHONPATH}" python3 - "$IF_ABSENT" "$BRANCH" "$ITEMS" "$REPOS" "$WORKTREES" <<'PY'
import subprocess, sys, os
from hvlib import parse_repos_csv

if_absent, branch, items, repos_csv, worktrees_csv = sys.argv[1], sys.argv[2], sys.argv[3], sys.argv[4], sys.argv[5]
HERE = os.environ["HERE"]

repos = parse_repos_csv(repos_csv)
wt = [s.strip() for s in worktrees_csv.split(",")] if worktrees_csv else []
if wt and len(wt) != len(repos):
    sys.stderr.write(
        f"--worktrees length ({len(wt)}) must match --repos length ({len(repos)})\n"
    )
    sys.exit(1)

for i, name in enumerate(repos):
    argv = [f"{HERE}/hv-status-add"]
    if if_absent:
        argv.append(if_absent)
    argv.extend(["--repo", name, branch, items])
    if wt:
        w = wt[i]
        if w:
            argv.append(w)
    subprocess.run(argv, check=True)
PY

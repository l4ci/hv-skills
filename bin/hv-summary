#!/usr/bin/env bash
# Print a compact project-state summary: backlog counts, active work,
# recent completions, knowledge topics. Pure read — no git calls, no mutation.
# Lookup helper: always exits 0; pure read, no mutation.
# Usage: hv-summary
set -euo pipefail
. "$(dirname "$0")/hv-types.sh"
HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
. "$HERE/hv-self-locate.sh"
hv_self_locate
MS_JSON="$("$HERE/hv-vision-list")"
PYTHONPATH="$HERE${PYTHONPATH:+:$PYTHONPATH}" python3 - "$MS_JSON" <<'PY'
import json, os, re, sys
from pathlib import Path
from hvlib import section, iter_open_sections, load_json, parse_done_line, iter_topics, active_items

todo = Path(".hv/BACKLOG.md")
if not todo.exists():
    print("No .hv/ yet — run /hv-init.")
    raise SystemExit(0)
content = todo.read_text()

def count(body):
    return sum(1 for line in body.splitlines() if line.strip().startswith("- **["))

def pluralize(n, singular, plural=None):
    return f"{n} {singular if n == 1 else (plural or singular + 's')}"

_counts = {name: count(body) for name, body in iter_open_sections(content)}
bugs = _counts.get("Bugs", 0)
features = _counts.get("Features", 0)
tasks = _counts.get("Tasks", 0)
print(f"Backlog: {pluralize(bugs, 'bug')}, {pluralize(features, 'feature')}, {pluralize(tasks, 'task')}")

# Active work
data = load_json(".hv/status.json", {"active": []})
for entry in data.get("active", []):
        ids = ", ".join(active_items(entry)) or "?"
        branch = entry.get("branch", "?")
        started = (entry.get("startedAt") or "")[:10]
        wt = entry.get("worktree")
        loc = f" in {wt}" if wt else ""
        repo = entry.get("repo")
        repo_str = f" (repo: {repo})" if repo else ""
        print(f"Active: {ids} on {branch}{loc}{repo_str} (since {started})")

# Recent completions (top 3 from ## Completed)
completed = section(content, "Completed")
pairs = []
for line in completed.splitlines():
    parsed = parse_done_line(line.strip())
    if parsed:
        pairs.append((f"[{parsed['id']}]", parsed["date"]))
if pairs:
    recent = pairs[:3]
    print("Recent: " + ", ".join(f"{iid} on {d}" for iid, d in recent))

# Active milestones
ms = json.loads(sys.argv[1])
actives = [(m["id"], m["title"]) for m in ms if m["status"] == "active"]
if actives:
    print("Active milestones: " + ", ".join(f"{i} {t}".strip() for i, t in actives))

# Knowledge topics
k = Path(".hv/KNOWLEDGE.md")
if k.exists():
    topics = [name for name, _body in iter_topics(k.read_text())]
    if topics:
        shown = topics[:4]
        suffix = ", ..." if len(topics) > 4 else ""
        print(f"Knowledge: {len(topics)} topics ({', '.join(shown)}{suffix})")

# Decisions topics
d = Path(".hv/DECISIONS.md")
if d.exists():
    topics = [name for name, _body in iter_topics(d.read_text())]
    if topics:
        shown = topics[:4]
        suffix = ", ..." if len(topics) > 4 else ""
        print(f"Decisions: {len(topics)} topics ({', '.join(shown)}{suffix})")

# Archive size
a = Path(".hv/ARCHIVE.md")
if a.exists():
    n = sum(1 for line in a.read_text().splitlines() if re.match(r"- ~~", line))
    if n:
        print(f"Archive: {n} older item{'s' if n != 1 else ''}")
PY

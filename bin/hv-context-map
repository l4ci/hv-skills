#!/usr/bin/env bash
# Regenerate .hv/CONTEXT-MAP.md from umbrella .hv/CONTEXT.md and per-sub-repo
# .hv/contexts/<repo>/CONTEXT.md files. No-op when not in umbrella mode.
# Atomic-merge helper: regenerates .hv/CONTEXT-MAP.md; exit 0 always (no-op outside umbrella mode).
# Usage: hv-context-map
set -euo pipefail
HERE="$(cd "$(dirname "$0")" && pwd)"
. "$HERE/hv-self-locate.sh"
hv_self_locate

UMBRELLA_ON=$("$HERE/hv-umbrella-on")
[ "$UMBRELLA_ON" = "yes" ] || exit 0

PYTHONPATH="$HERE${PYTHONPATH:+:$PYTHONPATH}" python3 - <<'PY'
from pathlib import Path
from hvlib import iter_topics, write_text_atomic

def list_terms(path: Path) -> list[str]:
    if not path.exists():
        return []
    return sorted(name for name, _ in iter_topics(path.read_text()))

lines = ["# Context Map", "", "_Generated by `hv-context-map`. Manual edits are overwritten._", ""]

shared = list_terms(Path(".hv/CONTEXT.md"))
lines.append("## Umbrella-shared (.hv/CONTEXT.md)")
lines.append("")
if shared:
    for t in shared:
        lines.append(f"- {t}")
else:
    lines.append("- _(no umbrella-shared terms)_")
lines.append("")

ctx = Path(".hv/contexts")
if ctx.is_dir():
    for repo_dir in sorted(p for p in ctx.iterdir() if p.is_dir()):
        name = repo_dir.name
        rel = f".hv/contexts/{name}/CONTEXT.md"
        terms = list_terms(repo_dir / "CONTEXT.md")
        lines.append(f"## {name} ({rel})")
        lines.append("")
        if terms:
            for t in terms:
                lines.append(f"- {t}")
        else:
            lines.append("- _(no terms)_")
        lines.append("")

write_text_atomic(Path(".hv/CONTEXT-MAP.md"), "\n".join(lines).rstrip() + "\n")
PY

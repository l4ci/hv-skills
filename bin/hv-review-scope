#!/usr/bin/env bash
# Scope a review: list commits, touched files, referenced IDs, and the
# original TODO entries those IDs point at. Emits JSON so /hv-review can
# build its agent brief in one step.
# Tool: exit 0 with JSON scope; exit 1 on git error or missing branch.
# Usage: hv-review-scope [--repo <name>] [branch]   # defaults to current branch in cwd, or in <name>'s sub-repo
set -euo pipefail
. "$(dirname "$0")/hv-types.sh"
HERE="$(cd "$(dirname "$0")" && pwd)"
# Route umbrella discovery through hv-resolve-umbrella (→ hv-walk-up) so a
# single canonical entry point owns "find the umbrella" — falls back to
# physical pwd when the resolver can't locate a `.hv/`.
UMBRELLA_CWD="$("$HERE/hv-resolve-umbrella" 2>/dev/null || pwd -P)"

REPO=""
if [ "${1:-}" = "--repo" ]; then
  REPO="${2:?usage: hv-review-scope [--repo <name>] [branch]}"
  shift 2
fi

if [ -n "$REPO" ]; then
  REPO_PATH=$("$HERE/hv-resolve-repo-path" "$REPO")
  cd "$REPO_PATH"
fi

BRANCH="${1:-$(git rev-parse --abbrev-ref HEAD)}"

# Umbrella-cwd guard delegates to the centralized helper. Runs AFTER the
# optional cd into a sub-repo, so a successful --repo resolution will have
# put us into a real .git/ tree and the guard fast-paths.
"$HERE/hv-require-git-context" "hv-review-scope" --repo-flag-supported

BASE=$("$HERE/hv-base-branch")

if [ "$BRANCH" = "$BASE" ]; then
  echo "error: cannot review base branch '$BASE' against itself" >&2
  exit 1
fi
git rev-parse --verify "$BRANCH" >/dev/null 2>&1 || {
  echo "error: branch '$BRANCH' not found" >&2
  exit 1
}

export HV_BRANCH="$BRANCH" HV_BASE="$BASE"
HV_LOG=$(git log --no-merges --format='%h%x1f%s' "$BASE..$BRANCH")
HV_FILES=$(git diff --name-only "$BASE...$BRANCH")
HV_BODIES=$(git log --no-merges --format='%B' "$BASE..$BRANCH")
export HV_LOG HV_FILES HV_BODIES

export PYTHONPATH="$HERE"
export UMBRELLA_CWD
python3 - <<'PY'
import json, os
from hvlib import find_origin_bullet, load_backlog_corpus, find_item_ids

branch = os.environ["HV_BRANCH"]
base = os.environ["HV_BASE"]
log = [l for l in os.environ["HV_LOG"].splitlines() if l.strip()]
files = sorted({l for l in os.environ["HV_FILES"].splitlines() if l.strip()})
full = os.environ["HV_BODIES"]

commits = []
for line in log:
    if "\x1f" in line:
        h, s = line.split("\x1f", 1)
        commits.append({"hash": h, "subject": s})

ordered = find_item_ids(full, os.environ["HV_ITEM_TYPES"])

umbrella = os.environ.get("UMBRELLA_CWD", ".")
corpus = load_backlog_corpus(umbrella)

def entry_for(iid):
    result = find_origin_bullet(corpus, iid)
    if result is None:
        return None
    line, title = result
    return {"id": iid, "title": title, "entry": line}

intents = [e for e in (entry_for(iid) for iid in ordered) if e]

out = {
    "branch": branch,
    "base": base,
    "commitCount": len(commits),
    "commits": commits,
    "touchedFiles": files,
    "referencedIds": ordered,
    "intents": intents,
}
print(json.dumps(out, indent=2))
PY

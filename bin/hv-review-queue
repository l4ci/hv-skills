#!/usr/bin/env bash
# List the review queue (issue mode): open items labelled needs-review, each with the open PRs / MRs
# whose body closes it (a closing keyword like `Closes #N`, as hv-pr --closes writes). One tracker
# list call per kind, matched in memory. An item with no matching PR is listed with "prs": [].
# Prints a JSON array, lowest issue first:
#   [{"id": "F12", "number": 12, "title": "...", "prs": [{"number", "title", "branch", "url", "body"}]}]
# File backend: prints [] and a note on stderr (use hv-merge there).
# Reader helper: exit 0 on success (including the file-backend note); exit 1 on usage error or tracker
#   failure; exit 3 tracker unavailable; exit 4 rate-limited.
# Usage: hv-review-queue
set -euo pipefail
. "$(dirname "${BASH_SOURCE[0]}")/hv-preamble.sh"
[ $# -eq 0 ] || { echo "usage: hv-review-queue" >&2; exit 1; }
PYTHONPATH="$HERE${PYTHONPATH:+:$PYTHONPATH}" python3 - <<'PY'
import json, sys
from hvlib import get_backend, IssueBackend, TrackerError, tracker_exit_code

def die(msg, code=1):
    sys.stderr.write(f"error: hv-review-queue: {msg}\n"); sys.exit(code)

try:
    backend = get_backend()
    if not isinstance(backend, IssueBackend):
        sys.stderr.write("hv-review-queue: file backend has no review queue\n")
        print("[]")
        sys.exit(0)
    print(json.dumps(backend.review_queue(), indent=1))
except TrackerError as e:
    die(e.message, tracker_exit_code(e))
except ValueError as e:
    die(e.args[0])
PY

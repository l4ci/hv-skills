#!/usr/bin/env bash
# Print the contents of a design file.
# Resolve helper: exits 1 when design ID not found; exits 0 with content on match.
# Usage: hv-design-show <ID>     (e.g. hv-design-show F58)
set -euo pipefail
. "$(dirname "${BASH_SOURCE[0]}")/hv-preamble.sh"
. "$HERE/hv-artifact-show.sh"
ID="${1:?usage: hv-design-show <ID>}"
hv_artifact_show design "$ID" .hv/designs

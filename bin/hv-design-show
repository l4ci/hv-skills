#!/usr/bin/env bash
# Print the contents of a design file.
# Resolve helper: exits 1 when design ID not found; exits 0 with content on match.
# Usage: hv-design-show <ID>     (e.g. hv-design-show F58)
set -euo pipefail
. "$(dirname "${BASH_SOURCE[0]}")/hv-preamble.sh"
. "$HERE/hv-artifact-show.sh"
ID="${1:?usage: hv-design-show <ID>}"
# Issue mode: the design is a note on the item's issue.
if PYTHONPATH="$HERE${PYTHONPATH:+:$PYTHONPATH}" python3 -m hvlib_backend is-issues; then
PYTHONPATH="$HERE${PYTHONPATH:+:$PYTHONPATH}" python3 - "$ID" <<'PY'
import sys
from hvlib import get_backend, BackendUnavailable, TrackerError, tracker_exit_code

ref = sys.argv[1]
try:
    backend = get_backend()
    out = backend.note_get(ref, "design")
    if out is None:
        print("error: design note for %s not found" % ref, file=sys.stderr); sys.exit(1)
    print(out)
except BackendUnavailable as e:
    print(f"error: hv-design-show: {e}", file=sys.stderr); sys.exit(2)
except TrackerError as e:
    print(f"error: hv-design-show: {e.message}", file=sys.stderr); sys.exit(tracker_exit_code(e))
except LookupError as e:
    print(f"error: hv-design-show: {e.args[0]}", file=sys.stderr); sys.exit(1)
PY
  exit $?
fi
hv_artifact_show design "$ID" .hv/designs

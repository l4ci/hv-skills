#!/usr/bin/env bash
# Print the contents of a plan file.
# Resolve helper: exits 1 when plan key not found; exits 0 with content on match.
# Usage: hv-plan-show <key>     (e.g. hv-plan-show M01-S01)
set -euo pipefail
. "$(dirname "${BASH_SOURCE[0]}")/hv-preamble.sh"
KEY="${1:?usage: hv-plan-show <key>}"
PLAN=".hv/plans/${KEY}.md"
if [ ! -f "$PLAN" ]; then
  echo "error: $PLAN not found" >&2
  exit 1
fi
cat "$PLAN"

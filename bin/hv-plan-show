#!/usr/bin/env bash
# Print the contents of a plan file.
# Resolve helper: exits 1 when plan key not found; exits 0 with content on match.
# Usage: hv-plan-show <key>     (e.g. hv-plan-show M01-S01)
set -euo pipefail
. "$(dirname "${BASH_SOURCE[0]}")/hv-preamble.sh"
. "$HERE/hv-artifact-show.sh"
KEY="${1:?usage: hv-plan-show <key>}"
# Issue mode: an item plan (<M>-<ID>) is a note on the item's issue (the milestone part is ignored);
# a slice plan (<M>-S<NN>) is a plan:S<NN> note on the milestone's tracking issue.
if PYTHONPATH="$HERE${PYTHONPATH:+:$PYTHONPATH}" python3 -m hvlib_backend is-issues; then
  RC=0
PYTHONPATH="$HERE${PYTHONPATH:+:$PYTHONPATH}" python3 - "$KEY" <<'PY' || RC=$?
import sys
from hvlib import get_backend, BackendUnavailable, TrackerError, tracker_exit_code

ref = sys.argv[1]
import re
m = re.fullmatch(r"M\d{2,}-([A-Z]\d+)", ref)
if not m:
    sys.exit(64)  # odd key: file behaviour
item = m.group(1)
try:
    backend = get_backend()
    # A slice plan (<M>-S<NN>) is a plan:S<NN> note on the milestone's tracking issue.
    out = backend.slice_get(ref.split("-")[0], item) if item.startswith("S") else backend.note_get(item, "plan")
    if out is None:
        print("error: plan note for %s not found" % ref, file=sys.stderr); sys.exit(1)
    print(out)
except BackendUnavailable as e:
    print(f"error: hv-plan-show: {e}", file=sys.stderr); sys.exit(2)
except TrackerError as e:
    print(f"error: hv-plan-show: {e.message}", file=sys.stderr); sys.exit(tracker_exit_code(e))
except LookupError as e:
    print(f"error: hv-plan-show: {e.args[0]}", file=sys.stderr); sys.exit(1)
PY
  [ "$RC" -eq 64 ] || exit "$RC"
fi
hv_artifact_show plan "$KEY" .hv/plans

#!/usr/bin/env bash
# List all plans from .hv/plans/*.md as JSON.
# Lookup helper: always exits 0; empty JSON array when no plans.
# Each entry: { key, milestone, unit, unitKind, title, status, created, repo }.
# Usage: hv-plan-list [milestone]
#   With a milestone arg, returns only plans under that milestone.
set -euo pipefail
HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
. "$HERE/hv-self-locate.sh"
hv_self_locate
FILTER="${1:-}"
RAW=$("$HERE/hv-fm-list" .hv/plans key milestone unit unitKind title status created repo)
python3 - "$RAW" "$FILTER" <<'PY'
import json, sys
from pathlib import Path
filter_milestone = sys.argv[2] if len(sys.argv) > 2 else ""
items = []
for fm in json.loads(sys.argv[1]):
    ms = fm.get("milestone", "")
    if filter_milestone and ms != filter_milestone:
        continue
    items.append({
        "key":       fm.get("key") or Path(fm["_path"]).stem,
        "milestone": ms,
        "unit":      fm.get("unit", ""),
        "unitKind":  fm.get("unitKind") or "item",
        "title":     fm.get("title", ""),
        "status":    fm.get("status") or "planned",
        "created":   fm.get("created", ""),
        "repo":      fm.get("repo", ""),
    })
print(json.dumps(items, indent=2))
PY

#!/usr/bin/env bash
# List all plans from .hv/plans/*.md as JSON.
# Lookup helper: always exits 0; empty JSON array when no plans.
# Each entry: { key, milestone, unit, unitKind, title, status, created, repo }.
# Usage: hv-plan-list [milestone]
#   With a milestone arg, returns only plans under that milestone.
set -euo pipefail
. "$(dirname "${BASH_SOURCE[0]}")/hv-preamble.sh"
FILTER="${1:-}"
# Issue mode: item plans live as notes on their issues (not listed); slice plans are the plan:S<NN> notes
# on the milestones' tracking issues (one comments call per milestone listed).
if PYTHONPATH="$HERE${PYTHONPATH:+:$PYTHONPATH}" python3 -m hvlib_backend is-issues; then
  echo "hv-plan-list: item plans live on their issues (backlog.backend \"issues\"); listing slice plans from the milestone tracking issues only" >&2
  exec env PYTHONPATH="$HERE${PYTHONPATH:+:$PYTHONPATH}" python3 - "$FILTER" <<'PY'
import json, sys
from hvlib import get_backend, parse_frontmatter, BackendUnavailable, TrackerError, tracker_exit_code

try:
    plans = get_backend().slice_plans(sys.argv[1] or None)
except BackendUnavailable as e:
    sys.stderr.write(f"error: hv-plan-list: {e}\n"); sys.exit(2)
except TrackerError as e:
    sys.stderr.write(f"error: hv-plan-list: {e.message}\n"); sys.exit(tracker_exit_code(e))
items = []
for mid, unit, text in plans:
    fm, _body = parse_frontmatter(text)
    items.append({
        "key":       fm.get("key") or f"{mid}-{unit}",
        "milestone": fm.get("milestone") or mid,
        "unit":      fm.get("unit") or unit,
        "unitKind":  fm.get("unitKind") or "slice",
        "title":     fm.get("title", ""),
        "status":    fm.get("status") or "planned",
        "created":   fm.get("created", ""),
        "repo":      fm.get("repo", ""),
    })
print(json.dumps(items, indent=2))
PY
fi
RAW=$("$HERE/hv-fm-list" .hv/plans key milestone unit unitKind title status created repo)
python3 - "$RAW" "$FILTER" <<'PY'
import json, sys
from pathlib import Path
filter_milestone = sys.argv[2] if len(sys.argv) > 2 else ""
items = []
for fm in json.loads(sys.argv[1]):
    ms = fm.get("milestone", "")
    if filter_milestone and ms != filter_milestone:
        continue
    items.append({
        "key":       fm.get("key") or Path(fm["_path"]).stem,
        "milestone": ms,
        "unit":      fm.get("unit", ""),
        "unitKind":  fm.get("unitKind") or "item",
        "title":     fm.get("title", ""),
        "status":    fm.get("status") or "planned",
        "created":   fm.get("created", ""),
        "repo":      fm.get("repo", ""),
    })
print(json.dumps(items, indent=2))
PY

#!/usr/bin/env bash
# Increment counter and return zero-padded ID.
# Writer helper: exit 0 on successful counter increment; exit 1 on unknown type.
# Usage: hv-next-id <bugs|features|tasks|milestones>
set -euo pipefail
. "$(dirname "${BASH_SOURCE[0]}")/hv-preamble.sh"
PYTHONPATH="$HERE${PYTHONPATH:+:$PYTHONPATH}" python3 -m hvlib_backend require-file hv-next-id 'IDs are issue numbers; capture creates the issue' || exit $?
TYPE="${1:?usage: hv-next-id <bugs|features|tasks|milestones>}"
case "$TYPE" in
  bugs|features|tasks|milestones) ;;
  *) echo "error: unknown type '$TYPE'" >&2; exit 1 ;;
esac
PYTHONPATH="$HERE${PYTHONPATH:+:$PYTHONPATH}" python3 - "$TYPE" <<'PY'
import sys
from hvlib import get_backend

print(get_backend().next_id(sys.argv[1]))
PY

#!/usr/bin/env bash
# Append a context comment to an item: a question, answer, decision or feedback note.
# Issue backend: a new issue comment whose first line is `<!-- hv:comment <kind> -->`; prints its id.
# File backend: one `- <date> · <kind> · <first line>` row (continuation lines indented) under
#   `## Log` in the item's detail file, which is created when missing; prints nothing.
# Always appends; there is no dedup. Writer helper: exit 0 on success; exit 1 on usage error,
#   unreadable body, unknown item or tracker failure; exit 3 tracker unavailable; exit 4 rate-limited.
# Usage: hv-item-comment <ref> --kind question|answer|decision|feedback --body-file F|-
#   --body-file -   read the text from stdin (only then)
set -euo pipefail
. "$(dirname "${BASH_SOURCE[0]}")/hv-preamble.sh"
USAGE="usage: hv-item-comment <ref> --kind question|answer|decision|feedback --body-file F|-"
REF="${1:?$USAGE}"
shift
KIND="" BODY_FILE=""
while [ $# -gt 0 ]; do
  case "$1" in
    --kind) KIND="${2:?$USAGE}"; shift 2 ;;
    --body-file) BODY_FILE="${2:?$USAGE}"; shift 2 ;;
    *) echo "$USAGE" >&2; exit 1 ;;
  esac
done
case "$KIND" in question|answer|decision|feedback) ;; *) echo "$USAGE" >&2; exit 1 ;; esac
[ -n "$BODY_FILE" ] || { echo "$USAGE" >&2; exit 1; }
if [ "$BODY_FILE" != "-" ] && [[ "$BODY_FILE" != /* ]]; then BODY_FILE="${HV_ORIG_PWD:-$PWD}/$BODY_FILE"; fi
# python reads its script from stdin (heredoc), so a piped body is staged in a temp file first.
if [ "$BODY_FILE" = "-" ]; then
  STAGED="$(mktemp)"; trap 'rm -f "$STAGED"' EXIT
  cat > "$STAGED"; BODY_FILE="$STAGED"
fi
PYTHONPATH="$HERE${PYTHONPATH:+:$PYTHONPATH}" python3 - "$REF" "$KIND" "$BODY_FILE" <<'PY'
import sys
from hvlib import get_backend, BackendUnavailable, TrackerError, tracker_exit_code

ref, kind, body_file = sys.argv[1:4]

def die(msg, code=1):
    sys.stderr.write(f"error: hv-item-comment: {msg}\n"); sys.exit(code)

try:
    text = open(body_file, "rb").read().decode(errors="replace")
except OSError as e:
    die(f"cannot read --body-file: {e.strerror}: {body_file}")
if not text.strip():
    die("empty comment body")
try:
    cid = get_backend().comment_add(ref, kind, text)
    if cid is not None:
        print(cid)
except BackendUnavailable as e:
    die(str(e), 2)
except TrackerError as e:
    die(e.message, tracker_exit_code(e))
except (LookupError, ValueError) as e:
    die(e.args[0])
PY

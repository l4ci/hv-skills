#!/usr/bin/env bash
# Zero counters.json#since_refactor — called by /hv-refactor after a successful
# refactor: commit lands. Idempotent.
# Writer helper: exit 0 always; zeroes counters.json#since_refactor (idempotent).
# Usage: hv-refactor-reset
set -euo pipefail
HERE="$(cd "$(dirname "$0")" && pwd)"
. "$HERE/hv-self-locate.sh"
hv_self_locate
PYTHONPATH="$HERE${PYTHONPATH:+:$PYTHONPATH}" python3 - <<'PY'
from hvlib import update_json
def reset(d):
    d["since_refactor"] = {"features": 0, "bugs": 0}
update_json(".hv/counters.json", {}, reset)
PY

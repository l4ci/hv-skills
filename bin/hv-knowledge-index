#!/usr/bin/env bash
# Regenerate the managed <!-- hv-knowledge-start --> block in CLAUDE.md from .hv/KNOWLEDGE.md topics.
# Atomic-merge helper: regenerates managed hv-knowledge block in CLAUDE.md; exit 0 on success.
# Usage: hv-knowledge-index
# Migrates legacy <!-- hv:knowledge:start --> markers via hv-managed-block.
set -euo pipefail
HERE="$(cd "$(dirname "$0")" && pwd)"
. "$HERE/hv-self-locate.sh"
hv_self_locate
exec "$HERE/hv-managed-block" knowledge
